---
/**
 * "Screens you use every day": five crops of the real apps, rebuilt in HTML.
 *
 *   pl      — Dash › Asosiy: profit-and-loss cards + "Pul qayerga ketadi" split
 *   reports — Dash › Hisobotlar: Soatlik daromad chart + Eng yaxshi mahsulotlar bars
 *   stop    — RestaurantPOS › Mavjudlik (stop list), one item stopped
 *   floor   — RestaurantPOS › Zal: occupied tables (total, minutes seated, waiter called)
 *   inbox   — RestaurantPOS › Xabarlar: online order awaiting acceptance + refund request
 *
 * Layout, states and colours are copied from the live apps (bonet tenant, read-only)
 * and their source (kdsx-dash-v2, kdsx-pos-v2: floor-plan, stop-list, inbox routes).
 * Wording comes from each app's public/locales. Demo figures add up: the split is
 * 35 + 12 + 8 + 45 % of 4 820 000. Dish names are demo catalogue data (not translated).
 * Each crop follows the site theme, like the apps do.
 */
const hours = [
  // gross sales by hour, 08:00–23:00 (so'm, thousands)
  0, 40, 95, 180, 410, 642, 390, 210, 160, 240, 455, 560, 470, 260, 90, 20,
];
const W = 520;
const H = 150;
const max = 700;
const pts = hours.map((v, i) => [(i / (hours.length - 1)) * W, H - (v / max) * H] as const);
// Smooth path (Catmull-Rom → Bézier), like the app's area chart.
let line = `M${pts[0][0]},${pts[0][1]}`;
for (let i = 0; i < pts.length - 1; i++) {
  const p0 = pts[i - 1] ?? pts[i];
  const p1 = pts[i];
  const p2 = pts[i + 1];
  const p3 = pts[i + 2] ?? p2;
  const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
  const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
  line += ` C${c1[0].toFixed(1)},${c1[1].toFixed(1)} ${c2[0].toFixed(1)},${c2[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`;
}
const area = `${line} L${W},${H} L0,${H} Z`;
const peak = pts[5];

const topItems = [
  { n: "Osh - 0.5", v: "1 240 000", w: 100 },
  { n: "Lag'mon", v: "860 000", w: 69 },
  { n: "Somsa", v: "610 000", w: 49 },
];

const stopRows = [
  { n: "Limonad Ocean", src: "/mock/pos/drink1.webp", stopped: false },
  { n: "Limonad Klubnika", src: "/mock/pos/drink2.webp", stopped: true },
  { n: "Limonad Malina", src: "/mock/pos/drink3.webp", stopped: false },
];

const tables = [
  { l: "1", busy: true, total: "142 000", min: 35 },
  { l: "2", busy: false },
  { l: "3", busy: true, total: "86 500", min: 12, bell: true },
  { l: "4", busy: false },
  { l: "5", busy: true, total: "214 000", min: 58 },
  { l: "6", busy: false },
];

const I = {
  back: '<path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>',
  search: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
  bell: '<path d="M10.268 21a2 2 0 0 0 3.464 0"/><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"/>',
  shield: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="M12 8v4"/><path d="M12 16h.01"/>',
  bag: '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>',
  up: '<path d="m5 12 7-7 7 7"/><path d="M12 19V5"/>',
  checks: '<path d="M18 6 7 17l-5-5"/><path d="m22 10-7.5 7.5L13 16"/>',
};
---

<section class="section" id="features">
  <div class="wrap">
    <h2 class="display display-2 max-w-[820px]" data-i18n="ft.heading">Har kuni ko‘radigan ekranlaringiz</h2>

    <ul class="ft-grid mt-10 lg:mt-14">
      {/* ---------- 1. profit and loss ---------- */}
      <li class="card ft-tile lg:col-span-3">
        <div class="ft-cap">
          <h3 data-i18n="ft.plT">Foyda va zarar</h3>
          <p data-i18n="ft.plD">Har bir savdo xarajatlar va sizga qoladigan qism o‘rtasida qanday taqsimlanishini Dash bosh sahifasida ko‘ring.</p>
        </div>
        <div class="ft-crop app" aria-hidden="true">
          <p class="m2 text-[11px]" data-i18n="ft.period">Davr</p>
          <div class="mt-1 flex gap-1.5">
            <span class="chip on" data-i18n="ft.today">Bugun</span>
            <span class="chip" data-i18n="ft.yesterday">Kecha</span>
            <span class="chip" data-i18n="ft.week">Shu hafta</span>
          </div>
          <div class="mt-3 grid grid-cols-2 gap-2">
            <div class="box">
              <p class="flex items-center justify-between text-[11.5px]"><span data-i18n="ft.netSales">Sof savdo</span><span class="delta"><svg viewBox="0 0 24 24" set:html={I.up} />12.4%</span></p>
              <p class="kpi"><span>4 820 000</span></p>
            </div>
            <div class="box">
              <p class="text-[11.5px]" data-i18n="ft.grossProfit">Yalpi foyda (taxminiy)</p>
              <p class="kpi"><span>3 133 000</span> <span class="m2 text-[12px] font-normal">65%</span></p>
            </div>
          </div>
          <div class="box mt-2">
            <p class="text-[12px] font-medium" data-i18n="ft.where">Pul qayerga ketadi</p>
            <p class="m2 mt-0.5 text-[10.5px]" data-i18n="ft.whereHint">Har bir savdo xarajatlar va sizga qoladigan qism o'rtasida qanday taqsimlanadi.</p>
            <div class="split mt-2.5">
              <span style="width:35%;background:var(--yellow)"></span><span style="width:12%;background:var(--cyan)"></span><span style="width:8%;background:var(--grey)"></span><span style="width:45%;background:var(--accent)"></span>
            </div>
            <dl class="legend mt-2.5">
              <div><dt><i style="background:var(--yellow)"></i><span data-i18n="ft.cogs">Sotilgan tovarlar tannarxi</span></dt><dd><small>35%</small> 1 687 000</dd></div>
              <div><dt><i style="background:var(--cyan)"></i><span data-i18n="ft.labour">Mehnat haqi</span></dt><dd><small>12%</small> 578 400</dd></div>
              <div><dt><i style="background:var(--grey)"></i><span data-i18n="ft.opex">Operatsion xarajatlar</span></dt><dd><small>8%</small> 385 600</dd></div>
              <div><dt><i style="background:var(--accent)"></i><span data-i18n="ft.opProfit">Operatsion foyda</span></dt><dd><small>45%</small> 2 169 000</dd></div>
            </dl>
          </div>
        </div>
      </li>

      {/* ---------- 2. hourly revenue + top items ---------- */}
      <li class="card ft-tile lg:col-span-3">
        <div class="ft-cap">
          <h3 data-i18n="ft.repT">Soatlik daromad va eng yaxshi mahsulotlar</h3>
          <p data-i18n="ft.repD">Eng band va sokin soatlar, daromadni qaysi taomlar keltirayotgani.</p>
        </div>
        <div class="ft-crop app" aria-hidden="true">
          <div class="box">
            <p class="text-[12px] font-medium" data-i18n="ft.hourly">Soatlik daromad</p>
            <p class="m2 mt-0.5 text-[10.5px]" data-i18n="ft.hourlyHint">Yalpi savdo soatlar bo‘yicha — eng band va sokin paytlarni toping.</p>
            {/* The curve stretches to the box; labels and the peak dot are HTML so they never stretch with it. */}
            <div class="chart-wrap mt-5">
              <svg class="chart" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
                <path d={area} fill="var(--accent)" fill-opacity="0.16" />
                <path d={line} fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" vector-effect="non-scaling-stroke" />
              </svg>
              <i class="peak-dot" style={`left:${(peak[0] / W) * 100}%;top:${(peak[1] / H) * 100}%`}></i>
              <b class="peak-label" style={`left:${(peak[0] / W) * 100}%;top:${(peak[1] / H) * 100}%`}>642 000</b>
              <div class="axis">
                {["08:00", "12:00", "16:00", "20:00"].map((t, i) => (
                  <span style={`left:${(i * 4 / 15) * 100}%`} class:list={[i === 0 && "first"]}>{t}</span>
                ))}
              </div>
            </div>
          </div>
          <div class="box mt-2">
            <p class="text-[12px] font-medium" data-i18n="ft.topItems">Eng yaxshi mahsulotlar</p>
            <ul class="bars mt-2">
              {topItems.map((t) => (
                <li><span class="bn">{t.n}</span><span class="bt"><i style={`width:${t.w}%`}></i><b>{t.v}</b></span></li>
              ))}
            </ul>
          </div>
        </div>
      </li>

      {/* ---------- 3. stop list ---------- */}
      <li class="card ft-tile lg:col-span-2">
        <div class="ft-cap">
          <h3 data-i18n="ft.stopT">Mavjudlik</h3>
          <p data-i18n="ft.stopD">Tugagan taomni bir tegishda sotuvdan to‘xtating.</p>
        </div>
        <div class="ft-crop app" aria-hidden="true">
          <div class="flex items-center justify-between gap-2">
            <span class="flex items-center gap-2"><span class="ib"><svg viewBox="0 0 24 24" set:html={I.back} /></span><b class="text-[17px] font-semibold tracking-[-0.01em]" data-i18n="ft.availability">Mavjudlik</b></span>
            <span class="pill-outline"><span data-i18n="ft.restricted">Cheklangan</span> (1)</span>
          </div>
          <span class="field mt-2.5"><svg viewBox="0 0 24 24" set:html={I.search} /><span data-i18n="ft.searchItems">Mahsulot yoki variant qidirish...</span></span>
          <ul class="mt-2 flex flex-col gap-1.5">
            {stopRows.map((r) => (
              <li class="row">
                <img src={r.src} alt="" width="400" height="400" loading="lazy" decoding="async" class:list={[r.stopped && "off"]} />
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-[13px]">{r.n}</span>
                  <span class="m2 block text-[11px]" data-i18n="pos.variants3">3 ta variant</span>
                </span>
                {r.stopped ? <span class="tag red" data-i18n="ft.stopped">To'xtatilgan</span> : <span class="tag ok" data-i18n="ft.available">Mavjud</span>}
              </li>
            ))}
          </ul>
        </div>
      </li>

      {/* ---------- 4. floor plan ---------- */}
      <li class="card ft-tile lg:col-span-2">
        <div class="ft-cap">
          <h3 data-i18n="ft.floorT">Zal</h3>
          <p data-i18n="ft.floorD">Qaysi stol band, qancha vaqtdan beri o‘tirishibdi va kim ofitsiantni chaqirdi.</p>
        </div>
        <div class="ft-crop app" aria-hidden="true">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-[12px]">
            <span class="tab on"><span data-i18n="ft.all">Barchasi</span> <em>6</em></span>
            <span class="tab"><i class="dot" style="background:var(--s500)"></i><span data-i18n="ft.free">Bo'sh</span> <em>3</em></span>
            <span class="tab"><i class="dot" style="background:var(--accent)"></i><span data-i18n="ft.busy">Band</span> <em>3</em></span>
          </div>
          <ul class="tables mt-3">
            {tables.map((t) => (
              <li>
                <span class:list={["tbl", t.busy && "busy"]}>
                  {t.l}
                  {t.bell && <i class="req"><svg viewBox="0 0 24 24" set:html={I.bell} /></i>}
                </span>
                {t.busy ? (
                  <>
                    <b class="text-[11.5px] font-semibold tabular-nums">{t.total}</b>
                    <small class="m2 text-[10.5px] tabular-nums" data-i18n={`ft.min${t.min}`}>{t.min} daq</small>
                  </>
                ) : (
                  <small class="m2 text-[10.5px] font-medium" data-i18n="ft.free">Bo'sh</small>
                )}
              </li>
            ))}
          </ul>
        </div>
      </li>

      {/* ---------- 5. inbox ---------- */}
      <li class="card ft-tile lg:col-span-2">
        <div class="ft-cap">
          <h3 data-i18n="ft.inboxT">Xabarlar</h3>
          <p data-i18n="ft.inboxD">Onlayn buyurtmalar, qaytarish va bekor qilish so‘rovlari bir joyda.</p>
        </div>
        <div class="ft-crop app" aria-hidden="true">
          <div class="flex items-center justify-between gap-2">
            <b class="shrink-0 text-[17px] font-semibold tracking-[-0.01em]" data-i18n="ft.inbox">Xabarlar</b>
            <span class="pill-outline"><svg viewBox="0 0 24 24" set:html={I.checks} /><span data-i18n="ft.markAll">Barchasini o'qilgan deb belgilash</span></span>
          </div>
          <div class="note mt-2.5">
            <p class="nh"><span class="sq"><svg viewBox="0 0 24 24" set:html={I.bag} /></span><b data-i18n="ft.pending">Buyurtma tasdiqlash kutilmoqda</b><small><i></i>16:42</small></p>
            <p class="mt-2 text-[12px]" data-i18n="ft.pendingD">#0031 buyurtma tasdiqlash kutmoqda</p>
            <span class="obtn mt-2.5" data-i18n="ft.openOrder">Buyurtmani ochish</span>
          </div>
          <div class="note mt-1.5">
            <p class="nh"><span class="sq"><svg viewBox="0 0 24 24" set:html={I.shield} /></span><b data-i18n="ft.refundReq">Qaytarish so'rovi</b><small><i></i>16:05</small></p>
            <p class="mt-2 text-[12px]" data-i18n="ft.refundD">Dilnoza K. buyurtma #0022dagi 2 ta mahsulotni qaytarish so'radi</p>
            <p class="m2 mt-1 text-[11.5px]"><span data-i18n="ft.refundAmt">Qaytarish</span>: <b class="font-medium text-[var(--on)]">46 000</b></p>
          </div>
        </div>
      </li>
    </ul>
  </div>
</section>

<style>
  .ft-grid {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 768px) {
    .ft-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .ft-grid > :first-child,
    .ft-grid > :nth-child(2) {
      grid-column: span 2;
    }
  }
  @media (min-width: 1024px) {
    .ft-grid {
      grid-template-columns: repeat(6, 1fr);
    }
    .ft-grid > :first-child,
    .ft-grid > :nth-child(2) {
      grid-column: span 3;
    }
  }
  .ft-tile {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .ft-cap {
    padding: 24px 24px 20px;
  }
  .ft-cap h3 {
    font-family: var(--font-sans);
    font-size: 20px;
    line-height: 1.25;
    font-weight: 600;
  }
  .ft-cap p {
    margin-top: 6px;
    max-width: 46ch;
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1.5;
  }
  @media (min-width: 1024px) {
    .ft-cap {
      padding: 28px 28px 22px;
    }
  }

  /* The crop: the app's own page, centred under the caption with equal side
   * margins and cut only by the tile's bottom edge (sunday-style). */
  /* Fills the rest of the tile from the top, so panels in a row match in size. */
  .ft-crop {
    container-type: inline-size;
    flex: 1;
    min-width: 0;
    overflow: hidden;
    margin: 0 24px 24px;
    padding: 14px;
    border-radius: 14px;
  }
  @media (min-width: 1024px) {
    .ft-crop {
      margin: 0 28px 28px;
    }
  }

  /* App tokens (POS/Dash share them), light then dark — read from the live apps. */
  .app {
    --s100: oklch(98.09% 0.013 115.83);
    --s200: oklch(96.49% 0.015 119.1);
    --s300: oklch(94.79% 0.013 115.84);
    --s500: oklch(91.35% 0.015 119.12);
    --on: oklch(22.26% 0.027 133.88);
    --on2: oklch(39.23% 0.036 133.1);
    --border: oklch(56.54% 0.038 131.64);
    --accent: oklch(85.7% 0.17 134.56);
    --accent-ink: oklch(28.69% 0.0839 135.05);
    --forest: oklch(28.69% 0.0839 135.05);
    --yellow: oklch(92% 0.16 100);
    --cyan: oklch(86% 0.08 205);
    --grey: oklch(56.54% 0.038 131.64);
    --red: oklch(50.6% 0.193 27.7);
    --red-low: oklch(91.83% 0.042 25.2);
    background: var(--s100);
    color: var(--on);
    font-family: var(--font-sans);
    line-height: 1.4;
    text-align: left;
  }
  :global(:root:not([data-theme="dark"])) .app {
    --s100: oklch(19.09% 0.009 137.85);
    --s200: oklch(20.86% 0.009 137.84);
    --s300: oklch(23.89% 0.009 137.83);
    --s500: oklch(27.1% 0.011 139.43);
    --on: oklch(91.24% 0.03 125.98);
    --on2: oklch(82.4% 0.04 129.72);
    --border: oklch(37.54% 0.023 135.14);
    --forest: var(--accent);
    --red: oklch(83.83% 0.089 26.76);
    --red-low: oklch(25.2% 0.011 91.73);
  }
  .app svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .m2 {
    color: var(--on2);
  }
  .box {
    min-width: 0;
    border-radius: 10px;
    background: var(--s200);
    padding: 10px 12px;
  }
  .chip {
    border: 1px solid color-mix(in oklab, var(--on) 55%, transparent);
    border-radius: 999px;
    padding: 2px 9px;
    font-size: 11px;
    font-weight: 600;
    color: var(--forest);
  }
  .chip.on {
    border-color: transparent;
    background: var(--forest);
    color: var(--s100);
  }
  .delta {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    border-radius: 999px;
    background: color-mix(in oklab, var(--accent) 35%, transparent);
    padding: 1px 6px;
    color: var(--forest);
    font-size: 10.5px;
    font-weight: 600;
  }
  .delta svg {
    width: 10px;
    height: 10px;
  }
  .split {
    display: flex;
    gap: 2px;
    height: 8px;
  }
  .split span {
    border-radius: 999px;
  }
  /* Narrow mocks: two KPI boxes share ~230px, so the figures step down to fit. */
  .kpi {
    margin-top: 4px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.01em;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 4px;
    font-variant-numeric: tabular-nums;
  }
  .kpi > :first-child {
    white-space: nowrap;
  }
  /* Figure size follows the mock's width (half-row tile on desktop, full row on tablet). */
  @container (min-width: 300px) {
    .kpi {
      font-size: 18px;
    }
  }
  @container (min-width: 560px) {
    .kpi {
      font-size: 22px;
    }
  }
  .legend {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 6px 16px;
    font-size: 11.5px;
  }
  /* Two columns only when the mock itself is wide (a full-row tile), so long
   * labels (ru «Себестоимость продаж») are never cut. */
  @container (min-width: 600px) {
    .legend {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .legend div {
    min-width: 0;
    display: flex;
    justify-content: space-between;
    gap: 6px;
  }
  .legend dt {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 6px;
  }
  .legend dt span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .legend i {
    width: 7px;
    height: 7px;
    flex-shrink: 0;
    border-radius: 999px;
  }
  .legend dd {
    white-space: nowrap;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .legend small {
    color: var(--on2);
    font-weight: 400;
    font-size: 10px;
  }

  .chart-wrap {
    position: relative;
    padding-bottom: 18px;
  }
  .app svg.chart {
    display: block;
    width: 100%;
    height: 84px;
    stroke: none;
    overflow: visible;
  }
  .peak-dot {
    position: absolute;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--accent);
    transform: translate(-50%, -50%);
  }
  .peak-label {
    position: absolute;
    transform: translate(-50%, calc(-100% - 6px));
    font-size: 11px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }
  .axis {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 14px;
    color: var(--on2);
    font-size: 10.5px;
    line-height: 14px;
  }
  .axis span {
    position: absolute;
    transform: translateX(-50%);
    white-space: nowrap;
  }
  .axis span.first {
    transform: none;
  }
  .bars {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 11.5px;
  }
  .bars li {
    display: grid;
    grid-template-columns: 96px 1fr;
    align-items: center;
    gap: 8px;
  }
  .bn {
    overflow: hidden;
    text-overflow: ellipsis;
