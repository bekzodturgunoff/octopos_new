---
import logoDark from "../assets/logo_dark.webp";
import logoLight from "../assets/logo_light.webp";
import { LANGS } from "../data/i18n";

interface Props {
  /** The page starts with a forest hero: the header sits on forest until scrolled. */
  overHero?: boolean;
}
const { overHero = false } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: "/apps", key: "nav.apps" },
  { href: "/#solutions", key: "nav.solutions" },
  { href: "/#plans", key: "nav.pricing" },
  { href: "/#contact", key: "nav.contact" },
];
---

<header
  data-header
  data-over-hero={overHero ? "" : undefined}
  class:list={[
    // Static, like wise.com: the header sits at the top of the page and scrolls away with it.
    "relative z-50 w-full border-b border-transparent transition-[background-color,border-color] duration-200 ease-out",
    overHero ? "on-forest" : "bg-page",
  ]}
>
  <div class="wrap flex h-16 items-center justify-between gap-4 lg:h-[72px]">
    <a href="/" class="flex shrink-0 items-center gap-2.5 rounded-full focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-accent">
      <img
        src={logoDark.src}
        alt="Octopos"
        width="40"
        height="40"
        class="logo-dark block h-9 w-9 lg:h-10 lg:w-10"
        loading="eager"
        fetchpriority="high"
      />
      <img
        src={logoLight.src}
        alt=""
        width="40"
        height="40"
        class="logo-light block h-9 w-9 lg:h-10 lg:w-10"
        aria-hidden="true"
        loading="eager"
      />
      <span class="font-geist text-[18px] leading-none font-semibold tracking-[-0.2px] text-ink">Octopos</span>
    </a>

    <div class="flex items-center gap-2 lg:gap-3">
      <nav class="mr-3 hidden items-center gap-7 lg:flex" aria-label="Primary">
        {
          links.map((l) => (
            <a
              href={l.href}
              data-i18n={l.key}
              class:list={[
                "rounded-full font-geist text-[16px] leading-6 font-medium transition-colors duration-200 ease-out hover:text-ink focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-accent",
                !l.href.includes("#") && path === l.href ? "text-ink" : "text-ink/75",
              ]}
            >
              {l.key === "nav.apps"
              ? "Ilovalar"
              : l.key === "nav.solutions"
                ? "Yechimlar"
                : l.key === "nav.pricing"
                  ? "Tariflar"
                  : "Aloqa"}
            </a>
          ))
        }
      </nav>

      <div class="relative">
        <button
          type="button"
          data-lang-toggle
          aria-label="Language"
          data-i18n-attr="aria-label:nav.lang"
          aria-haspopup="true"
          aria-expanded="false"
          class="flex h-11 items-center gap-1.5 rounded-full border border-hairline px-4 font-geist text-[14px] leading-5 font-semibold lg:h-10 text-ink transition-colors duration-200 ease-out hover:border-ink/50 focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          <span data-lang-code>UZ</span>
          <svg
            class="h-3 w-3 opacity-60"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            ><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"
            ></path></svg
          >
        </button>
        <div
          data-lang-menu
          class="absolute top-[calc(100%+8px)] right-0 hidden w-[200px] overflow-hidden rounded-2xl border border-hairline bg-page p-1.5 shadow-lg"
        >
          {
            LANGS.map((l) => (
              <button
                type="button"
                data-set-lang={l.code}
                lang={l.code}
                class="group flex min-h-[44px] w-full items-center justify-between gap-3 rounded-xl px-3 font-geist text-[15px] leading-5 font-medium text-ink transition-colors duration-200 hover:bg-card focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-accent aria-[current=true]:bg-card aria-[current=true]:font-semibold"
              >
                <span>{l.native}</span>
                {/* Tick on the current language (aria-current set by the script below). */}
                <svg class="hidden h-4 w-4 text-link group-aria-[current=true]:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              </button>
            ))
          }
        </div>
      </div>


      <button
        type="button"
        data-theme-cycle
        aria-label="Toggle theme"
        class="relative hidden h-11 w-11 shrink-0 overflow-hidden rounded-full border border-hairline lg:h-10 lg:w-10 text-ink transition-colors duration-200 ease-out hover:border-ink/50 focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-accent sm:flex"
      >
        <span
          data-icon="light"
          class="absolute inset-0 flex items-center justify-center transition-transform duration-200 scale-100"
        >
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            ><circle cx="12" cy="12" r="5"></circle><path
              d="M12 1v2m0 18v2M4.22 4.22L5.64 5.64m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78L5.64 18.36m12.72-12.72l1.42 1.42"
              stroke-linecap="round"></path></svg
          >
        </span>
        <span
          data-icon="dark"
          class="absolute inset-0 flex items-center justify-center transition-transform duration-200 scale-0"
        >
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            ><path
              d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg
          >
        </span>
      </button>


      <div class="hidden lg:block">
        <button type="button" data-plan-trigger="starter" class="btn-solid btn btn-sm">
          <span data-i18n="nav.cta">Bepul sinab ko'ring</span>
        </button>
      </div>

      <button
        type="button"
        data-burger
        aria-label="Menu"
        data-i18n-attr="aria-label:nav.menu"
        aria-expanded="false"
        class="flex h-11 w-11 items-center justify-center rounded-full border border-hairline text-ink transition-colors duration-200 ease-out hover:border-ink/50 focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-accent lg:hidden"
      >
        <span class="relative block h-3.5 w-[18px]" aria-hidden="true">
          <span
            data-burger-bar
            class="absolute inset-x-0 top-0 h-[2px] rounded-full bg-current transition-transform duration-300 ease-far"
          ></span>
          <span
            data-burger-bar
            class="absolute inset-x-0 top-1/2 h-[2px] -translate-y-1/2 rounded-full bg-current transition-opacity duration-200 ease-far"
          ></span>
          <span
            data-burger-bar
            class="absolute inset-x-0 bottom-0 h-[2px] rounded-full bg-current transition-transform duration-300 ease-far"
          ></span>
        </span>
      </button>
    </div>
  </div>

  {/* Mobile: full-screen menu on forest. */}
  <div
    data-mobile-menu
    class="on-forest fixed inset-x-0 top-16 bottom-0 z-50 hidden overflow-y-auto overscroll-contain lg:hidden"
  >
    <div class="wrap flex min-h-full flex-col pt-4 pb-8">
      <nav class="flex flex-col" aria-label="Mobile">
        {
          links.map((l) => (
            <a
              href={l.href}
              data-i18n={l.key}
              data-menu-link
              class="display border-b border-hairline py-5 text-[40px] text-ink transition-colors duration-200 hover:text-link focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-accent"
            >
              {l.key === "nav.apps"
              ? "Ilovalar"
              : l.key === "nav.solutions"
                ? "Yechimlar"
                : l.key === "nav.pricing"
                  ? "Tariflar"
                  : "Aloqa"}
            </a>
          ))
        }
      </nav>
      <div class="mt-auto flex flex-col gap-3 pt-8">
        <button type="button" data-plan-trigger="starter" data-menu-link class="btn-solid btn w-full">
          <span data-i18n="nav.cta">Bepul sinab ko'ring</span>
        </button>
        <a href="https://t.me/bekzodturgunoff" class="btn-outline btn w-full">Telegram</a>
        <button type="button" data-theme-cycle aria-label="Toggle theme" class="mt-2 self-center font-geist text-[14px] font-medium text-muted underline underline-offset-4 sm:hidden">
          <span data-i18n="theme.toggle">Mavzu</span>
        </button>
      </div>
    </div>
  </div>
</header>

<style is:global>
  /* Scrolled (or any page without a forest hero): page surface + hairline. */
  [data-header][data-scrolled] {
    border-bottom-color: var(--color-hairline);
  }
  /* On forest the light logo is always the right one, whatever the theme. */
  .on-forest .logo-dark {
    display: none !important;
  }
  .on-forest .logo-light {
    display: block !important;
  }
</style>

<script>
  import { applyLang, getLang, localizePath, type Lang } from "../data/i18n";

  /* ---------- theme ---------- */
  const THEME_KEY = "theme";
  const COOKIE_MAX_AGE = 60 * 60 * 24 * 365;
  const DARK_COLOR = "oklch(19.09% 0.009 137.85)";
  const LIGHT_COLOR = "oklch(98.09% 0.013 115.83)";
  const html = document.documentElement;

  const getStoredTheme = () => {
    let v;
    try {
      v = localStorage.getItem(THEME_KEY);
    } catch (_) {}
    if (v === "dark" || v === "light") return v;
    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";
  };
  const hasExplicitTheme = () => {
    let v;
    try {
      v = localStorage.getItem(THEME_KEY);
    } catch (_) {}
    return v === "dark" || v === "light";
  };
  const setStoredTheme = (v: string) => {
    try {
      localStorage.setItem(THEME_KEY, v);
    } catch (_) {}
    document.cookie = `theme=${encodeURIComponent(v)}; path=/; max-age=${COOKIE_MAX_AGE}; SameSite=Lax`;
  };
  const syncThemeArtifacts = (effective: string) => {
    html.setAttribute("data-theme", effective);
    html.style.colorScheme = effective;
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta)
      meta.setAttribute(
        "content",
        effective === "dark" ? DARK_COLOR : LIGHT_COLOR,
      );
    const cs = document.querySelector('meta[name="color-scheme"]');
    if (cs) cs.setAttribute("content", effective);
  };
  const updateThemeUI = (mode: string) => {
    document.querySelectorAll("[data-theme-cycle]").forEach((btn) => {
      btn.setAttribute("aria-label", `Theme: ${mode}`);
      btn.querySelectorAll("[data-icon]").forEach((el) => {
        const show = el.getAttribute("data-icon") === mode;
        el.classList.toggle("scale-0", !show);
        el.classList.toggle("scale-100", show);
      });
    });
  };
  const applyTheme = (mode: string) => {
    syncThemeArtifacts(mode);
    updateThemeUI(mode);
  };

  applyTheme(getStoredTheme());
  if (!hasExplicitTheme()) {
    window
      .matchMedia("(prefers-color-scheme: dark)")
      .addEventListener("change", (e) => {
        applyTheme(e.matches ? "dark" : "light");
      });
  }
  document.querySelectorAll("[data-theme-cycle]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const next = getStoredTheme() === "dark" ? "light" : "dark";
      setStoredTheme(next);
      applyTheme(next);
    });
  });

  /* ---------- language ---------- */
  const codeEl = document.querySelector<HTMLElement>("[data-lang-code]");
  const menu = document.querySelector<HTMLElement>("[data-lang-menu]");
  const toggle = document.querySelector<HTMLElement>("[data-lang-toggle]");

  const syncLangUI = (l: Lang) => {
    if (codeEl) codeEl.textContent = l.toUpperCase();
    document.querySelectorAll<HTMLElement>("[data-set-lang]").forEach((b) => {
      b.setAttribute("aria-current", String(b.getAttribute("data-set-lang") === l));
    });
  };

  const initial = getLang();
  applyLang(initial);
  syncLangUI(initial);

  const closeMenu = () => {
    menu?.classList.add("hidden");
    toggle?.setAttribute("aria-expanded", "false");
  };

  toggle?.addEventListener("click", (e) => {
    e.stopPropagation();
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
  });
  document.addEventListener("click", (e) => {
    if (menu && !menu.contains(e.target as Node)) closeMenu();
  });

  document.querySelectorAll<HTMLElement>("[data-set-lang]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const l = btn.getAttribute("data-set-lang") as Lang;
      closeMenu();
      if (l === getLang()) return;
      window.location.assign(localizePath(l));
    });
  });

  /* ---------- mobile menu ---------- */
  const burger = document.querySelector<HTMLElement>("[data-burger]");
  const mobile = document.querySelector<HTMLElement>("[data-mobile-menu]");
  const burgerBars = burger?.querySelectorAll<HTMLElement>("[data-burger-bar]");

  const setBurger = (open: boolean): void => {
    burger?.setAttribute("aria-expanded", String(open));
    const [top, mid, bottom] = Array.from(burgerBars ?? []);
    top?.classList.toggle("translate-y-[6px]", open);
    top?.classList.toggle("rotate-45", open);
    mid?.classList.toggle("opacity-0", open);
    bottom?.classList.toggle("-translate-y-[6px]", open);
    bottom?.classList.toggle("-rotate-45", open);
  };

  const header = document.querySelector<HTMLElement>("[data-header]");
  const overHero = header?.hasAttribute("data-over-hero") ?? false;
  let menuOpen = false;

  // The header is static, so it only changes with the menu: forest over the hero
  // or while the forest menu is open, page surface otherwise.
  const syncHeader = (): void => {
    if (!header) return;
    const forest = menuOpen || overHero;
    header.classList.toggle("on-forest", forest);
    header.classList.toggle("bg-page", !forest);
  };
  syncHeader();

  const setMenu = (open: boolean): void => {
    menuOpen = open;
    mobile?.classList.toggle("hidden", !open);
    document.documentElement.classList.toggle("overflow-hidden", open);
    setBurger(open);
    syncHeader();
  };
  burger?.addEventListener("click", () => setMenu(!menuOpen));
  mobile?.querySelectorAll("[data-menu-link]").forEach((el) =>
    el.addEventListener("click", () => setMenu(false)),
  );
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menuOpen) {
      setMenu(false);
      burger?.focus();
    }
  });
  window.matchMedia("(min-width: 1024px)").addEventListener("change", (e) => {
    if (e.matches && menuOpen) setMenu(false);
  });
</script>
