---
/**
 * Small pieces of the real Octopos UI, rebuilt in HTML so they stay sharp,
 * translate with the page and carry no client data.
 *
 * Each one mirrors a real screen (labels and structure taken from it):
 *   void  — RestaurantPOS › Ruxsatlar (cancel request waiting for a manager)
 *   stock — Dash › Inventarizatsiya (attention tiles + sections)
 *   shift — RestaurantPOS › Ish kuni (business-day register)
 *   store — Store (the restaurant's own ordering site)
 *
 * Demo data is Uzbek on purpose (dish and staff names are not translated).
 */
interface Props {
  kind: "void" | "stock" | "shift" | "store";
}
const { kind } = Astro.props;

const stockTiles = [
  { k: "s1", t: "3 ta noldan past", a: "Qoldiqlarni to'g'rilash", warn: true },
  { k: "s2", t: "2 ta tugallanmagan inventarizatsiya", a: "Yakunlash", warn: false },
  { k: "s3", t: "1 partiyaning muddati tugayapti", a: "Avval shularni ishlating", warn: true },
];
const stockRows = [
  { k: "r1", t: "Zaxira holati", d: "Mahsulotlar va ingrediyentlar zaxirasini ko'rish" },
  { k: "r2", t: "Inventarizatsiyalar", d: "Tovarni sanang va farqlarni ko'ring" },
  { k: "r3", t: "Nima buyurtma qilish kerak", d: "Nima va kimdan sotib olish" },
];
const shiftSales = [
  { k: "gross", l: "Yalpi savdo", v: "9 005 600" },
  { k: "disc", l: "Chegirmalar", v: "− 120 000" },
  { k: "sur", l: "Ustamalar", v: "+ 466 600" },
  { k: "net", l: "Sof savdo", v: "9 352 200", b: true },
];
const shiftVoids = [
  { k: "void", l: "Bekor qilingan (5)", v: "185 000" },
  { k: "mistake", l: "Kiritish xatosi (3)", v: "111 000" },
  { k: "changed", l: "Mijoz fikrini o'zgartirdi (2)", v: "74 000" },
];
const storeItems = [
  { n: "Osh - 0.5", p: "45 000" },
  { n: "Lag'mon", p: "38 000" },
  { n: "Somsa", p: "12 000" },
];
const chevron = "M9 6l6 6-6 6";
---

<div class="mock invert-theme" aria-hidden="true">
  {
    kind === "void" && (
      <div class="ui overflow-hidden">
        <p class="bg-[#ffe96b] py-1.5 text-center text-[13px] font-semibold text-[#161e11]" data-i18n="mock.pending">Kutilmoqda</p>
        <div class="p-5">
          <div class="flex items-center justify-between gap-3">
            <p class="flex items-center gap-2.5 text-[15px] font-semibold">
              <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-[#ffe96b] text-[#161e11]">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path d="M12 8v4M12 16h.01" /></svg>
              </span>
              <span data-i18n="mock.voidTitle">Bekor qilish so'rovi</span>
            </p>
            <span class="text-[12px] text-muted">12 Noy, 13:45</span>
          </div>
          <p class="mt-4 text-[15px] leading-[22px]" data-i18n="mock.voidText">Dilnoza K. 1 ta × Osh - 0.5 ni bekor qilishni so'radi</p>
          <p class="mt-3 text-[14px] text-muted"><span data-i18n="mock.reason">Sabab</span>: <b class="font-semibold text-ink" data-i18n="mock.reasonChanged">Mijoz fikrini o'zgartirdi</b></p>
          <p class="mt-1 text-[14px] text-muted"><span data-i18n="mock.sentBy">So'rov yuborgan</span>: <b class="font-semibold text-ink">Dilnoza K.</b></p>
          <p class="mt-4 flex justify-between border-t border-hairline pt-3 text-[14px] font-medium"><span>Osh - 0.5</span><span class="text-muted">× 1</span></p>
          <div class="mt-4 grid grid-cols-2 gap-2">
            <span class="flex h-10 items-center justify-center rounded-full bg-accent text-[14px] font-semibold text-accent-emphasis" data-i18n="mock.approve">Tasdiqlash</span>
            <span class="flex h-10 items-center justify-center rounded-full border border-error-bright text-[14px] font-semibold text-error-bright" data-i18n="mock.reject">Rad etish</span>
          </div>
        </div>
      </div>
    )
  }

  {
    kind === "stock" && (
      <div class="ui p-5">
        <p class="text-[13px] font-medium text-muted" data-i18n="mock.attention">E'tibor talab qiladi</p>
        <ul class="mt-3 grid gap-2 sm:grid-cols-3">
          {stockTiles.map((t) => (
            <li class="rounded-xl bg-card p-3.5">
              <svg class:list={["h-4 w-4", t.warn ? "text-error-bright" : "text-muted"]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 8v4M12 16h.01" /></svg>
              <p class="mt-2 text-[14px] leading-[19px] font-semibold" data-i18n={`mock.${t.k}t`}>{t.t}</p>
              <p class="mt-1.5 text-[12.5px] leading-[17px] text-link" data-i18n={`mock.${t.k}a`}>{t.a}</p>
            </li>
          ))}
        </ul>
        <ul class="mt-4 flex flex-col">
          {stockRows.map((r) => (
            <li class="flex items-center gap-3 border-t border-hairline py-3">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-card text-muted">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8 12 3 3 8v8l9 5 9-5V8z" /><path d="M3 8l9 5 9-5M12 13v8" /></svg>
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-[14.5px] font-semibold" data-i18n={`mock.${r.k}t`}>{r.t}</span>
                <span class="block truncate text-[13px] text-muted" data-i18n={`mock.${r.k}d`}>{r.d}</span>
              </span>
              <svg class="h-4 w-4 shrink-0 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={chevron} /></svg>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {
    kind === "shift" && (
      <div class="ui p-5">
        <div class="flex items-center gap-2.5">
          <p class="text-[19px] font-semibold tracking-[-0.2px]" data-i18n="mock.register">Asosiy kassa</p>
          <span class="rounded-full bg-accent px-2.5 py-0.5 text-[12px] font-semibold text-accent-emphasis" data-i18n="mock.open">Ochiq</span>
        </div>
        <p class="mt-3 flex justify-between text-[13.5px] text-muted"><span data-i18n="mock.shiftOpened">Smena ochilgan</span><span>10:02</span></p>

        <p class="mt-5 border-b border-hairline pb-2 text-[13px] font-medium text-muted" data-i18n="mock.sales">Savdo</p>
        <dl class="mt-1">
          {shiftSales.map((r) => (
            <div class:list={["flex justify-between py-1.5 text-[14.5px] tabular-nums", r.b && "border-t border-hairline font-semibold"]}>
              <dt data-i18n={`mock.${r.k}`}>{r.l}</dt>
              <dd>{r.v}</dd>
            </div>
          ))}
        </dl>

        <p class="mt-4 border-b border-hairline pb-2 text-[13px] font-medium text-muted" data-i18n="mock.writeOff">Hisobdan chiqarish</p>
        <dl class="mt-1">
          {shiftVoids.map((r, i) => (
            <div class:list={["flex justify-between py-1.5 tabular-nums", i === 0 ? "text-[14.5px]" : "pl-3 text-[13.5px] text-muted"]}>
              <dt data-i18n={`mock.${r.k}`}>{r.l}</dt>
              <dd>{r.v}</dd>
            </div>
          ))}
        </dl>
      </div>
    )
  }

  {
    kind === "store" && (
      <div class="ui mx-auto max-w-[340px] overflow-hidden">
        <div class="flex items-center gap-3 border-b border-hairline p-4">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent text-[11px] font-bold text-accent-emphasis">LOGO</span>
          <span class="flex h-9 min-w-0 flex-1 items-center gap-2 rounded-lg border border-hairline px-3 text-[13px] text-muted">
            <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
            <span class="truncate" data-i18n="mock.search">Nima qidiryapsiz?</span>
          </span>
        </div>
        <div class="p-4">
          <ul class="grid grid-cols-2 gap-2 text-[12.5px]">
            <li class="rounded-xl bg-card p-3"><b class="block font-semibold" data-i18n="mock.delivery">Yetkazib berish</b><span class="text-muted" data-i18n="mock.toDoor">Eshigingizgacha</span></li>
            <li class="rounded-xl bg-card p-3"><b class="block font-semibold" data-i18n="mock.payOnline">Onlayn to'lov</b><span class="text-muted">Payme, Click</span></li>
          </ul>
          <ul class="mt-3 flex flex-col">
            {storeItems.map((i) => (
              <li class="flex items-center justify-between gap-3 border-t border-hairline py-3">
                <span>
                  <span class="block text-[14.5px] font-semibold">{i.n}</span>
                  <span class="block text-[13.5px] text-muted tabular-nums">{i.p}</span>
                </span>
                <span class="flex h-9 w-9 items-center justify-center rounded-full border border-hairline text-[18px] leading-none">+</span>
              </li>
            ))}
          </ul>
          <p class="mt-2 flex items-center justify-between rounded-xl bg-accent px-4 py-3 text-[14px] font-semibold text-accent-emphasis">
            <span data-i18n="mock.commission">Komissiya</span><span class="tabular-nums">0 so'm</span>
          </p>
        </div>
      </div>
    )
  }
</div>

<style>
  .mock {
    font-family: var(--font-sans);
    color: var(--color-ink);
    text-align: left;
  }
  .ui {
    border-radius: 20px;
    background: var(--color-page);
    border: 1px solid var(--color-hairline);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }
</style>
