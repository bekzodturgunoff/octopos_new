---
/**
 * Small pieces of the real Octopos UI, rebuilt in HTML so they stay sharp,
 * translate with the page and carry no client data.
 *
 * Each one mirrors a real screen (labels and structure taken from it):
 *   void  — RestaurantPOS › Ruxsatlar (cancel request waiting for a manager)
 *   stock — Dash › Inventarizatsiya (attention tiles + sections)
 *   shift — RestaurantPOS › Ish kuni (business-day register)
 *   store — Onlayn do'kon, mobile (copied from https://sushi-panda.shop.octopos.uz/ and kdsx-storefront)
 *
 * The POS/Dash cards are theme-inverted (dark on the light page, light on the
 * dark page). The store keeps the storefront's own palette and follows the theme.
 * Demo data is Uzbek on purpose (dish and staff names are not translated).
 */
import logoDark from "../assets/logo_dark.webp";
import logoLight from "../assets/logo_light.webp";

interface Props {
  kind: "void" | "stock" | "shift" | "store";
}
const { kind } = Astro.props;

const stockTiles = [
  { k: "s1", t: "3 ta noldan past", a: "Qoldiqlarni to'g'rilash", warn: true },
  { k: "s2", t: "2 ta tugallanmagan inventarizatsiya", a: "Yakunlash", warn: false },
  { k: "s3", t: "1 partiyaning muddati tugayapti", a: "Avval shularni ishlating", warn: true },
];
const stockRows = [
  { k: "r1", t: "Zaxira holati", d: "Mahsulotlar va ingrediyentlar zaxirasini ko'rish" },
  { k: "r2", t: "Inventarizatsiyalar", d: "Tovarni sanang va farqlarni ko'ring" },
];
const shiftSales = [
  { k: "gross", l: "Yalpi savdo", v: "9 005 600" },
  { k: "disc", l: "Chegirmalar", v: "− 120 000" },
  { k: "sur", l: "Ustamalar", v: "+ 466 600" },
  { k: "net", l: "Sof savdo", v: "9 352 200", b: true },
];
const shiftVoids = [
  { k: "void", l: "Bekor qilingan (5)", v: "185 000" },
];
const chevron = "M9 6l6 6-6 6";

// Lucide paths (the icon set the storefront uses).
const I = {
  house: '<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
  search: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
  truck: '<path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/>',
  clock: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
  card: '<rect width="20" height="14" x="2" y="5" rx="2"/><path d="M2 10h20"/>',
  grid: '<rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/>',
  bag: '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>',
  user: '<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  moon: '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>',
};

const storeTabs = [I.house, I.grid, I.search, I.bag, I.user];
---

<div class:list={["mock", kind !== "store" && "invert-theme"]} aria-hidden="true">
  {
    kind === "void" && (
      <div class="ui overflow-hidden">
        <p class="bg-[#ffe96b] py-1.5 text-center text-[13px] font-semibold text-[#161e11]" data-i18n="mock.pending">Kutilmoqda</p>
        <div class="p-5">
          <div class="flex items-center justify-between gap-3">
            <p class="flex items-center gap-2.5 text-[15px] font-semibold">
              <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-[#ffe96b] text-[#161e11]">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path d="M12 8v4M12 16h.01" /></svg>
              </span>
              <span data-i18n="mock.voidTitle">Bekor qilish so'rovi</span>
            </p>
            <span class="text-[12px] text-muted" data-i18n="mock.date">12 Noy, 13:45</span>
          </div>
          <p class="mt-4 text-[15px] leading-[22px]" data-i18n="mock.voidText">Dilnoza K. 1 ta × Osh - 0.5 ni bekor qilishni so'radi</p>
          <p class="mt-3 text-[14px] text-muted"><span data-i18n="mock.reason">Sabab</span>: <b class="font-semibold text-ink" data-i18n="mock.reasonChanged">Mijoz fikrini o'zgartirdi</b></p>
          <p class="mt-1 text-[14px] text-muted"><span data-i18n="mock.sentBy">So'rov yuborgan</span>: <b class="font-semibold text-ink">Dilnoza K.</b></p>
          <p class="mt-4 flex justify-between border-t border-hairline pt-3 text-[14px] font-medium"><span>Osh - 0.5</span><span class="text-muted">× 1</span></p>
          <div class="mt-4 grid grid-cols-2 gap-2">
            <span class="flex h-10 items-center justify-center rounded-full bg-accent text-[14px] font-semibold text-accent-emphasis" data-i18n="mock.approve">Tasdiqlash</span>
            <span class="flex h-10 items-center justify-center rounded-full border border-error-bright text-[14px] font-semibold text-error-bright" data-i18n="mock.reject">Rad etish</span>
          </div>
        </div>
      </div>
    )
  }

  {
    kind === "stock" && (
      <div class="ui p-5">
        <p class="text-[13px] font-medium text-muted" data-i18n="mock.attention">E'tibor talab qiladi</p>
        <ul class="mt-3 grid gap-2 sm:grid-cols-3">
          {stockTiles.map((t) => (
            <li class="rounded-xl bg-card p-3.5">
              <svg class:list={["h-4 w-4", t.warn ? "text-error-bright" : "text-muted"]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 8v4M12 16h.01" /></svg>
              <p class="mt-2 text-[14px] leading-[19px] font-semibold" data-i18n={`mock.${t.k}t`}>{t.t}</p>
              <p class="mt-1.5 text-[12.5px] leading-[17px] text-link" data-i18n={`mock.${t.k}a`}>{t.a}</p>
            </li>
          ))}
        </ul>
        <ul class="mt-4 flex flex-col">
          {stockRows.map((r) => (
            <li class="flex items-center gap-3 border-t border-hairline py-3">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-card text-muted">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8 12 3 3 8v8l9 5 9-5V8z" /><path d="M3 8l9 5 9-5M12 13v8" /></svg>
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-[14.5px] font-semibold" data-i18n={`mock.${r.k}t`}>{r.t}</span>
                <span class="block truncate text-[13px] text-muted" data-i18n={`mock.${r.k}d`}>{r.d}</span>
              </span>
              <svg class="h-4 w-4 shrink-0 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={chevron} /></svg>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {
    kind === "shift" && (
      <div class="ui p-5">
        <div class="flex items-center gap-2.5">
          <p class="text-[19px] font-semibold tracking-[-0.2px]" data-i18n="mock.register">Asosiy kassa</p>
          <span class="rounded-full bg-accent px-2.5 py-0.5 text-[12px] font-semibold text-accent-emphasis" data-i18n="mock.open">Ochiq</span>
        </div>
        <p class="mt-3 flex justify-between text-[13.5px] text-muted"><span data-i18n="mock.shiftOpened">Smena ochilgan</span><span>10:02</span></p>

        <p class="mt-5 border-b border-hairline pb-2 text-[13px] font-medium text-muted" data-i18n="mock.sales">Savdo</p>
        <dl class="mt-1">
          {shiftSales.map((r) => (
            <div class:list={["flex justify-between py-1.5 text-[14.5px] tabular-nums", r.b && "border-t border-hairline font-semibold"]}>
              <dt data-i18n={`mock.${r.k}`}>{r.l}</dt>
              <dd>{r.v}</dd>
            </div>
          ))}
        </dl>

        <p class="mt-4 border-b border-hairline pb-2 text-[13px] font-medium text-muted" data-i18n="mock.writeOff">Hisobdan chiqarish</p>
        <dl class="mt-1">
          {shiftVoids.map((r, i) => (
            <div class:list={["flex justify-between py-1.5 tabular-nums", i === 0 ? "text-[14.5px]" : "pl-3 text-[13.5px] text-muted"]}>
              <dt data-i18n={`mock.${r.k}`}>{r.l}</dt>
              <dd>{r.v}</dd>
            </div>
          ))}
        </dl>
      </div>
    )
  }

  {
    kind === "store" && (
      <div>
        <div class="screen sf">
          <div class="px-5 pt-5">
            <div class="flex items-center justify-between">
              {/* Shop logo slot: Octopos's own mark, not a client's. Same files the header loads. */}
              <span class="flex items-center gap-2">
                <img src={logoDark.src} alt="" width="28" height="28" class="logo-dark h-7 w-7" loading="lazy" decoding="async" />
                <img src={logoLight.src} alt="" width="28" height="28" class="logo-light h-7 w-7" loading="lazy" decoding="async" />
                <span class="text-[13px] font-semibold tracking-[-0.2px]">Octopos</span>
              </span>
              <svg class="h-4 w-4" viewBox="0 0 24 24" set:html={I.moon} />
            </div>
            <div class="sf-field mt-3 flex h-9 items-center gap-2 px-3 text-[12px]">
              <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" set:html={I.search} />
              <span class="sf-muted truncate" data-i18n="mock.search">Nima qidiryapsiz?</span>
            </div>

            {/* Banner: the shop's own photo and copy (shop content, not translated). */}
            <div class="relative mt-3 overflow-hidden rounded-[10px]">
              <img src="/mock/store/banner.webp" alt="" width="560" height="380" class="block aspect-[2.1] w-full object-cover" loading="lazy" decoding="async" />
              <div class="absolute inset-0 flex flex-col justify-center bg-gradient-to-r from-black/55 to-transparent p-3.5 text-white">
                <p class="text-[16px] leading-[1.15] font-bold tracking-[-0.3px]" data-i18n="mock.bannerT">Bir dona kamlik qiladi</p>
                <p class="mt-1 max-w-[190px] text-[9.5px] leading-[13px] opacity-85" data-i18n="mock.bannerD">Mazali rollardan birini tanlash qiyinmi? Unda bir nechtasini sinab ko'ring.</p>
                <span class="mt-2.5 w-fit rounded-full bg-[#ffa77e] px-3 py-1.5 text-[10px] font-semibold text-[#161e11]" data-i18n="mock.choose">Tanlang</span>
              </div>
            </div>
            <div class="mt-2 flex justify-center gap-1">
              <span class="sf-dot h-1 w-4 rounded-full" /><span class="sf-dot-off h-1 w-1 rounded-full" /><span class="sf-dot-off h-1 w-1 rounded-full" />
            </div>

            <ul class="mt-4 grid grid-cols-3 gap-x-2 pb-5 text-[10.5px]">
              <li class="flex gap-2">
                <svg class="sf-accent mt-0.5 h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" set:html={I.truck} />
                <span><b class="block font-semibold" data-i18n="mock.delivery">Yetkazib berish</b><span class="sf-muted" data-i18n="mock.toDoor">Eshigingizgacha</span></span>
              </li>
              <li class="flex gap-2">
                <svg class="sf-accent mt-0.5 h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" set:html={I.clock} />
                <span><b class="block font-semibold" data-i18n="mock.pickup">Olib ketish</b><span class="sf-muted">Chorsu, Mirobod</span></span>
              </li>
              <li class="flex gap-2">
                <svg class="sf-accent mt-0.5 h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" set:html={I.card} />
                <span><b class="block font-semibold" data-i18n="mock.payOnline">Onlayn to'lov</b><span class="sf-muted">Payme, Click</span></span>
              </li>
            </ul>

            
          </div>
          <nav class="sf-tabs">
            {storeTabs.map((icon, i) => (
              <svg class:list={["h-4 w-4", i === 0 ? "sf-accent" : ""]} viewBox="0 0 24 24" set:html={icon} />
            ))}
          </nav>
        </div>
      </div>
    )
  }
</div>

<style>
  .mock {
    font-family: var(--font-sans);
    color: var(--color-ink);
    text-align: left;
  }
  .ui {
    border-radius: 20px;
    background: var(--color-page);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }
  .sf svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Store: the storefront page, same width and corners as the other mocks. */
  .screen {
    overflow: hidden;
    border-radius: 20px;
  }

  /* Storefront: its own neutral palette (white, not the brand cream). */
  .sf {
    --sf-bg: #ffffff;
    --sf-fg: #141414;
    --sf-muted: #5f5f5f;
    --sf-field: #f5f5f4;
    --sf-line: #8a8a8a;
    --sf-accent-c: #8a3b12;
    background: var(--sf-bg);
    color: var(--sf-fg);
  }
  :global(:root[data-theme="dark"]) .sf {
    --sf-bg: #141414;
    --sf-fg: #f2f2f2;
    --sf-muted: #a5a5a5;
    --sf-field: #1f1f1f;
    --sf-line: #5a5a5a;
    --sf-accent-c: #ffa77e;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .sf {
      --sf-bg: #141414;
      --sf-fg: #f2f2f2;
      --sf-muted: #a5a5a5;
      --sf-field: #1f1f1f;
      --sf-line: #5a5a5a;
      --sf-accent-c: #ffa77e;
    }
  }
  .sf-field {
    border-radius: 8px;
    border: 1px solid var(--sf-line);
    background: var(--sf-field);
  }
  .sf-muted {
    color: var(--sf-muted);
  }
  .sf-accent {
    color: var(--sf-accent-c);
  }
  .sf-dot {
    background: var(--sf-fg);
  }
  .sf-dot-off {
    background: color-mix(in oklab, var(--sf-fg) 15%, transparent);
  }
  .sf-tabs {
    display: flex;
    justify-content: space-around;
    padding: 10px 6px 12px;
    border-top: 1px solid color-mix(in oklab, var(--sf-fg) 8%, transparent);
    background: var(--sf-bg);
  }
</style>
