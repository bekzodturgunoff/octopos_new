---
/**
 * RestaurantPOS order screen, rebuilt in HTML for the hero.
 *
 * Copied from the live app (bonet tenant, kdsx-pos-v2 home route, 1280×800
 * tablet layout, light theme) with these settings: catalogue picture size
 * "Small" (six 128px tiles a row, 12px apart) and order actions "Unified".
 *
 *   catalogue — search bar, Menyu › Kofelar breadcrumb, the colour-coded
 *               folder chips, numbered product tiles (real bonet photos and
 *               prices; a single-variant item shows its price, others "N ta
 *               variant").
 *   order     — an open table (Stol 4): the lines already sent to the kitchen,
 *               grouped under "3 ta yuborilgan mahsulot", then the new lines
 *               with steppers, notes, subtotal / service / total, and the
 *               Unified actions (Ushlab turish · Qolish · Jo'natish, To'lov F8).
 *   tab bar   — the six tabs.
 *
 * Sizes and colours are the live app's computed values; 1em = 16px at 1280.
 * Labels use the POS's own translations (kdsx-pos-v2/public/locales). Product,
 * folder and table names are the tenant's catalogue data and stay as they are.
 *
 * Scales as one piece with its container width, so it is shown whole at every
 * width (scaled down on phones, never cropped). Always the light theme.
 */
const P = "/mock/pos/coffee/";
const tiles = [
  { name: "Ristretto", img: "ristretto", price: "22 000" },
  { name: "Espresso Lungo", img: "espresso-lungo", price: "16 000" },
  { name: "Espresso", img: "espresso-lungo", price: "15 000" },
  { name: "Espresso Dvoynoy (Doppio)", img: "espresso-dvoynoy-doppio", price: "19 000" },
  { name: "Americano", img: "americano", variants: 2 },
  { name: "Americano Dopio", img: "americano", variants: 2 },
  { name: "Raf", img: "raf", variants: 3 },
  { name: "Latte", img: "latte", price: "20 000" },
  { name: "Latte Bananoviy 300", img: "latte-bananoviy-300", price: "28 000" },
  { name: "Cappucino", img: "cappucino", variants: 2 },
  { name: "Mokko", img: "mokko", variants: 3 },
  { name: "Flet White", img: "flet-white", variants: 2 },
  { name: "Ice Americano", img: "ice-americano", variants: 3 },
  { name: "Ice Cappucino 0.7", img: "ice-cappucino-0-7", price: "30 000" },
  { name: "Ice Raf 0.7", img: "ice-raf-0-7", price: "30 000" },
  { name: "Ice Latte", img: "ice-latte", price: "30 000" },
  { name: "Glayse", img: "glayse", price: "15 000" },
  { name: "Topping", img: "topping", price: "5 000" },
];
// Folder chips: name and the live app's colours (background, text).
const folders = [
  { name: "Muzqaymoqlar", bg: "oklch(0.84 0.125 185)", fg: "oklch(0.255 0.055 195)" },
  { name: "Kofelar", bg: "oklch(0.82 0.15 45)", fg: "oklch(0.265 0.055 40)", on: true },
  { name: "Ichimliklar", bg: "oklch(0.76 0.136 240)", fg: "oklch(0.15 0.01 90)" },
  { name: "Shrinliklar", bg: "oklch(0.74 0.2 330)", fg: "oklch(0.15 0.01 90)" },
  { name: "Vafli", bg: "oklch(0.82 0.16 90)", fg: "oklch(0.15 0.01 90)" },
  { name: "Choylar", bg: "oklch(0.9419 0.1502 100.63)", fg: "oklch(0.3147 0.0392 95.76)" },
  { name: "Setlar", bg: "oklch(0.785 0.135 300)", fg: "oklch(0.265 0.09 305)" },
];
// Already sent to the kitchen (order #0019 on the live tenant).
const sent = [
  { name: "Vafli klubnika", qty: 1, price: "45 000" },
  { name: "Vafli banan klubnika", qty: 1, price: "55 000" },
  { name: "Kok choy", qty: 1, price: "6 000" },
];
// New lines, not sent yet. 106 000 sent + 62 000 new = 168 000; service 10% = 16 800.
const lines = [
  { name: "Ristretto", qty: 1, price: "22 000" },
  { name: "Latte", qty: 2, price: "40 000" },
];
const tabs = [
  { k: "pos.tabLock", t: "Qulflash", i: '<rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>' },
  { k: "pos.tabFloor", t: "Zal", i: '<path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>' },
  { k: "pos.tabHome", t: "Uy", i: '<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>', active: true },
  { k: "pos.tabOrders", t: "Buyurtma", i: '<path d="M3 12h.01"/><path d="M3 18h.01"/><path d="M3 6h.01"/><path d="M8 12h13"/><path d="M8 18h13"/><path d="M8 6h13"/>' },
  { k: "pos.tabInbox", t: "Xabarlar", i: '<path d="M10.268 21a2 2 0 0 0 3.464 0"/><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"/>', badge: "3" },
  { k: "pos.tabMore", t: "Boshqa", i: '<path d="M4 12h16"/><path d="M4 18h16"/><path d="M4 6h16"/>' },
];
const ico = {
  back: '<path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>',
  search: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
  scan: '<path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><path d="M8 7v10"/><path d="M12 7v10"/><path d="M17 7v10"/>',
  chevron: '<path d="m9 18 6-6-6-6"/>',
  down: '<path d="m6 9 6 6 6-6"/>',
  columns: '<rect width="6" height="16" x="4" y="4" rx="1"/><rect width="6" height="16" x="14" y="4" rx="1"/>',
  folder: '<path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/>',
  utensils: '<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 3 2h3Zm0 0v7"/>',
  dots: '<circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/>',
  minus: '<path d="M5 12h14"/>',
  plus: '<path d="M5 12h14"/><path d="M12 5v14"/>',
  hold: '<circle cx="12" cy="12" r="10"/><line x1="10" x2="10" y1="15" y2="9"/><line x1="14" x2="14" y1="15" y2="9"/>',
  pin: '<path d="M12 17v5"/><path d="M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"/>',
  send: '<path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"/><path d="m21.854 2.147-10.94 10.939"/>',
};
---

<div class="pos-hero" role="img" aria-label="RestaurantPOS — buyurtma ekrani" data-i18n-attr="aria-label:pos.alt">
  <div class="pos" aria-hidden="true">
    <div class="pos-main">
      {/* ---------- catalogue ---------- */}
      <section class="pos-left">
        <div class="pos-top">
          <span class="pos-icon-btn plain"><svg viewBox="0 0 24 24" set:html={ico.back} /></span>
          <span class="pos-search">
            <svg viewBox="0 0 24 24" set:html={ico.search} />
            <span class="grow" data-i18n="pos.search">Mahsulotlarni qidirish</span>
            <svg viewBox="0 0 24 24" set:html={ico.scan} />
            <span class="kbd-k">⌘ K</span>
          </span>
        </div>
        <div class="pos-crumbs">
          <span><span data-i18n="pos.menu">Menyu</span><svg viewBox="0 0 24 24" set:html={ico.chevron} /><span>Kofelar</span></span>
          <span class="pos-icon-btn"><svg viewBox="0 0 24 24" set:html={ico.columns} /></span>
        </div>
        <div class="pos-folders">
          {folders.map((f) => (
            <span class:list={["pos-folder", f.on && "is-on"]} style={`--bg:${f.bg};--fg:${f.fg}`}>
              <svg viewBox="0 0 24 24" set:html={ico.folder} />
              {f.name}
            </span>
          ))}
        </div>
        <ul class="pos-grid">
          {tiles.map((t, i) => (
            <li class="pos-tile">
              <span class="pos-photo">
                {/* Tiles are ~45px on phones, 128px on desktop: 160/320px files. Not high
                    priority — the headline text is the page's largest paint. */}
                <img
                  src={`${P}${t.img}.webp`}
                  srcset={`${P}${t.img}-160.webp 160w, ${P}${t.img}.webp 320w`}
                  sizes="(max-width: 767px) 60px, 128px"
                  alt=""
                  width="320"
                  height="320"
                  loading={i < 12 ? "eager" : "lazy"}
                  decoding="async"
                />
                {i < 9 && <kbd>{i + 1}</kbd>}
              </span>
              <span class="pos-tile-info">
                <span class="pos-tile-name">{t.name}</span>
                {t.price ? (
                  <span class="pos-price">{t.price}</span>
                ) : (
                  <span class="pos-chip" data-i18n={`pos.variants${t.variants}`}>{t.variants} ta variant</span>
                )}
              </span>
            </li>
          ))}
        </ul>
      </section>

      {/* ---------- order panel (order actions: Unified) ---------- */}
      <section class="pos-right">
        <div class="pos-head">
          <span class="min-w-0">
            <span class="pos-title">Stol 4</span>
            <span class="pos-pill">
              <svg viewBox="0 0 24 24" set:html={ico.utensils} />
              <span data-i18n="pos.dineIn">Zalda</span>
              <svg viewBox="0 0 24 24" set:html={ico.down} />
            </span>
          </span>
          <span class="pos-icon-btn lg"><svg viewBox="0 0 24 24" set:html={ico.dots} /></span>
        </div>

        <div class="pos-sent">
          <p class="pos-sent-head"><i class="pos-check" /><span data-i18n="pos.sent3">3 ta yuborilgan mahsulot</span></p>
          <ul>
            {sent.map((l) => (
              <li>
                <i class="pos-check" />
                <span class="pos-line-name">{l.name} × {l.qty} <span data-i18n="pos.unit">dona</span></span>
                <span class="pos-line-price">{l.price}</span>
              </li>
            ))}
          </ul>
        </div>

        <ul class="pos-lines">
          {lines.map((l) => (
            <li>
              <i class="pos-check" />
              <span class="pos-line-name">{l.name}</span>
              <span class="pos-stepper">
                <span><svg viewBox="0 0 24 24" set:html={ico.minus} /></span>
                <b>{l.qty}</b>
                <span><svg viewBox="0 0 24 24" set:html={ico.plus} /></span>
              </span>
              <span class="pos-line-price">{l.price}</span>
            </li>
          ))}
        </ul>

        <span class="pos-notes" data-i18n="pos.notes">Izohlar...</span>

        <div class="pos-totals">
          <p><span data-i18n="pos.subtotal">Oraliq jami</span><span>168 000</span></p>
          <p><span data-i18n="pos.service">Xizmat 10%</span><span class="pos-plus">+&nbsp;&nbsp;16 800</span></p>
          <p class="pos-total"><span data-i18n="pos.total">Jami</span><span>184 800</span></p>
          <div class="pos-actions">
            <span class="pos-soft-btn"><svg class="pos-hold" viewBox="0 0 24 24" set:html={ico.hold} /><span data-i18n="pos.hold">Ushlab turish</span></span>
            <span class="pos-soft-btn"><svg viewBox="0 0 24 24" set:html={ico.pin} /><span data-i18n="pos.stay">Qolish</span></span>
            <span class="pos-soft-btn"><svg viewBox="0 0 24 24" set:html={ico.send} /><span data-i18n="pos.send">Jo'natish</span></span>
          </div>
          <span class="pos-accent-btn"><span data-i18n="pos.checkout">To'lov</span><kbd>F8</kbd></span>
        </div>
      </section>
    </div>

    {/* ---------- tab bar ---------- */}
    <nav class="pos-tabs">
      {tabs.map((t) => (
        <span class:list={["pos-tab", t.active && "is-active"]}>
          <span class="pos-tab-ico">
            <svg viewBox="0 0 24 24" set:html={t.i} />
            {t.badge && <i>{t.badge}</i>}
          </span>
          <span data-i18n={t.k}>{t.t}</span>
        </span>
      ))}
    </nav>
  </div>
</div>

<style>
  /* Sizing: the frame is a container; 1em = 1/80 of its width (16px at 1280). */
  .pos-hero {
    container-type: inline-size;
    overflow: hidden;
    border-radius: 12px;
  }
  @media (min-width: 768px) {
    .pos-hero {
      border-radius: 24px;
    }
  }

  /* POS light-theme tokens (computed values from the live app). */
  .pos {
    --s100: oklch(98.09% 0.013 115.83);
    --s200: oklch(96.49% 0.015 119.1);
    --s300: oklch(94.79% 0.013 115.84);
    --s400: oklch(92.97% 0.013 115.84);
    --s500: oklch(91.35% 0.015 119.12);
    --on: oklch(22.26% 0.027 133.88);
    --on2: oklch(39.23% 0.036 133.1);
    --border: oklch(56.54% 0.038 131.64);
    --accent: oklch(85.7% 0.17 134.56);
    --accent-ink: oklch(28.69% 0.0839 135.05);
    --red: oklch(50.6% 0.193 27.7);

    font-size: calc(100cqw / 80);
    aspect-ratio: 1280 / 800;
    display: grid;
    grid-template-rows: 1fr 4em;
    background: var(--s100);
    color: var(--on);
    font-family: var(--font-sans);
    line-height: 1.4;
    text-align: left;
    user-select: none;
  }
  .pos svg {
    width: 1.25em;
    height: 1.25em;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pos kbd {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: 600;
  }
  .grow {
    flex: 1;
  }
  .pos-main {
    display: grid;
    grid-template-columns: 53.8125em 1fr;
    min-height: 0;
  }

  /* ---------- catalogue ---------- */
  .pos-left {
    min-height: 0;
    overflow: hidden;
    padding: 1em 1em 0;
  }
  .pos-top {
    display: flex;
    align-items: center;
    gap: 1em;
  }
  .pos-search {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 0.5em;
    height: 2.75em;
    padding: 0 1em;
    border: max(0.0625em, 0.5px) solid var(--border);
    border-radius: 0.375em;
    background: var(--s300);
    color: var(--on2);
    font-size: 0.875em;
  }
  .pos-search svg {
    width: 1.15em;
    height: 1.15em;
  }
  .kbd-k {
    margin-left: 0.4em;
    font-size: 0.9em;
  }
  .pos-icon-btn {
    display: flex;
    width: 2.25em;
    height: 2.25em;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--s300);
  }
  .pos-icon-btn.plain {
    background: none;
  }
  .pos-icon-btn.lg {
    width: 2.75em;
    height: 2.75em;
  }
  .pos-crumbs {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.75em;
    color: var(--on2);
    font-size: 1em;
  }
  .pos-crumbs > span:first-child {
    display: flex;
    align-items: center;
    gap: 0.5em;
  }
  .pos-crumbs > span:first-child svg {
    width: 1em;
    height: 1em;
  }
  .pos-crumbs > span:first-child span:last-child {
    color: var(--on);
  }
  .pos-folders {
    display: flex;
    gap: 0.5em;
    margin-top: 0.75em;
    overflow: hidden;
    white-space: nowrap;
  }
  .pos-folder {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.5em;
    height: 2.75em;
    padding: 0 1em;
    border-radius: 999px;
    background: var(--bg);
    color: var(--fg);
    font-size: 0.875em;
    font-weight: 600;
  }
  .pos-folder.is-on {
    box-shadow: inset 0 0 0 0.125em var(--fg);
  }
  .pos-grid {
    display: grid;
    grid-template-columns: repeat(6, 8em);
    gap: 0.75em;
    margin-top: 1.25em;
  }
  .pos-tile {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 0.75em;
    background: var(--s200);
  }
  .pos-photo {
    position: relative;
    display: block;
    aspect-ratio: 1;
    background: var(--s500);
  }
  .pos-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pos-photo kbd {
    position: absolute;
    top: 0.5em;
    left: 0.5em;
    display: flex;
    width: 1.5em;
    height: 1.5em;
    align-items: center;
    justify-content: center;
    border-radius: 0.25em;
    background: var(--s300);
    color: var(--on2);
    font-size: 0.75em;
  }
  .pos-tile-info {
    display: flex;
    height: 5.1875em;
    flex-direction: column;
    align-items: flex-start;
    padding: 0.5em 0.75em 0.75em;
  }
  .pos-tile-name {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    font-size: 0.875em;
    font-weight: 500;
    line-height: 1.375;
  }
  .pos-price {
    margin-top: auto;
    color: var(--on2);
    font-size: 0.875em;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .pos-chip {
    margin-top: auto;
    border-radius: 999px;
    background: var(--s400);
    padding: 0.125em 0.5em;
    color: var(--on2);
    font-size: 0.75em;
    font-weight: 500;
  }

  /* ---------- order panel ---------- */
  .pos-right {
    display: flex;
    min-height: 0;
    flex-direction: column;
    padding: 1em 1em 0;
    border-left: max(0.0625em, 0.5px) solid var(--s300);
    background: var(--s200);
  }
  .pos-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5em;
  }
  .pos-title {
    display: block;
    font-size: 1.125em;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .pos-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    height: 2.25em;
    margin-top: 0.125em;
    padding: 0 0.75em;
    border-radius: 999px;
    background: var(--s300);
    font-size: 0.875em;
    font-weight: 500;
  }
  .pos-pill svg {
    width: 1.15em;
    height: 1.15em;
  }
  .pos-check {
    display: block;
    width: 1em;
    height: 1em;
    flex-shrink: 0;
    border: 0.1em solid var(--on2);
    border-radius: 0.25em;
  }
  .pos-sent {
    margin-top: 0.75em;
    border-radius: 0.5em;
    background: var(--s100);
    font-size: 0.875em;
  }
  .pos-sent-head {
    display: flex;
    align-items: center;
    gap: 0.75em;
    height: 3em;
    padding: 0 0.85em;
    border-bottom: max(0.0625em, 0.5px) solid var(--s300);
    font-weight: 500;
  }
  .pos-sent ul {
    padding: 0.3em 0;
  }
  .pos-sent li {
    display: flex;
    align-items: center;
    gap: 0.75em;
    height: 2.3em;
    padding: 0 0.85em;
  }
  .pos-lines {
    display: flex;
    flex-direction: column;
    gap: 0.375em;
    margin-top: 0.5em;
  }
  .pos-lines li {
    display: flex;
    align-items: center;
    gap: 0.75em;
    height: 3.5em;
    padding: 0 0.75em;
    border-radius: 0.5em;
    background: var(--s100);
  }
  .pos-lines .pos-check {
    width: 1.15em;
    height: 1.15em;
  }
  .pos-line-name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pos-lines .pos-line-name {
    font-weight: 500;
  }
  .pos-stepper {
    display: flex;
    align-items: center;
  }
  .pos-stepper span {
    display: flex;
    width: 2.25em;
    height: 2.25em;
    align-items: center;
    justify-content: center;
    border-radius: 0.375em;
    background: var(--s300);
  }
