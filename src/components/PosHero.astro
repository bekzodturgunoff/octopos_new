---
/**
 * RestaurantPOS order screen, rebuilt in HTML for the hero.
 *
 * A faithful copy of the shipped screen (kdsx-pos-v2: home route, 1280×800
 * tablet layout): search bar, menu breadcrumb, numbered product tiles with
 * variant chips, the order panel (Yangi savdo · Joyida · Jo'natish, lines with
 * steppers, notes, subtotal / service / total, To'lov F8) and the six-tab bar.
 * Colours are the POS surface tokens read from the live app; it follows the
 * site theme like the real app does.
 * Labels use the POS's own translations (kdsx-pos-v2/public/locales). Product
 * names are catalogue data and stay as they are; the menu folder and service
 * charge are translated so each language page reads as one restaurant.
 *
 * Scales as one piece: 1em = 16px at the 1280px design width, driven by the
 * container width. On narrow screens it crops to the right-hand side (last tile
 * column + order panel) so the text stays readable.
 */
const tiles = [
  { n: 1, name: "Limonad Ocean", src: "/mock/pos/drink1.webp" },
  { n: 2, name: "Limonad Klubnika", src: "/mock/pos/drink2.webp" },
  { n: 3, name: "Limonad Malina", src: "/mock/pos/drink3.webp" },
  { n: 4, name: "Limonad Mojito", src: "/mock/pos/drink4.webp" },
  { n: 5, name: "Limonad Anor", src: "/mock/pos/drink5.webp" },
  { n: 6, name: "Limonad Apelsin", src: "/mock/pos/drink6.webp" },
];
const lines = [
  { name: "Limonad Ocean: 0,7", qty: 1, price: "25 000" },
  { name: "Limonad Klubnika: 0,5", qty: 1, price: "20 000" },
  { name: "Limonad Malina: 0,5", qty: 1, price: "20 000" },
];
const tabs = [
  { k: "pos.tabLock", t: "Qulflash", i: '<rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>' },
  { k: "pos.tabFloor", t: "Zal", i: '<path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>' },
  { k: "pos.tabHome", t: "Uy", i: '<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>', active: true },
  { k: "pos.tabOrders", t: "Buyurtma", i: '<path d="M3 12h.01"/><path d="M3 18h.01"/><path d="M3 6h.01"/><path d="M8 12h13"/><path d="M8 18h13"/><path d="M8 6h13"/>' },
  { k: "pos.tabInbox", t: "Xabarlar", i: '<path d="M10.268 21a2 2 0 0 0 3.464 0"/><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"/>', badge: "3" },
  { k: "pos.tabMore", t: "Boshqa", i: '<path d="M4 12h16"/><path d="M4 18h16"/><path d="M4 6h16"/>' },
];
const ico = {
  back: '<path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>',
  search: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
  scan: '<path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><path d="M8 7v10"/><path d="M12 7v10"/><path d="M17 7v10"/>',
  chevron: '<path d="m9 18 6-6-6-6"/>',
  down: '<path d="m6 9 6 6 6-6"/>',
  columns: '<rect width="6" height="16" x="4" y="4" rx="1"/><rect width="6" height="16" x="14" y="4" rx="1"/>',
  utensils: '<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 3 2h3Zm0 0v7"/>',
  dots: '<circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/>',
  minus: '<path d="M5 12h14"/>',
  plus: '<path d="M5 12h14"/><path d="M12 5v14"/>',
};
---

<div class="pos-hero" role="img" aria-label="RestaurantPOS — buyurtma ekrani" data-i18n-attr="aria-label:pos.alt">
  <div class="pos" aria-hidden="true">
    <div class="pos-main">
      {/* ---------- catalogue ---------- */}
      <section class="pos-left">
        <div class="pos-top">
          <span class="pos-icon-btn plain"><svg viewBox="0 0 24 24" set:html={ico.back} /></span>
          <span class="pos-search">
            <svg viewBox="0 0 24 24" set:html={ico.search} />
            <span class="grow" data-i18n="pos.search">Mahsulotlarni qidirish</span>
            <svg viewBox="0 0 24 24" set:html={ico.scan} />
            <span class="kbd-k">⌘ K</span>
          </span>
        </div>
        <div class="pos-crumbs">
          <span><span data-i18n="pos.menu">Menyu</span><svg viewBox="0 0 24 24" set:html={ico.chevron} /><span data-i18n="pos.drinks">Ichimliklar</span></span>
          <span class="pos-icon-btn"><svg viewBox="0 0 24 24" set:html={ico.columns} /></span>
        </div>
        <ul class="pos-grid">
          {tiles.map((t, i) => (
            <li class="pos-tile">
              <span class="pos-photo">
                <img src={t.src} alt="" width="400" height="400" loading={i < 3 ? "eager" : "lazy"} decoding="async" fetchpriority={i < 3 ? "high" : "auto"} />
                <kbd>{t.n}</kbd>
              </span>
              <span class="pos-tile-info">
                <span class="pos-tile-name">{t.name}</span>
                <span class="pos-chip" data-i18n="pos.variants3">3 ta variant</span>
              </span>
            </li>
          ))}
        </ul>
      </section>

      {/* ---------- order panel ---------- */}
      <section class="pos-right">
        <div class="pos-head">
          <span class="min-w-0">
            <span class="pos-title" data-i18n="pos.newSale">Yangi savdo</span>
            <span class="pos-pill">
              <svg viewBox="0 0 24 24" set:html={ico.utensils} />
              <span data-i18n="pos.dineIn">Zalda</span>
              <svg viewBox="0 0 24 24" set:html={ico.down} />
            </span>
          </span>
          <span class="pos-head-actions">
            <span class="pos-icon-btn lg"><svg viewBox="0 0 24 24" set:html={ico.dots} /></span>
            <span class="pos-accent-btn"><span data-i18n="pos.send">Jo'natish</span><kbd>Enter</kbd></span>
          </span>
        </div>

        <ul class="pos-lines">
          {lines.map((l) => (
            <li>
              <span class="pos-line-name">{l.name}</span>
              <span class="pos-stepper">
                <span><svg viewBox="0 0 24 24" set:html={ico.minus} /></span>
                <b>{l.qty}</b>
                <span><svg viewBox="0 0 24 24" set:html={ico.plus} /></span>
              </span>
              <span class="pos-line-price">{l.price}</span>
            </li>
          ))}
        </ul>

        <span class="pos-notes" data-i18n="pos.notes">Izohlar...</span>

        <div class="pos-totals">
          <p><span data-i18n="pos.subtotal">Oraliq jami</span><span>65 000</span></p>
          <p><span data-i18n="pos.service">Xizmat 10%</span><span class="pos-plus">+&nbsp;&nbsp;6 500</span></p>
          <p class="pos-total"><span data-i18n="pos.total">Jami</span><span>71 500</span></p>
          <span class="pos-accent-btn wide"><span data-i18n="pos.checkout">To'lov</span><kbd>F8</kbd></span>
        </div>
      </section>
    </div>

    {/* ---------- tab bar ---------- */}
    <nav class="pos-tabs">
      {tabs.map((t) => (
        <span class:list={["pos-tab", t.active && "is-active"]}>
          <span class="pos-tab-ico">
            <svg viewBox="0 0 24 24" set:html={t.i} />
            {t.badge && <i>{t.badge}</i>}
          </span>
          <span data-i18n={t.k}>{t.t}</span>
        </span>
      ))}
    </nav>
  </div>
</div>

<style>
  /* Sizing: the frame is a container; 1em = 1/80 of the mock's width (16px at 1280). */
  .pos-hero {
    container-type: inline-size;
    overflow: hidden;
    border-radius: 16px;
    --mock-w: 180; /* % of the frame the mock spans: crops to the right part on phones */
  }
  @media (min-width: 768px) {
    .pos-hero {
      --mock-w: 100;
      border-radius: 24px;
    }
  }

  /* POS light-theme surface tokens (values read from the live app). */
  .pos {
    --s100: oklch(98.09% 0.013 115.83);
    --s200: oklch(96.49% 0.015 119.1);
    --s300: oklch(94.79% 0.013 115.84);
    --s500: oklch(91.35% 0.015 119.12);
    --on: oklch(22.26% 0.027 133.88);
    --on2: oklch(39.23% 0.036 133.1);
    --border: oklch(56.54% 0.038 131.64);
    --accent: oklch(85.7% 0.17 134.56);
    --accent-ink: oklch(28.69% 0.0839 135.05);
    --active: oklch(28.69% 0.0839 135.05);
    --plus: var(--on);

    width: calc(var(--mock-w) * 1%);
    margin-left: calc((100 - var(--mock-w)) * 1%);
    font-size: calc(var(--mock-w) * 1cqw / 80);
    aspect-ratio: 1280 / 800;
    display: grid;
    grid-template-rows: 1fr 4em;
    background: var(--s100);
    color: var(--on);
    font-family: var(--font-sans);
    line-height: 1.5;
    text-align: left;
    user-select: none;
  }
  /* POS dark-theme tokens (read from the live app). The dark screen sits on a
   * dark band, so the frame gets a 1px edge in this theme only. */
  :global(:root[data-theme="dark"]) .pos-hero {
    box-shadow: 0 0 0 1px oklch(34% 0.012 137);
  }
  :global(:root[data-theme="dark"]) .pos {
    --s100: oklch(19.09% 0.009 137.85);
    --s200: oklch(20.86% 0.009 137.84);
    --s300: oklch(23.89% 0.009 137.83);
    --s500: oklch(27.1% 0.011 139.43);
    --on: oklch(91.24% 0.03 125.98);
    --on2: oklch(82.4% 0.04 129.72);
    --border: oklch(37.54% 0.023 135.14);
    --active: var(--accent);
    --plus: var(--accent);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .pos-hero {
      box-shadow: 0 0 0 1px oklch(34% 0.012 137);
    }
    :global(:root:not([data-theme="light"])) .pos {
      --s100: oklch(19.09% 0.009 137.85);
      --s200: oklch(20.86% 0.009 137.84);
      --s300: oklch(23.89% 0.009 137.83);
      --s500: oklch(27.1% 0.011 139.43);
      --on: oklch(91.24% 0.03 125.98);
      --on2: oklch(82.4% 0.04 129.72);
      --border: oklch(37.54% 0.023 135.14);
      --active: var(--accent);
      --plus: var(--accent);
    }
  }
  .pos svg {
    width: 1.25em;
    height: 1.25em;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pos kbd {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75em;
    font-weight: 600;
  }
  .grow {
    flex: 1;
  }

  .pos-main {
    display: grid;
    grid-template-columns: 53.8125em 1fr;
    min-height: 0;
  }

  /* catalogue */
  .pos-left {
    padding: 1em 1em 0;
    overflow: hidden;
    min-height: 0;
  }
  .pos-top {
    display: flex;
    align-items: center;
    gap: 1em;
  }
  .pos-search {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 0.75em;
    height: 2.75em;
    padding: 0 1em 0 0.75em;
    border: 1px solid var(--border);
    border-radius: 0.375em;
    background: var(--s300);
    color: var(--on2);
    font-size: 0.875em;
  }
  .pos-search svg {
    width: 1.3em;
    height: 1.3em;
  }
  .kbd-k {
    font-size: 0.95em;
  }
  .pos-crumbs {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.875em;
    padding-left: 0;
    color: var(--on2);
    font-weight: 500;
  }
  .pos-crumbs > span:first-child {
    display: flex;
    align-items: center;
    gap: 0.5em;
  }
  .pos-crumbs > span:first-child svg {
    width: 1em;
    height: 1em;
  }
  .pos-icon-btn {
    display: flex;
    width: 2.5em;
    height: 2.5em;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--s300);
    color: var(--on);
  }
  .pos-icon-btn.plain {
    background: none;
  }
  .pos-icon-btn.lg {
    width: 2.75em;
    height: 2.75em;
  }
  .pos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1em;
    margin-top: 1.25em;
  }
  .pos-tile {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 0.75em;
    background: var(--s200);
  }
  .pos-photo {
    position: relative;
    display: block;
    aspect-ratio: 1;
    background: var(--s500);
  }
  .pos-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pos-photo kbd {
    position: absolute;
    top: 0.5em;
    left: 0.5em;
    display: flex;
    width: 2em;
    height: 2em;
    align-items: center;
    justify-content: center;
    border-radius: 0.333em;
    background: var(--s300);
    color: var(--on2);
  }
  .pos-tile-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.375em;
    padding: 0.625em 0.75em 0.75em;
  }
  .pos-tile-name {
    font-weight: 500;
  }
  .pos-chip {
    border-radius: 999px;
    background: var(--s300);
    padding: 0 0.6em;
    color: var(--on2);
    font-size: 0.875em;
  }

  /* order panel */
  .pos-right {
    display: flex;
    flex-direction: column;
    min-height: 0;
    padding: 1em 1em 0;
    border-left: 1px solid var(--s300);
  }
  .pos-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5em;
  }
  .pos-title {
    display: block;
    font-size: 1.125em;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .pos-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    height: 2.25em;
    margin-top: 0.125em;
    padding: 0 0.75em;
    border-radius: 999px;
    background: var(--s200);
    font-weight: 500;
  }
  .pos-pill svg {
    width: 1.1em;
    height: 1.1em;
  }
  .pos-head-actions {
    display: flex;
    align-items: center;
    gap: 0.5em;
  }
  .pos-accent-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
    height: 2.75em;
    padding: 0 1em;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 0.875em;
    font-weight: 600;
    white-space: nowrap;
  }
  .pos-accent-btn kbd {
    border-radius: 0.25em;
    background: rgba(0, 0, 0, 0.1);
    padding: 0.1em 0.45em;
    font-size: 0.857em;
  }
  .pos-accent-btn.wide {
    display: flex;
    width: 100%;
    height: 3.14em;
    margin-top: 0.857em;
  }
  .pos-lines {
    display: flex;
    flex-direction: column;
    gap: 0.25em;
    margin-top: 0.875em;
  }
  .pos-lines li {
    display: flex;
    align-items: center;
    gap: 0.75em;
    height: 3.5em;
    padding: 0 0.75em;
    border-radius: 0.5em;
    background: var(--s200);
  }
  .pos-line-name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pos-stepper {
    display: flex;
    align-items: center;
  }
  .pos-stepper span {
    display: flex;
    width: 2.25em;
    height: 2.25em;
    align-items: center;
    justify-content: center;
    border-radius: 0.375em;
    background: var(--s300);
  }
  .pos-stepper svg {
    width: 1em;
    height: 1em;
  }
  .pos-stepper b {
    width: 2.25em;
    text-align: center;
    font-weight: 500;
  }
  .pos-line-price {
    min-width: 3.75em;
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .pos-notes {
    display: flex;
    align-items: center;
    height: 2.375em;
    margin-top: auto;
    padding: 0 0.75em;
    border: 1px solid var(--border);
    border-radius: 0.375em;
    background: var(--s300);
    color: var(--on2);
    font-size: 0.875em;
  }
  .pos-totals {
    margin: 1em -1em 0;
    padding: 1em 1em 1em;
    background: var(--s200);
    font-size: 0.875em;
  }
  .pos-totals p {
    display: flex;
    justify-content: space-between;
    padding: 0.1em 0;
    color: var(--on2);
    font-variant-numeric: tabular-nums;
  }
  .pos-totals p span:last-child {
    color: var(--on);
  }
  .pos-totals .pos-plus {
    color: var(--plus) !important;
  }
  .pos-total {
    font-weight: 600;
  }
  .pos-total span {
    color: var(--on) !important;
  }

  /* tab bar */
  .pos-tabs {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    align-items: center;
    background: var(--s200);
  }
  .pos-tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2em;
    font-size: 0.875em;
    line-height: 1.2;
  }
  .pos-tab.is-active {
    color: var(--active);
  }
  .pos-tab-ico {
    position: relative;
  }
  .pos-tab-ico svg {
    width: 1.43em;
    height: 1.43em;
  }
  .pos-tab-ico i {
    position: absolute;
    top: -0.35em;
    right: -0.6em;
    display: flex;
    min-width: 1.35em;
    height: 1.35em;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: oklch(50.6% 0.193 27.7);
    color: #fff;
    font-size: 0.7em;
    font-style: normal;
    font-weight: 600;
  }
</style>
