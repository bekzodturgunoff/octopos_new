---
/**
 * Privacy policy / terms of service. Text lives in src/data/legal.ts; the
 * Uzbek version renders here and the build (i18n-static) writes the other
 * languages from the data-i18n keys, like every other page.
 */
import Layout from "../layouts/Layout.astro";
import TopNav from "./TopNav.astro";
import Footer from "./Footer.astro";
import { LEGAL, LEGAL_SECTIONS } from "../data/legal";

interface Props {
  page: "privacy" | "terms";
}
const { page } = Astro.props;
const k = (s: string) => `legal.${page}.${s}`;
const uz = (s: string) => LEGAL[k(s)]?.uz ?? "";
const n = LEGAL_SECTIONS[page];
---

<Layout title={`${uz("title")} — Octopos`} description={uz("intro").slice(0, 155)}>
  <TopNav />
  <main>
    <article class="wrap max-w-[820px] py-14 lg:py-20">
      <h1 class="display display-2" data-i18n={k("heading")}>{uz("heading")}</h1>
      <p class="mt-3 font-geist text-[14px] text-muted" data-i18n={k("effective")}>{uz("effective")}</p>
      <p class="mt-6 font-geist text-[17px] leading-[1.65] text-ink/90" data-i18n={k("intro")}>{uz("intro")}</p>
      <div class="mt-10 flex flex-col gap-8">
        {
          Array.from({ length: n }, (_, i) => i + 1).map((i) => (
            <section>
              <h2 class="font-geist text-[20px] leading-[1.3] font-semibold" data-i18n={k(`s${i}t`)}>{uz(`s${i}t`)}</h2>
              <p class="mt-2 font-geist text-[16px] leading-[1.7] text-ink/85" data-i18n={k(`s${i}b`)}>{uz(`s${i}b`)}</p>
            </section>
          ))
        }
      </div>
    </article>
  </main>
  <Footer />
</Layout>
