---
interface Props {
  slug: string;
  class?: string;
}

const { slug, class: cls = "h-5 w-5" } = Astro.props;

const icons: Record<string, string> = {
  "pos-restaurant":
    '<path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"/><path d="M9 8h6M9 12h6M9 16h3"/>',
  "pos-market":
    '<path d="M4 9h16l-1.3 10.2a2 2 0 0 1-2 1.8H7.3a2 2 0 0 1-2-1.8z"/><path d="M8.5 9V7.5a3.5 3.5 0 0 1 7 0V9"/>',
  dash: '<path d="M4 4v16h16"/><path d="M8 16v-4M12 16V8M16 16v-7"/>',
  kitchen: '<path d="M4 15a8 8 0 0 1 16 0"/><path d="M3 15h18"/><path d="M12 7V5"/>',
  ods: '<rect x="3" y="5" width="18" height="12" rx="2"/><path d="M9 21h6M12 17v4"/>',
  guest:
    '<rect x="6" y="3" width="12" height="18" rx="2"/><path d="M9 7h2v2H9zM13 7h2v2h-2zM9 13h2v2H9zM13 13h2v2h-2z"/>',
  website:
    '<path d="M4 10h16l-1-5H5z"/><path d="M5 10v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-9"/><path d="M9 20v-5h6v5"/>',
  dispatch:
    '<path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v4h-7z"/><circle cx="7" cy="18" r="1.5"/><circle cx="17" cy="18" r="1.5"/>',
};
---

<svg
  class={cls}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={icons[slug] ?? icons.dash}
/>
