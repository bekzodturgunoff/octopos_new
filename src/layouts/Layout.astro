---
import "../styles/global.css";
import WizardForm from "../components/WizardForm.astro";
import Analytics from "../components/Analytics.astro";

interface Props {
  title: string;
  description?: string;
  jsonLd?: Record<string, unknown>[];
  preloadImage?: { href: string; srcset?: string; sizes?: string };
  ogImage?: string;
  /** Keep the page out of search results and the sitemap. */
  noindex?: boolean;
  /** The page's language when it is built directly in it (solution pages). */
  lang?: string;
  /** Language versions with their own URLs (solution pages). Pages without
   * this get the standard set from the i18n-static build step. */
  alternates?: { lang: string; href: string }[];
}

const { title, description, jsonLd, preloadImage, ogImage, noindex, lang = "uz", alternates } = Astro.props;
// Share image: 1200×630 cards in /og/ (scripts/og.mjs); the build swaps the
// home card for each language's own (i18n-static).
const og = new URL(ogImage ?? "/og/home-uz.png", Astro.site ?? "https://octopos.uz").toString();
const ogIsCard = og.includes("/og/");
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const ld = (node: Record<string, unknown>) =>
  JSON.stringify(node).replace(/<\//g, "<\\/");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://api.octopos.uz" />
    <link rel="preload" href="/fonts/Inter-var-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="oklch(98.09% 0.013 115.83)" />
    <meta name="color-scheme" content="light" />
    <script is:inline>
      ;(function () {
        try {
          var stored;
          try {
            stored = localStorage.getItem("theme");
          } catch (_) {}
          var explicit = stored === "dark" || stored === "light";
          var sync = function (resolved) {
            document.documentElement.setAttribute("data-theme", resolved);
            document.documentElement.style.colorScheme = resolved;
            var meta = document.querySelector('meta[name="theme-color"]');
            if (meta)
              meta.setAttribute(
                "content",
                resolved === "dark"
                  ? "oklch(19.09% 0.009 137.85)"
                  : "oklch(98.09% 0.013 115.83)",
              );
            var cs = document.querySelector('meta[name="color-scheme"]');
            if (cs) cs.setAttribute("content", resolved);
          };
          var mq = window.matchMedia("(prefers-color-scheme: dark)");
          if (explicit) {
            sync(stored);
          } else {
            sync(mq.matches ? "dark" : "light");
            mq.addEventListener("change", function (e) {
              sync(e.matches ? "dark" : "light");
            });
          }
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {/* Search Console: verified by the file public/googled1e706eaf11c4850.html; a meta code can be added via env. */}
    {import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION} />}
    {/* Yandex Webmaster: the code octopos.uz is already verified with (env var can override). */}
    <meta name="yandex-verification" content={import.meta.env.PUBLIC_YANDEX_VERIFICATION || "6b8a1f9f108bb1c4"} />
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Octopos" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={og} />
    {ogIsCard && <meta property="og:image:width" content="1200" />}
    {ogIsCard && <meta property="og:image:height" content="630" />}
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="shortcut icon" href="/favicon.ico" />
    {preloadImage && (
      <link
        rel="preload"
        as="image"
        href={preloadImage.href}
        imagesrcset={preloadImage.srcset}
        imagesizes={preloadImage.sizes}
        fetchpriority="high"
      />
    )}
    {alternates?.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {jsonLd?.map((node) => (
      <script is:inline type="application/ld+json" set:html={ld(node)} />
    ))}
    <Analytics />
  </head>
  <body class="font-geist text-ink antialiased">
    <slot />
    <WizardForm />
  </body>
</html>
