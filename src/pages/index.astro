  <script>
    import { STRINGS, getLang, type Lang } from "../data/i18n";

    const API = "https://api.octopos.uz";
    const grid = document.getElementById("plans-grid");
    const loading = document.getElementById("plans-loading");
    const cycleBtns = document.querySelectorAll<HTMLElement>("[data-cycle]");

    const UZ: Record<string, string> = {
      "plans.monthly": "Oylik",
      "plans.yearly": "Yillik",
      "plans.saveNote": "Yillik to'lov · 10% tejash",
      "plans.startFree": "Bepul boshlash",
      "plans.getStarted": "Boshlash",
      "plans.popular": "Eng mashhur",
      "plans.noCard": "Karta talab qilinmaydi",
      "plans.perMonth": "/oy",
      "plans.perYear": "/yil",
      "plans.loading": "Yuklanmoqda…",
    };

    let cycle: "monthly" | "yearly" = "monthly";
    let plans: any[] = [];
    let fetchedFor = "";

    const L = (k: string, lang: string): string =>
      lang === "uz"
        ? (UZ[k] ?? "")
        : (STRINGS[k]?.[lang as Lang] ?? UZ[k] ?? "");

    const esc = (s: unknown): string =>
      String(s ?? "").replace(
        /[&<>"]/g,
        (c) =>
          ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c] as string,
      );

    function card(plan: any, lang: string): string {
      const popular = plan.name === "Growth" || plan.position === 3;
      const price =
        (plan.prices ?? []).find((p: any) => p.billingCycle === cycle) ??
        plan.prices?.[0];
      const amount = price?.value?.majorAmount ?? 0;
      const suffix =
        cycle === "monthly"
          ? L("plans.perMonth", lang)
          : L("plans.perYear", lang);
      const display = amount === 0 ? "$0" : (price?.value?.display ?? "$0");
      const note =
        amount === 0
          ? `<p class="mt-2 text-[12.5px] text-muted">${esc(L("plans.noCard", lang))}</p>`
          : cycle === "yearly"
            ? `<p class="mt-2 font-geist-mono text-[11px] tracking-[0.72px] text-muted">${esc(L("plans.saveNote", lang))}</p>`
            : "";
      const cta =
        amount === 0 ? L("plans.startFree", lang) : L("plans.getStarted", lang);
      const feats = (plan.features ?? [])
        .map((f: any) => {
          const showDesc =
            f.description && /\d|unlimited|up to|max/i.test(f.description);
          return `<li class="flex items-start gap-2.5"><svg class="mt-[3px] h-3.5 w-3.5 shrink-0 text-ink" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="text-[13.5px] leading-[20px]"><span class="font-medium text-ink">${esc(f.name)}</span>${showDesc ? ` <span class="text-muted">${esc(f.description)}</span>` : ""}</span></li>`;
        })
        .join("");
      return `<div class="relative flex flex-col gap-4 rounded-2xl border border-hairline bg-card/40 p-6 ${popular ? "ring-2 ring-accent-surface" : ""}">
        ${popular ? `<span class="absolute -top-3 left-6 rounded-full bg-accent-surface px-3 py-1 font-geist-mono text-[10px] tracking-[0.72px] text-on-accent-surface">${esc(L("plans.popular", lang))}</span>` : ""}
        <p class="font-geist text-[15px] font-medium text-ink">${esc(plan.name)}</p>
        <div>
          <p class="flex items-baseline gap-1.5"><span class="font-anton text-[42px] leading-none tracking-tight text-ink">${esc(display)}</span><span class="font-geist-mono text-[12px] tracking-[0.72px] text-muted">${esc(suffix)}</span></p>
          ${note}
        </div>
        <ul class="flex flex-col gap-2.5">${feats}</ul>
        <button type="button" data-plan-trigger="starter" class="mt-auto flex h-[42px] items-center justify-center rounded-[99px] ${popular ? "bg-accent-surface text-on-accent-surface hover:bg-accent-active hover:text-accent-emphasis" : "border border-hairline text-ink hover:border-link hover:text-link"} font-geist-mono text-[12px] font-medium tracking-[0.72px] transition-colors duration-[300ms]">${esc(cta)}</button>
      </div>`;
    }

    function render(lang: string): void {
      if (!grid) return;
      grid.innerHTML = plans.map((p) => card(p, lang)).join("");
    }

    async function load(): Promise<void> {
      const lang = getLang();
      const apiLang = lang === "tr" ? "en" : lang;
      if (fetchedFor !== apiLang) {
        loading?.classList.remove("hidden");
        try {
          const r = await fetch(`${API}/plans.get?lang=${apiLang}`, {
            cache: "no-store",
            headers: { "Accept-Language": apiLang },
          });
          const j: any = await r.json();
          plans = j.plans ?? [];
          fetchedFor = apiLang;
        } catch {
          plans = [];
        }
        loading?.classList.add("hidden");
      }
      render(lang);
    }

    cycleBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        cycle = btn.getAttribute("data-cycle") as "monthly" | "yearly";
        cycleBtns.forEach((x) => {
          const on = x.getAttribute("data-cycle") === cycle;
          x.classList.toggle("bg-ink", on);
          x.classList.toggle("text-on-ink", on);
          x.classList.toggle("text-muted", !on);
        });
        render(getLang());
      });
    });

    document.addEventListener("langchange", () => void load());
    void load();
  </script>
