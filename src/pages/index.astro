---
import Layout from "../layouts/Layout.astro";
import TopNav from "../components/TopNav.astro";
import AgentDownload from "../components/AgentDownload.astro";
import { apps, imagesFor } from "../data/apps";
import AppIcon from "../components/AppIcon.astro";
import logoLight from "../assets/logo_light.png";
import logoDark from "../assets/logo_dark.png";
import { has } from "../data/i18n";

const heroImg = imagesFor("pos-restaurant")[0];

const radOffsets = [37, 42, 33.5, 40, 35, 42.5, 34, 41];
const angJitter = [0, -6, 5, -4, 7, -5, 4, -6];
const hOffsets = [-6, -4.5, -4.5, -4, 0, 4, 4.5, 4.5];

const ring = apps.map((app, i) => {
  const ang = ((i * 45 - 90 + angJitter[i]) * Math.PI) / 180;
  const rad = radOffsets[i];
  return {
    app,
    x: 50 - rad * Math.cos(ang) + hOffsets[i],
    y: 50 + rad * Math.sin(ang),
  };
});

const mobileShift = [
  "-translate-y-[calc(50%_+_7px)] sm:-translate-y-1/2",
  "-translate-y-[calc(50%_+_7px)] sm:-translate-y-1/2",
  "-translate-y-1/2",
  "-translate-y-[calc(50%_-_7px)] sm:-translate-y-1/2",
  "-translate-y-[calc(50%_-_7px)] sm:-translate-y-1/2",
  "-translate-y-[calc(50%_-_7px)] sm:-translate-y-1/2",
  "-translate-y-1/2",
  "-translate-y-[calc(50%_+_7px)] sm:-translate-y-1/2",
];

const tentacles = ring.map(({ x: ox, y: oy }, i) => {
  const dx = ox - 50;
  const dy = oy - 50;
  const dist = Math.hypot(dx, dy) || 1;
  const ux = dx / dist;
  const uy = dy / dist;
  const ix = 50 + 8 * ux;
  const iy = 50 + 8 * uy;
  const px = -uy;
  const py = ux;
  const dir = i % 2 === 0 ? 1 : -1;
  const amp = 1.9 + (i % 3) * 0.3;
  const cycles = 1;
  const N = 20;
  const pts = [];
  for (let s = 0; s <= N; s++) {
    const t = s / N;
    const off = dir * amp * Math.sin(t * Math.PI * 2 * cycles);
    pts.push({
      x: ix + (ox - ix) * t + px * off,
      y: iy + (oy - iy) * t + py * off,
      t,
    });
  }
  return pts.slice(0, N).map((p, s) => {
    const tMid = (p.t + pts[s + 1].t) / 2;
    return {
      d: `M ${p.x.toFixed(2)} ${p.y.toFixed(2)} L ${pts[s + 1].x.toFixed(2)} ${pts[s + 1].y.toFixed(2)}`,
      w: (1.2 + 4 * Math.pow(1 - tMid, 1.8)).toFixed(2),
    };
  });
});

const storeTiers = [
  { name: "Start", price: "790 000", n: 1000 },
  { name: "Pro", price: "2 190 000", n: 3000 },
  { name: "Business", price: "3 990 000", n: 6000 },
  { name: "Enterprise", price: "7 490 000", n: 10000 },
];
const photoTiers = [
  { n: 200, price: "149 000" },
  { n: 600, price: "349 000" },
  { n: 1500, price: "690 000" },
];

const solutions = [
  {
    uzT: "Restoran va kafelar",
    kT: "sol.1t",
    uzD:
      "Zal, stol rejasi, QR menyu, oshxona ekrani va kuryer — buyurtma stoldan hisobotgacha to'liq tsikl.",
    kD: "sol.1d",
    tags: "POS · QR menyu · KDS · ODS",
  },
  {
    uzT: "Market va do'konlar",
    kT: "sol.2t",
    uzD:
      "Barkod, tort, ombor qoldig'i, to'lov va kassa hisobotlari — savdo sig'imi bilan ishlash uchun.",
    kD: "sol.2d",
    tags: "POS · Ombor · Kassa",
  },
  {
    uzT: "Onlayn buyurtmalar",
    kT: "sol.3t",
    uzD:
      "Veb-do'kon, Telegram va aggregatorlar (Yandex Eats, Uzum Tezkor) — barchasi bitta kassaga.",
    kD: "sol.3d",
    tags: "Veb-do'kon · Telegram · Aggregator",
  },
  {
    uzT: "O'z yetkazib berish",
    kT: "sol.4t",
    uzD:
      "Dispetcher paneli, Telegram orqali kuryerlar, jonli xarita va cheksiz kuryerlar soni.",
    kD: "sol.4d",
    tags: "Dispetcher · GPS · Telegram",
  },
];

const restaurantLogos = [
  "baba-food",
  "bonet",
  "caffe_vero",
  "family-cafe",
  "feruz_burger",
  "holland-fries",
  "imron-cafe",
  "mantidee",
  "street-food",
  "sushi_nebo",
  "sushi_panda",
  "tandir",
  "tochka-burger",
  "uch-qozon",
  "waffle&co",
];

const payLogos = [
  { src: "/payments/payme.webp", alt: "Payme" },
  { src: "/payments/click.webp", alt: "Click" },
  { src: "/payments/dodo-payments.webp", alt: "Dodo Payments" },
  { src: "/integrations/telegram.webp", alt: "Telegram" },
  { src: "/integrations/uzum-tezkor.webp", alt: "Uzum Tezkor" },
  { src: "/integrations/yandex-eats.webp", alt: "Yandex Eats" },
  { src: "/integrations/yandex-go.webp", alt: "Yandex Go" },
];
---

<Layout
  title="Octopos — Bitta platforma, sakkizta ilova"
  description="POS, KDS, dashbord, QR menyu, veb-do'kon va kuryer dispetcheri — bitta obuna, bitta ma'lumot manbasi. O'zbekistonda restoranlar uchun to'liq tizim."
>
  <TopNav />

  <main>
    {/* ---------------- hero ---------------- */}
    <section class="px-5 pt-[22px] pb-[28px] lg:px-[32px] lg:pt-[68px] lg:pb-[72px]">
      <div class="mx-auto max-w-[1600px]">

        <h1
          class="max-w-[1200px] font-anton text-[clamp(40px,11vw,64px)] leading-[1.03] tracking-[-0.69px] [hyphens:auto] [-webkit-hyphens:auto] [overflow-wrap:anywhere] lg:text-[138px]"
          data-i18n="hero.title"
        >
          Eng zo'rini ishlating, boshliq!
        </h1>

        <div
          class="mt-10 flex flex-col items-start gap-7 lg:flex-row lg:items-end lg:justify-between lg:gap-16"
        >
          <p
            class="max-w-[600px] font-geist text-[20px] leading-[30px] text-muted"
            data-i18n="hero.body"
          >
            POS, KDS, dashbord, QR menyu, veb-do'kon va kuryer dispetcheri —
            bitta obuna, bitta ma'lumot manbasi. Internet uzilsa ham ishlashda
            davom etadi.
          </p>
          <div class="flex shrink-0 flex-col items-start gap-4 lg:items-end">
            <button
              type="button"
              data-plan-trigger="starter"
              class="flex h-[48px] items-center justify-center rounded-[99px] bg-accent px-7 font-geist-mono text-[12px] font-medium tracking-[0.72px] text-accent-emphasis transition-colors duration-[350ms] ease-far hover:bg-accent-active"
            >
              <span data-i18n="hero.cta">Bepul sinab ko'rish →</span>
            </button>
            <p
              class="rounded-full border border-hairline bg-card/60 px-4 py-1.5 text-center font-geist-mono text-[11px] leading-4 tracking-[0.72px] text-muted"
              data-i18n="hero.trust"
            >
              ✓ Karta talab qilinmaydi · ✓ Bugun ishga tushadi · ✓ Oflayn
              ishlaydi
            </p>
          </div>
        </div>

        <div class="mt-10 overflow-hidden rounded-2xl bg-card">
          {
            heroImg ? (
              <img
                src={heroImg}
                alt="OctoPos — restoran POS ekrani"
                class="block -mt-[3px] w-full h-auto"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            ) : (
              <span class="flex h-[320px] items-center justify-center font-geist-mono text-[12px] tracking-[0.72px] text-muted">
                Rasmlar tez orada
              </span>
            )
          }
        </div>
      </div>
    </section>

    {/* ---------------- apps ---------------- */}
    <section class="px-5 py-[32px] lg:px-[32px] lg:py-[96px]">
      <div class="mx-auto max-w-[1600px]">
        <div
          class="grid items-center gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)] lg:gap-14"
        >
          <div>
            <h2
              class="max-w-[900px] font-anton text-[34px] leading-[0.92] tracking-[-0.69px] [hyphens:auto] [-webkit-hyphens:auto] [overflow-wrap:anywhere] lg:text-[60px]"
              data-i18n="apps.heading"
            >
              Sakkizta ilova, bitta sinxron tizim.
            </h2>

            <p
              class="mt-6 max-w-[640px] font-geist text-[20px] leading-[30px] text-muted lg:text-[24px] lg:leading-[34px]"
              data-i18n="apps.desc"
            >
              Sakkizta ilova bitta ekosistemada bitta ma'lumot manbasi bilan
              ishlaydi: buyurtma stolda olinadi, oshxonada pishiriladi,
              kuryerga topshiriladi va hisobotga aylanadi. POS, KDS, dispetcher,
              QR menyu va veb-do'kon — bitta platforma, bitta obuna, uzilishsiz
              sinxronizatsiya.
            </p>
          </div>

          <div
            class="relative mx-auto aspect-square w-[min(92vw,560px)] lg:w-full"
          >
          <svg
            class="pointer-events-none absolute inset-0 h-full w-full text-ink opacity-30"
            viewBox="0 0 100 100"
            fill="none"
            aria-hidden="true"
          >
            {
              tentacles.map((segs, wi) => (
                <g
                  class="octo-wire"
                  style={`animation-delay:${(-wi * 0.6).toFixed(1)}s`}
                >
                  {segs.map((s) => (
                    <path
                      d={s.d}
                      stroke="currentColor"
                      stroke-width={s.w}
                      stroke-linecap="round"
                      vector-effect="non-scaling-stroke"
                    />
                  ))}
                </g>
              ))
            }
          </svg>

          <a
            href="/apps"
            class="absolute left-1/2 top-1/2 z-20 -translate-x-1/2 -translate-y-1/2 rounded-full border border-hairline bg-page transition-transform duration-300 ease-far hover:scale-[1.04]"
            aria-label="Octopos"
          >
            <img
              src={logoDark.src}
              alt="Octopos"
              width="128"
              height="128"
              class="logo-dark block h-24 w-24 sm:h-28 sm:w-28 lg:h-32 lg:w-32"
              loading="eager"
              fetchpriority="high"
            />
            <img
              src={logoLight.src}
              alt=""
              width="128"
              height="128"
              class="logo-light block h-24 w-24 sm:h-28 sm:w-28 lg:h-32 lg:w-32"
              aria-hidden="true"
              loading="eager"
            />
          </a>

          {
            ring.map(({ app, x, y }, i) => (
              <a
                href={`/apps/${app.slug}`}
                title={app.tur}
                aria-label={`${app.name} — ${app.tur}`}
                class={`group absolute z-10 flex -translate-x-1/2 flex-col items-center ${mobileShift[i]}`}
                style={`left:${x.toFixed(2)}%;top:${y.toFixed(2)}%`}
              >
                <div
                  class="octo-tile flex flex-col items-center"
                  style={`animation-delay:${(-i * 0.55).toFixed(1)}s`}
                >
                  <span class="flex h-[54px] w-[54px] items-center justify-center rounded-[20px] border border-hairline bg-card text-ink transition-all duration-300 ease-far group-hover:scale-[1.08] group-hover:border-link/40 group-hover:bg-ink group-hover:text-on-ink sm:h-[70px] sm:w-[70px]">
                    <AppIcon slug={app.slug} class="h-7 w-7 sm:h-8 sm:w-8" />
                  </span>
                  <span class="mt-1.5 hidden whitespace-nowrap font-geist-mono text-[10px] leading-[1.2] tracking-[0.6px] text-muted min-[360px]:block">
                    {app.name}
                  </span>
                </div>
              </a>
            ))
          }
          </div>
        </div>
      </div>
    </section>

    {/* ---------------- solutions ---------------- */}
    <section
      id="solutions"
      class="scroll-mt-[70px] px-5 py-[32px] lg:px-[32px] lg:py-[96px]"
    >
      <div class="mx-auto max-w-[1600px]">
        <h2
          class="max-w-[1000px] font-anton text-[34px] leading-[0.92] tracking-[-0.69px] [hyphens:auto] [-webkit-hyphens:auto] [overflow-wrap:anywhere] lg:text-[60px]"
          data-i18n="sol.heading"
        >
          Biznesingiz uchun tayyor yechimlar
        </h2>

        <div class="mt-10 border-t border-hairline">
          {
            solutions.map((s) => (
              <div class="grid gap-3 border-b border-hairline py-7 lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-8">
                <div>
                  <h3
                    class="font-geist text-[19px] leading-[1.25] font-medium tracking-[-0.2px] lg:text-[22px]"
                    data-i18n={s.kT}
                  >
                    {s.uzT}
                  </h3>
                  <p
                    class="mt-2 max-w-[640px] font-geist text-[20px] leading-[30px] text-muted"
                    data-i18n={s.kD}
                  >
                    {s.uzD}
                  </p>
                </div>
                <span class="font-geist-mono text-[12px] leading-[18px] tracking-[0.72px] text-muted lg:text-right">
                  {s.tags}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* ---------------- features ---------------- */}
    <section class="px-5 py-[32px] lg:px-[32px] lg:py-[96px]">
      <div class="mx-auto max-w-[1600px]">
        <h2
          class="font-anton text-[34px] leading-[0.92] tracking-[-0.69px] [hyphens:auto] [-webkit-hyphens:auto] [overflow-wrap:anywhere] lg:text-[60px]"
          data-i18n="feat.heading"
        >
          Har ilova nima qila oladi?
        </h2>

        <div class="mt-12 grid gap-x-12 gap-y-10 md:grid-cols-2">
          {
            apps.map((app) => (
              <div class="border-t border-hairline pt-5">
                <div class="flex items-baseline justify-between gap-4">
                  <h3 class="font-geist text-[17px] leading-[1.3] font-medium">
                    {app.name}
                  </h3>
                  <span
                    class="shrink-0 font-geist-mono text-[12px] leading-4 tracking-[0.72px] text-muted"
                    data-i18n={has(`v.${app.tur}`) ? `v.${app.tur}` : undefined}
                  >
                    {app.tur}
                  </span>
                </div>
                <ul class="mt-4 flex flex-col gap-2.5">
                  {app.features.map((f, i) => (
                    <li class="flex gap-3">
                      <span
                        class="font-geist-mono text-[12px] leading-[21px] text-muted"
                        aria-hidden="true"
                      >
                        —
                      </span>
                      <span
                        class="font-geist text-[20px] leading-[30px] text-ink/75"
                        data-i18n={`feat.${app.slug}.${i}`}
                      >
                        {f}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* ---------------- trusted logos ---------------- */}
    <section class="px-5 py-[32px] lg:px-[32px] lg:py-[96px]">
      <div class="mx-auto max-w-[1600px]">
        <h2
          class="max-w-[1000px] font-anton text-[34px] leading-[0.92] tracking-[-0.69px] [hyphens:auto] [-webkit-hyphens:auto] [overflow-wrap:anywhere] lg:text-[60px]"
          data-i18n="logos.heading"
        >
          Octopos-da ishlaydigan restoranlar
        </h2>
        <p
          class="mt-5 max-w-[560px] font-geist text-[20px] leading-[30px] text-muted"
          data-i18n="logos.sub"
        >
          Bitta kafedan tarmoqlargacha — real biznes, real natijalar.
        </p>
      </div>

      <div class="marquee mt-10 overflow-hidden">
        <div class="marquee-track flex items-center gap-[64px] pr-[64px]">
          {
            [...restaurantLogos, ...restaurantLogos].map((n, i) => (
              <img
                src={`/restaurants/${n}.webp`}
                alt=""
                aria-hidden={i >= restaurantLogos.length ? "true" : undefined}
                class="logo-ticker h-[34px] w-auto shrink-0 object-contain opacity-80"
                loading="lazy"
                decoding="async"
              />
            ))
          }
        </div>
      </div>
    </section>

    {/* ---------------- integrations ---------------- */}
    <section class="px-5 py-[32px] lg:px-[32px] lg:py-[96px]">
      <div class="mx-auto max-w-[1600px]">
        <h2
          class="font-anton text-[34px] leading-[0.92] tracking-[-0.69px] [hyphens:auto] [-webkit-hyphens:auto] [overflow-wrap:anywhere] lg:text-[60px]"
          data-i18n="int.heading"
        >
          To'lov va xizmatlar bilan ishlaydi
        </h2>

        <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-7">
          {
            payLogos.map((l) => (
              <div class="flex h-[86px] items-center justify-center rounded-2xl border border-hairline bg-card/40 px-5">
                <img
                  src={l.src}
                  alt={l.alt}
                  class="max-h-[30px] max-w-full object-contain"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ))
          }
        </div>

        <p
          class="mt-6 max-w-[720px] font-geist text-[20px] leading-[30px] text-muted"
          data-i18n="int.note"
        >
          Payme va Click o'rnatilgan — bir marta ulang, har bir ilovada
          to'lov qabul qiling.
        </p>
      </div>
    </section>

    {/* ---------------- plans ---------------- */}
    <section
      id="plans"
      class="scroll-mt-[70px] px-5 py-[32px] lg:px-[32px] lg:py-[96px]"
    >
      <div class="mx-auto max-w-[1600px]">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div>
            <h2
              class="font-anton text-[34px] leading-[0.92] tracking-[-0.69px] [hyphens:auto] [-webkit-hyphens:auto] [overflow-wrap:anywhere] lg:text-[60px]"
              data-i18n="plans.heading"
            >
              Bitta shaffof obuna
            </h2>
            <p
              class="mt-4 max-w-[520px] font-geist text-[20px] leading-[30px] text-muted"
              data-i18n="plans.body"
            >
              Yashirin to'lovlar yo'q. Chalkash darajalar yo'q. Hammasi ichida.
            </p>
          </div>

          <div class="flex items-center gap-3">
            <div
              class="flex rounded-full border border-hairline p-1 font-geist-mono text-[12px] tracking-[0.72px]"
            >
              <button
                type="button"
                data-cycle="monthly"
                class="rounded-full bg-ink px-4 py-2 text-on-ink transition-colors duration-300"
                data-i18n="plans.monthly">Oylik</button
              >
              <button
                type="button"
                data-cycle="yearly"
                class="rounded-full px-4 py-2 text-muted transition-colors duration-300"
                data-i18n="plans.yearly">Yillik</button
              >
            </div>
            <span
              class="hidden font-geist-mono text-[11px] tracking-[0.72px] text-muted sm:block"
              data-i18n="plans.saveNote">Yillik to'lov · 10% tejash</span
            >
          </div>
        </div>

        <p
          id="plans-loading"
          class="mt-10 font-geist-mono text-[12px] tracking-[0.72px] text-muted"
          data-i18n="plans.loading"
        >
          Yuklanmoqda…
        </p>
        <div
          id="plans-grid"
          class="mt-12 grid items-stretch gap-4 md:grid-cols-2 xl:grid-cols-4"
        >
        </div>

        <div
          class="mt-8 flex flex-col items-start justify-between gap-5 rounded-2xl border border-hairline bg-card/40 p-6 lg:flex-row lg:items-center"
        >
          <div>
            <h3
              class="font-geist text-[16px] leading-[1.3] font-medium"
              data-i18n="plans.helpH"
            >
              Franshiza yuritasizmi yoki sozlashda yordam kerakmi?
            </h3>
            <p
              class="mt-2 max-w-[760px] font-geist text-[20px] leading-[30px] text-muted"
              data-i18n="plans.helpB"
            >
              Barcha joylar bo'yicha menyu, inventar va hisobotlarni
              markazlashtiramiz — hamda menyuni raqamlashtirish, zal rejasini
              chizish va xodimlarni o'qitishda yordam beramiz.
            </p>
          </div>
          <a
            href="https://t.me/octopos_support"
            class="flex h-[44px] shrink-0 items-center justify-center rounded-[99px] border border-hairline px-6 font-geist-mono text-[16px] font-medium tracking-[0.72px] text-ink transition-colors duration-[350ms] ease-far hover:border-link hover:text-link"
          >
            <span data-i18n="plans.helpCta">Telegramga yozish</span>
          </a>
        </div>
      </div>
    </section>

    {/* ---------------- add-ons ---------------- */}
    <section class="px-5 py-[32px] lg:px-[32px] lg:py-[96px]">
      <div class="mx-auto max-w-[1600px]">
        <h2
          class="font-anton text-[34px] leading-[0.92] tracking-[-0.69px] [hyphens:auto] [-webkit-hyphens:auto] [overflow-wrap:anywhere] lg:text-[60px]"
          data-i18n="add.heading"
        >
          Qo'shimcha xizmatlar
        </h2>

        <div class="mt-10 grid gap-4 lg:grid-cols-3">
          {/* online store / website */}
          <div class="flex flex-col rounded-2xl border border-hairline bg-card/40 p-6 lg:p-8">
            <h3
              class="font-geist text-[19px] leading-[1.25] font-medium"
              data-i18n="add.t1"
            >
              Onlayn do'kon
            </h3>
            <p
              class="mt-3 font-geist text-[20px] leading-[30px] text-muted"
              data-i18n="add.b1"
            >
              O'z saytingiz va Telegram orqali buyurtmalar, komissiyasiz.
              Darajalar faqat kiritilgan onlayn buyurtmalar soni bilan farq
              qiladi.
            </p>

            <div class="mt-5 grid grid-cols-2 gap-2">
              {
                storeTiers.map((t) => (
                  <div class="rounded-xl border border-hairline p-3">
                    <p class="font-geist-mono text-[11px] tracking-[0.72px] text-muted">
                      {t.name}
                    </p>
                    <p class="mt-1 flex items-baseline gap-1">
                      <span class="font-geist text-[16px] font-medium text-ink"
                        >{t.price}</span
