---

<Layout
  title="Octopos — restoran, kafe va do'konlar uchun kassa dasturi"
  description="Kassa dasturi, oshxona ekrani, QR-menyu, onlayn do'kon, ombor va fiskal cheklar bitta tizimda. O'zbekistondagi restoran, kafe va do'konlar uchun. Bepul tarif bor."
  jsonLd={[...homeLd, faqLd]}
  preloadImage={
    heroImg
      ? {
          href: heroImg,
          srcset: heroSrcset ?? undefined,
          sizes: HERO_SIZES,
        }
      : undefined
  }
>
  <TopNav />

  <main>
    {/* ---------------- hero ---------------- */}
    <section class="px-5 pt-[22px] pb-[28px] lg:px-[32px] lg:pt-[68px] lg:pb-[72px]">
      <div class="mx-auto max-w-[1600px]">

        <h1
          class="max-w-[1200px] font-anton text-[clamp(40px,11vw,64px)] leading-[1.03] tracking-[-0.69px] [hyphens:auto] [-webkit-hyphens:auto] [overflow-wrap:anywhere] lg:text-[138px]"
          data-i18n="hero.title"
        >
          Eng yaxshisini ishlating, boshliq!
        </h1>

        <div
          class="mt-10 flex flex-col items-start gap-7 lg:flex-row lg:items-end lg:justify-between lg:gap-16"
        >
          <p
            class="max-w-[600px] font-geist text-[20px] leading-[30px] text-muted"
            data-i18n="hero.body"
          >
            Kassa, oshxona ekrani, QR-menyu, onlayn do'kon va yetkazib berish
            bitta tizimda. Ombor, soliq cheklari va hisobotlar ham shu yerda.
            Internet uzilsa ham savdo to'xtamaydi.
          </p>
          <div class="flex shrink-0 flex-col items-start gap-4 lg:items-end">
            <div class="flex flex-wrap gap-3 lg:justify-end">
              <button
                type="button"
                data-plan-trigger="starter"
                class="btn-solid h-[48px] px-7 font-geist-mono text-[12px] font-medium tracking-[0.72px]"
              >
                <span data-i18n="hero.cta">Bepul sinab ko'ring →</span>
              </button>
              <a
                href="#contact"
                data-lead-jump
                class="btn-outline h-[48px] px-7 font-geist-mono text-[12px] font-medium tracking-[0.72px]"
              >
                <span data-i18n="ct.demo">Demo so'rash</span>
              </a>
            </div>
          </div>
        </div>

        <div class="relative mt-10 overflow-hidden rounded-2xl bg-card" style={heroWrapStyle}>
          {
            heroImg ? (
              <img
                src={heroImg}
                alt="RestaurantPOS — restoran POS ekrani"
                class:list={["block", heroTrim ? "" : "h-auto w-full"]}
                style={heroImgStyle}
                width={heroMeta?.w}
                height={heroMeta?.h}
                srcset={heroSrcset}
                sizes={HERO_SIZES}
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            ) : (
              <span class="flex h-[320px] items-center justify-center font-geist-mono text-[12px] tracking-[0.72px] text-muted">
                Rasmlar tez orada paydo bo'ladi
              </span>
            )
          }
        </div>

        <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-6 border-t border-hairline pt-8 lg:mt-12 lg:grid-cols-4 lg:gap-10">
          {
            stats.map((s) => (
              <div>
                <dt
                  class="font-anton text-[32px] leading-none tracking-[-0.5px] text-ink lg:text-[44px]"
                  data-i18n={`proof.${s.n}v`}
                >
                  {s.v}
                </dt>
                <dd
                  class="mt-2 max-w-[260px] font-geist text-[14px] leading-[20px] text-muted lg:text-[16px] lg:leading-[24px]"
                  data-i18n={`proof.${s.n}l`}
                >
                  {s.l}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    {/* ---------------- problems → solutions ---------------- */}
    <section
      id="solutions"
      class="scroll-mt-[70px] px-5 py-[32px] lg:px-[32px] lg:py-[96px]"
    >
      <div class="mx-auto max-w-[1600px]">
        <h2
          class="max-w-[1000px] font-anton text-[34px] leading-[0.92] tracking-[-0.69px] [hyphens:auto] [-webkit-hyphens:auto] [overflow-wrap:anywhere] lg:text-[60px]"
          data-i18n="prob.heading"
        >
          Tanish muammolar, tayyor yechimlar
        </h2>
        <p
          class="mt-5 max-w-[640px] font-geist text-[18px] leading-[28px] text-muted lg:text-[20px] lg:leading-[30px]"
          data-i18n="prob.body"
        >
          Har kuni kassa yonida turolmaysiz. Octopos har bir chek, har bir
          gramm mahsulot va har bir bekor qilishni yozib boradi.
        </p>

        <div class="mt-10 flex flex-col gap-16 lg:mt-16 lg:gap-32">
          {
            problems.map((pr) => (
              <article
                class:list={[
                  pr.receipt && "grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,420px)] lg:gap-20",
                ]}
              >
                <div class:list={["min-w-0", pr.receipt ? "max-w-[820px]" : "max-w-[760px]"]}>
                  <p
                    class="flex flex-wrap items-center gap-x-3 gap-y-2 font-geist text-[15px] leading-[22px] font-medium text-link lg:text-[17px]"
                  >
                    <span data-i18n={`prob.${pr.n}p`}>{pr.pain}</span>
                    {pr.plan && (
                      <a
                        href="#plans"
                        class="rounded-full border border-hairline px-2.5 py-1 font-geist-mono text-[11px] leading-none font-normal tracking-[0.5px] text-muted transition-colors duration-300 hover:border-link/40 hover:text-ink"
                        data-i18n="prob.planFrom"
                        data-name={pr.plan}
                      >
                        {pr.plan} tarifidan
                      </a>
                    )}
                  </p>
                  <h3
                    class="mt-4 font-geist text-[28px] leading-[1.15] font-semibold tracking-[-0.6px] text-balance text-ink lg:text-[44px] lg:leading-[1.08] lg:tracking-[-1px]"
                    data-i18n={`prob.${pr.n}t`}
                  >
                    {pr.title}
                  </h3>
                  <p
                    class="mt-5 max-w-[640px] font-geist text-[17px] leading-[28px] text-muted lg:text-[19px] lg:leading-[31px]"
                    data-i18n={`prob.${pr.n}d`}
                  >
                    {pr.body}
                  </p>
                  {pr.receipt && (
                    <ul class="mt-6 grid gap-x-8 gap-y-3 border-t border-hairline pt-6 sm:mt-8 sm:grid-cols-2 sm:gap-y-6 sm:pt-8 lg:mt-10 lg:pt-10">
