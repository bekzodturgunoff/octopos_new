---
import Layout from "../layouts/Layout.astro";
import TopNav from "../components/TopNav.astro";
import AgentDownload from "../components/AgentDownload.astro";
import { apps, imagesFor } from "../data/apps";
import { has } from "../data/i18n";

const cards = apps.map((app) => ({ app, images: imagesFor(app.slug) }));
const heroImg = imagesFor("pos-restaurant")[0];

const storeTiers = [
  { name: "Start", price: "$65", n: 1000 },
  { name: "Pro", price: "$179", n: 3000 },
  { name: "Business", price: "$329", n: 6000 },
  { name: "Enterprise", price: "$619", n: 10000 },
];
const photoTiers = [
  { n: 200, price: "$12" },
  { n: 600, price: "$29" },
  { n: 1500, price: "$57" },
];

const solutions = [
  {
    uzT: "Restoran va kafelar",
    kT: "sol.1t",
    uzD:
      "Zal, stol rejasi, QR menyu, oshxona ekrani va kuryer — buyurtma stoldan hisobotgacha to'liq tsikl.",
    kD: "sol.1d",
    tags: "POS · QR menyu · KDS · ODS",
  },
  {
    uzT: "Market va do'konlar",
    kT: "sol.2t",
    uzD:
      "Barkod, tort, ombor qoldig'i, to'lov va kassa hisobotlari — savdo sig'imi bilan ishlash uchun.",
    kD: "sol.2d",
    tags: "POS · Ombor · Kassa",
  },
  {
    uzT: "Onlayn buyurtmalar",
    kT: "sol.3t",
    uzD:
      "Veb-do'kon, Telegram va aggregatorlar (Yandex Eats, Uzum Tezkor) — barchasi bitta kassaga.",
    kD: "sol.3d",
    tags: "Veb-do'kon · Telegram · Aggregator",
  },
  {
    uzT: "O'z yetkazib berish",
    kT: "sol.4t",
    uzD:
      "Dispetcher paneli, Telegram orqali kuryerlar, jonli xarita va cheksiz kuryerlar soni.",
    kD: "sol.4d",
    tags: "Dispetcher · GPS · Telegram",
  },
];

const restaurantLogos = [
  "baba-food",
  "bonet",
  "caffe_vero",
  "family-cafe",
  "feruz_burger",
  "holland-fries",
  "imron-cafe",
  "mantidee",
  "street-food",
  "sushi_nebo",
  "sushi_panda",
  "tandir",
  "tochka-burger",
  "uch-qozon",
  "waffle&co",
];

const payLogos = [
  { src: "/payments/payme.webp", alt: "Payme" },
  { src: "/payments/click.webp", alt: "Click" },
  { src: "/payments/dodo-payments.webp", alt: "Dodo Payments" },
  { src: "/integrations/telegram.webp", alt: "Telegram" },
  { src: "/integrations/uzum-tezkor.webp", alt: "Uzum Tezkor" },
  { src: "/integrations/yandex-eats.webp", alt: "Yandex Eats" },
  { src: "/integrations/yandex-go.webp", alt: "Yandex Go" },
];
---

<Layout
  title="Octopos — Bitta platforma, sakkizta ilova"
  description="POS, KDS, dashbord, QR menyu, veb-do'kon va kuryer dispetcheri — bitta obuna, bitta ma'lumot manbasi. O'zbekistonda restoranlar uchun to'liq tizim."
>
  <TopNav />

  <main>
    {/* ---------------- hero ---------------- */}
    <section class="px-5 pt-[44px] pb-[56px] lg:px-[32px] lg:pt-[68px] lg:pb-[72px]">
      <div class="mx-auto max-w-[1600px]">

        <h1
          class="font-anton text-[64px] leading-[0.86] tracking-[-0.69px] lg:text-[138px]"
        >
          <span class="block" data-i18n="hero.title1">Bitta platforma.</span>
          <span class="block" data-i18n="hero.title2">Sakkizta ilova.</span>
        </h1>

        <div
          class="mt-8 flex flex-col items-start justify-between gap-6 lg:flex-row lg:items-end lg:gap-12"
        >
          <p
            class="max-w-[560px] font-geist text-[14px] leading-[22px] text-muted"
            data-i18n="hero.body"
          >
            POS, KDS, dashbord, QR menyu, veb-do'kon va kuryer dispetcheri —
            bitta obuna, bitta ma'lumot manbasi. Internet uzilsa ham ishlashda
            davom etadi.
          </p>
          <div class="flex shrink-0 flex-col items-start gap-3 lg:items-end">
            <button
              type="button"
              data-plan-trigger="starter"
              class="flex h-[48px] items-center justify-center rounded-[99px] bg-accent px-7 font-geist-mono text-[12px] font-medium tracking-[0.72px] text-accent-emphasis transition-colors duration-[350ms] ease-far hover:bg-accent-active"
            >
              <span data-i18n="hero.cta">Bepul sinab ko'rish →</span>
            </button>
            <p
              class="font-geist-mono text-[11px] leading-4 tracking-[0.72px] text-muted"
              data-i18n="hero.trust"
            >
              ✓ Karta talab qilinmaydi · ✓ Bugun ishga tushadi · ✓ Oflayn
              ishlaydi
            </p>
          </div>
        </div>

        <div class="mt-10 overflow-hidden rounded-2xl bg-card">
          {
            heroImg ? (
              <img
                src={heroImg}
                alt="OctoPos — restoran POS ekrani"
                class="block -mt-[3px] w-full h-auto"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            ) : (
              <span class="flex h-[320px] items-center justify-center font-geist-mono text-[12px] tracking-[0.72px] text-muted">
                Rasmlar tez orada
              </span>
            )
          }
        </div>
      </div>
    </section>

    {/* ---------------- apps ---------------- */}
    <section class="border-t border-hairline px-5 py-[64px] lg:px-[32px] lg:py-[96px]">
      <div class="mx-auto max-w-[1600px]">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div>
            <h2
              class="max-w-[900px] font-anton text-[46px] leading-[0.92] tracking-[-0.69px] lg:text-[86px]"
              data-i18n="apps.heading"
            >
              Sakkizta ilova, bitta sinxron tizim.
            </h2>
          </div>
          <a
            href="/apps"
            class="font-geist-mono text-[12px] leading-4 tracking-[0.72px] text-ink transition-colors duration-[350ms] ease-far hover:text-link"
            data-i18n="apps.viewAll">Barcha ilovalar →</a
          >
        </div>

        <div class="mt-10 grid grid-cols-1 gap-[40px] md:grid-cols-2">
          {
            cards.map(({ app, images }) => (
              <a
                href={`/apps/${app.slug}`}
                class="group relative block aspect-[8/5] overflow-hidden rounded-2xl bg-card"
              >
                {images[0] ? (
                  <>
                    <img
                      src={images[0]}
                      alt={`${app.name} — ekran ko'rinishi`}
                      class="absolute inset-x-0 bottom-0 h-[calc(100%+3px)] w-full object-cover object-top transition-transform duration-[450ms] ease-far group-hover:scale-[1.03]"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="pointer-events-none absolute inset-x-0 bottom-0 block h-1/2 bg-linear-to-t from-black/60 via-black/15 to-transparent" />
                  </>
                ) : (
                  <span class="absolute inset-0 flex items-center justify-center font-geist-mono text-[12px] tracking-[0.72px] text-muted">
                    Rasmlar tez orada
                  </span>
                )}

                <span class="pointer-events-none absolute inset-x-0 bottom-0 flex items-baseline justify-between gap-3 p-4 lg:p-5">
                  <span class="min-w-0">
                    <span
                      class={`block font-geist-mono text-[12px] leading-4 tracking-[0.72px] ${images[0] ? "text-white/75" : "text-muted"}`}
                    >
                      {app.no} ·{" "}
                      <span
                        data-i18n={
                          has(`v.${app.tur}`) ? `v.${app.tur}` : undefined
                        }
                      >
                        {app.tur}
                      </span>
                    </span>
                    <span
                      class={`mt-1 block font-inter text-[17px] leading-[1.3] font-medium ${images[0] ? "text-[#fafafa]" : "text-ink"}`}
                    >
                      {app.name}
                    </span>
                  </span>
                  <span
                    class={`shrink-0 font-geist-mono text-[12px] leading-4 tracking-[0.72px] ${images[0] ? "text-white/60" : "text-muted"}`}
                    data-i18n="imgCount"
                    data-n={images.length}
                  >
                    {images.length} rasm
                  </span>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {/* ---------------- solutions ---------------- */}
    <section
      id="solutions"
      class="scroll-mt-[70px] border-t border-hairline px-5 py-[64px] lg:px-[32px] lg:py-[96px]"
    >
      <div class="mx-auto max-w-[1600px]">
        <h2
          class="max-w-[1000px] font-anton text-[46px] leading-[0.92] tracking-[-0.69px] lg:text-[86px]"
          data-i18n="sol.heading"
        >
          Biznesingiz uchun tayyor yechimlar
        </h2>

        <div class="mt-10 border-t border-hairline">
          {
            solutions.map((s, i) => (
              <div class="grid gap-3 border-b border-hairline py-7 lg:grid-cols-[72px_minmax(0,1fr)_280px] lg:gap-8">
                <span class="font-geist-mono text-[12px] leading-[18px] tracking-[0.72px] text-muted">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <div>
                  <h3
                    class="font-geist text-[19px] leading-[1.25] font-medium tracking-[-0.2px] lg:text-[22px]"
                    data-i18n={s.kT}
                  >
                    {s.uzT}
                  </h3>
                  <p
                    class="mt-2 max-w-[640px] font-geist text-[13.5px] leading-[21px] text-muted"
                    data-i18n={s.kD}
                  >
                    {s.uzD}
                  </p>
                </div>
                <span class="font-geist-mono text-[12px] leading-[18px] tracking-[0.72px] text-muted lg:text-right">
                  {s.tags}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* ---------------- features ---------------- */}
    <section class="border-t border-hairline px-5 py-[64px] lg:px-[32px] lg:py-[96px]">
      <div class="mx-auto max-w-[1600px]">
        <h2
          class="font-anton text-[46px] leading-[0.92] tracking-[-0.69px] lg:text-[86px]"
          data-i18n="feat.heading"
        >
          Har ilova nima qila oladi?
        </h2>

        <div class="mt-12 grid gap-x-12 gap-y-10 md:grid-cols-2">
          {
            cards.map(({ app }) => (
              <div class="border-t border-hairline pt-5">
                <div class="flex items-baseline justify-between gap-4">
                  <div>
                    <span class="font-geist-mono text-[12px] leading-4 tracking-[0.72px] text-muted">
                      {app.no}
                    </span>
                    <h3 class="mt-1 font-geist text-[17px] leading-[1.3] font-medium">
                      {app.name}
                    </h3>
                  </div>
                  <span
                    class="shrink-0 font-geist-mono text-[12px] leading-4 tracking-[0.72px] text-muted"
                    data-i18n={has(`v.${app.tur}`) ? `v.${app.tur}` : undefined}
                  >
                    {app.tur}
                  </span>
                </div>
                <ul class="mt-4 flex flex-col gap-2.5">
                  {app.features.map((f, i) => (
                    <li class="flex gap-3">
                      <span
                        class="font-geist-mono text-[12px] leading-[21px] text-muted"
                        aria-hidden="true"
                      >
                        —
                      </span>
                      <span
                        class="font-geist text-[13.5px] leading-[21px] text-ink/75"
                        data-i18n={`feat.${app.slug}.${i}`}
                      >
                        {f}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* ---------------- trusted logos ---------------- */}
    <section class="border-t border-hairline px-5 py-[64px] lg:px-[32px] lg:py-[96px]">
      <div class="mx-auto max-w-[1600px]">
        <h2
          class="max-w-[1000px] font-anton text-[46px] leading-[0.92] tracking-[-0.69px] lg:text-[86px]"
          data-i18n="logos.heading"
        >
          Octopos-da ishlaydigan restoranlar
        </h2>
        <p
          class="mt-5 max-w-[560px] font-geist text-[13.5px] leading-[21px] text-muted"
          data-i18n="logos.sub"
        >
          Bitta kafedan tarmoqlargacha — real biznes, real natijalar.
        </p>
      </div>

      <div class="marquee mt-10 overflow-hidden">
        <div class="marquee-track flex items-center gap-[64px] pr-[64px]">
          {
            [...restaurantLogos, ...restaurantLogos].map((n, i) => (
              <img
                src={`/restaurants/${n}.webp`}
                alt=""
                aria-hidden={i >= restaurantLogos.length ? "true" : undefined}
                class="logo-ticker h-[34px] w-auto shrink-0 object-contain opacity-80"
                loading="lazy"
                decoding="async"
              />
            ))
          }
        </div>
      </div>
    </section>

    {/* ---------------- integrations ---------------- */}
    <section class="border-t border-hairline px-5 py-[64px] lg:px-[32px] lg:py-[96px]">
      <div class="mx-auto max-w-[1600px]">
        <h2
          class="font-anton text-[46px] leading-[0.92] tracking-[-0.69px] lg:text-[86px]"
          data-i18n="int.heading"
        >
          To'lov va xizmatlar bilan ishlaydi
        </h2>

        <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-7">
          {
            payLogos.map((l) => (
              <div class="flex h-[86px] items-center justify-center rounded-2xl border border-hairline bg-card/40 px-5">
                <img
                  src={l.src}
                  alt={l.alt}
                  class="max-h-[30px] max-w-full object-contain"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ))
          }
        </div>

        <p
          class="mt-6 max-w-[720px] font-geist text-[13.5px] leading-[21px] text-muted"
          data-i18n="int.note"
        >
          Payme va Click o'rnatilgan — bir marta ulang, har bir ilovada
          to'lov qabul qiling.
        </p>
      </div>
    </section>

    {/* ---------------- plans ---------------- */}
    <section
      id="plans"
      class="scroll-mt-[70px] border-t border-hairline px-5 py-[64px] lg:px-[32px] lg:py-[96px]"
    >
      <div class="mx-auto max-w-[1600px]">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div>
            <h2
              class="font-anton text-[46px] leading-[0.92] tracking-[-0.69px] lg:text-[86px]"
              data-i18n="plans.heading"
            >
              Bitta shaffof obuna
            </h2>
            <p
              class="mt-4 max-w-[520px] font-geist text-[13.5px] leading-[21px] text-muted"
              data-i18n="plans.body"
            >
              Yashirin to'lovlar yo'q. Chalkash darajalar yo'q. Hammasi ichida.
            </p>
          </div>

          <div class="flex items-center gap-3">
            <div
              class="flex rounded-full border border-hairline p-1 font-geist-mono text-[12px] tracking-[0.72px]"
            >
              <button
                type="button"
                data-cycle="monthly"
                class="rounded-full bg-ink px-4 py-2 text-on-ink transition-colors duration-300"
                data-i18n="plans.monthly">Oylik</button
              >
              <button
                type="button"
                data-cycle="yearly"
                class="rounded-full px-4 py-2 text-muted transition-colors duration-300"
                data-i18n="plans.yearly">Yillik</button
              >
            </div>
            <span
              class="hidden font-geist-mono text-[11px] tracking-[0.72px] text-muted sm:block"
              data-i18n="plans.saveNote">Yillik to'lov · 10% tejash</span
            >
          </div>
        </div>

        <p
          id="plans-loading"
          class="mt-10 font-geist-mono text-[12px] tracking-[0.72px] text-muted"
          data-i18n="plans.loading"
        >
          Yuklanmoqda…
        </p>
        <div id="plans-grid" class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        </div>

        <div
          class="mt-8 flex flex-col items-start justify-between gap-5 rounded-2xl border border-hairline bg-card/40 p-6 lg:flex-row lg:items-center"
        >
          <div>
            <h3
              class="font-geist text-[16px] leading-[1.3] font-medium"
              data-i18n="plans.helpH"
            >
              Franshiza yuritasizmi yoki sozlashda yordam kerakmi?
            </h3>
            <p
              class="mt-2 max-w-[760px] font-geist text-[13.5px] leading-[21px] text-muted"
              data-i18n="plans.helpB"
            >
              Barcha joylar bo'yicha menyu, inventar va hisobotlarni
              markazlashtiramiz — hamda menyuni raqamlashtirish, zal rejasini
              chizish va xodimlarni o'qitishda yordam beramiz.
            </p>
          </div>
          <a
            href="https://t.me/octopos_support"
            class="flex h-[44px] shrink-0 items-center justify-center rounded-[99px] border border-hairline px-6 font-geist-mono text-[12px] font-medium tracking-[0.72px] text-ink transition-colors duration-[350ms] ease-far hover:border-link hover:text-link"
          >
            <span data-i18n="plans.helpCta">Telegramga yozish</span>
          </a>
        </div>
      </div>
    </section>

    {/* ---------------- add-ons ---------------- */}
    <section class="border-t border-hairline px-5 py-[64px] lg:px-[32px] lg:py-[96px]">
      <div class="mx-auto max-w-[1600px]">
        <h2
          class="font-anton text-[46px] leading-[0.92] tracking-[-0.69px] lg:text-[86px]"
          data-i18n="add.heading"
        >
          Qo'shimcha xizmatlar
        </h2>

        <div class="mt-10 grid gap-4 lg:grid-cols-3">
          {/* online store / website */}
          <div class="flex flex-col rounded-2xl border border-hairline bg-card/40 p-6 lg:p-8">
            <h3
              class="font-geist text-[19px] leading-[1.25] font-medium"
              data-i18n="add.t1"
            >
              Onlayn do'kon
            </h3>
            <p
              class="mt-3 font-geist text-[13.5px] leading-[21px] text-muted"
              data-i18n="add.b1"
            >
              O'z saytingiz va Telegram orqali buyurtmalar, komissiyasiz.
              Darajalar faqat kiritilgan onlayn buyurtmalar soni bilan farq
              qiladi.
            </p>

            <div class="mt-5 grid grid-cols-2 gap-2">
              {
                storeTiers.map((t) => (
                  <div class="rounded-xl border border-hairline p-3">
                    <p class="font-geist-mono text-[11px] tracking-[0.72px] text-muted">
                      {t.name}
                    </p>
                    <p class="mt-1 flex items-baseline gap-1">
                      <span class="font-geist text-[16px] font-medium text-ink"
                        >{t.price}</span
                      >
                      <span
                        class="font-geist-mono text-[11px] tracking-[0.72px] text-muted"
                        data-i18n="plans.perMonth">/oy</span
                      >
                    </p>
                    <p
                      class="mt-1 font-geist text-[12px] leading-[16px] text-muted"
                      data-i18n="add.orders"
                      data-n={String(t.n)}
                    >
                      {t.n} ta onlayn buyurtma/oy
                    </p>
                  </div>
                ))
              }
            </div>

            <p
              class="mt-3 font-geist text-[12.5px] leading-[18px] text-muted"
              data-i18n="add.note"
            >
              Barcha tariflarga 50 ta onlayn buyurtma kiritilgan.
            </p>

            <ul class="mt-5 flex flex-wrap gap-2">
              {
                [
                  ["add.f1", "O'z domeningiz"],
                  ["add.f2", "Faqat sizning brendingiz"],
                  ["add.f3", "Komissiyasiz"],
                ].map(([k, uz]) => (
                  <li
                    class="rounded-full border border-hairline px-3 py-1.5 font-geist-mono text-[11px] tracking-[0.72px] text-muted"
                    data-i18n={k}
                  >
                    {uz}
                  </li>
                ))
              }
            </ul>

            <div class="mt-auto pt-6">
              <button
                type="button"
                data-plan-trigger="starter"
                class="flex h-[44px] items-center justify-center rounded-[99px] bg-accent px-6 font-geist-mono text-[12px] font-medium tracking-[0.72px] text-accent-emphasis transition-colors duration-[350ms] ease-far hover:bg-accent-active"
              >
                <span data-i18n="cta.tryFree">Bepul sinab ko'rish →</span>
              </button>
            </div>
          </div>

          {/* own delivery */}
          <div class="flex flex-col rounded-2xl border border-hairline bg-card/40 p-6 lg:p-8">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h3
                class="font-geist text-[19px] leading-[1.25] font-medium"
                data-i18n="sol.4t"
              >
                O'z yetkazib berish
              </h3>
              <p class="flex items-baseline gap-1">
                <span class="font-geist text-[17px] font-medium text-ink"
                  >$32</span
                >
                <span
                  class="font-geist-mono text-[12px] tracking-[0.72px] text-muted"
                  data-i18n="plans.perMonth">/oy</span
                >
              </p>
            </div>
            <p
              class="mt-3 font-geist text-[13.5px] leading-[21px] text-muted"
              data-i18n="add.b2"
            >
              O'z kuryerlaringiz bilan yetkazing: dispetcherlik, kuryer
              ilovasi, jonli kuzatuv va naqd hisob-kitob.
            </p>

            <ul class="mt-6 flex flex-wrap gap-2">
              {
                [
                  ["add.d1", "Dispetcher paneli"],
                  ["add.d2", "Telegram kuryerlar"],
                  ["add.d3", "Jonli GPS"],
                  ["add.d4", "Hisob-kitob"],
                  ["add.d5", "Cheksiz kuryer"],
                ].map(([k, uz]) => (
                  <li
                    class="rounded-full border border-hairline px-3 py-1.5 font-geist-mono text-[11px] tracking-[0.72px] text-muted"
                    data-i18n={k}
                  >
                    {uz}
                  </li>
                ))
              }
            </ul>

            <div class="mt-auto pt-6">
              <button
                type="button"
                data-plan-trigger="starter"
                class="flex h-[44px] items-center justify-center rounded-[99px] bg-accent px-6 font-geist-mono text-[12px] font-medium tracking-[0.72px] text-accent-emphasis transition-colors duration-[350ms] ease-far hover:bg-accent-active"
              >
