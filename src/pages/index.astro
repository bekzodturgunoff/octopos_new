  <script>
    import { STRINGS, getLang, type Lang } from "../data/i18n";

    const API = "https://api.octopos.uz";
    const grid = document.getElementById("plans-grid");
    const loading = document.getElementById("plans-loading");
    const cycleBtns = document.querySelectorAll<HTMLElement>("[data-cycle]");

    const UZ: Record<string, string> = {
      "plans.monthly": "Oylik",
      "plans.yearly": "Yillik",
      "plans.saveNote": "Yillik to'lov · 10% tejash",
      "plans.startFree": "Bepul boshlash",
      "plans.getStarted": "Boshlash",
      "plans.popular": "Eng mashhur",
      "plans.noCard": "Karta talab qilinmaydi",
      "plans.perMonth": "/oy",
      "plans.perYear": "/yil",
      "plans.locations": "{n} ta lokatsiya",
      "plans.aiPhotos": "{n} ta AI surat/oy",
      "plans.onlineOrders": "{n} ta onlayn buyurtma/oy",
      "plans.loading": "Yuklanmoqda…",
    };

    let cycle: "monthly" | "yearly" = "monthly";
    let plans: any[] = [];
    let fetchedFor = "";

    const L = (k: string, lang: string): string =>
      lang === "uz"
        ? (UZ[k] ?? "")
        : (STRINGS[k]?.[lang as Lang] ?? UZ[k] ?? "");

    const esc = (s: unknown): string =>
      String(s ?? "").replace(
        /[&<>"]/g,
        (c) =>
          ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c] as string,
      );

    function card(plan: any, lang: string): string {
      const want = lang === "uz" ? "UZS" : "USD";
      const popular = plan.name === "Growth" || plan.position === 3;
      const cyclePlans = (plan.prices ?? []).filter(
        (p: any) => p.billingCycle === cycle,
      );
      const price =
        cyclePlans.find(
          (p: any) => (p?.value?.currency || "").toUpperCase() === want,
        ) ??
        cyclePlans[0] ??
        plan.prices?.[0];
      const amount = price?.value?.majorAmount ?? 0;
      const suffix =
        cycle === "monthly"
          ? L("plans.perMonth", lang)
          : L("plans.perYear", lang);
      let display =
        amount === 0
          ? want === "UZS"
            ? "0"
            : "$0"
          : (price?.value?.display ?? "");
      if (want === "UZS")
        display = display.replace(
          /\s*(so'?m|сум|soums?|uzs)\s*$/i,
          "",
        );
      const note =
        amount === 0
          ? `<p class="mt-3 font-geist text-[13px] text-muted">${esc(L("plans.noCard", lang))}</p>`
          : cycle === "yearly"
            ? `<p class="mt-3 font-geist-mono text-[11px] tracking-[0.72px] text-muted">${esc(L("plans.saveNote", lang))}</p>`
            : "";
      const cta =
        amount === 0 ? L("plans.startFree", lang) : L("plans.getStarted", lang);

      const quotas: any[] = Array.isArray(plan.quotas) ? plan.quotas : [];
      const quotaMax = (meter: string): number => {
        const matches = quotas.filter((q) => q?.meter === meter);
        if (!matches.length) return 0;
        return Math.max(...matches.map((q) => Number(q.max) || 0));
      };
      const chip = (label: string, n: number): string =>
        n > 0
          ? `<span class="rounded-full border border-hairline px-2.5 py-1 font-geist-mono text-[10.5px] leading-none tracking-[0.3px] text-muted">${esc(label.replace("{n}", String(n)))}</span>`
          : "";
      const chips = [
        chip(L("plans.locations", lang), quotaMax("location")),
        chip(L("plans.aiPhotos", lang), quotaMax("imageGeneration")),
        chip(L("plans.onlineOrders", lang), quotaMax("order")),
      ]
        .filter(Boolean)
        .join("");

      const feats = (plan.features ?? [])
        .map(
          (f: any) =>
            `<li class="flex items-start gap-2.5"><svg class="mt-[3px] h-3.5 w-3.5 shrink-0 text-link" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="font-geist text-[13.5px] leading-[20px] text-ink/90"${f.description ? ` title="${esc(f.description)}"` : ""}>${esc(f.name)}</span></li>`,
        )
        .join("");

      return `<div class="relative flex flex-col rounded-[20px] border border-hairline bg-card/50 p-6 transition-colors duration-300 hover:border-link/40 ${popular ? "ring-2 ring-accent" : ""}">
        ${popular ? `<span class="absolute -top-3 left-6 rounded-full bg-accent px-3 py-1 font-geist-mono text-[10px] tracking-[0.72px] text-accent-emphasis">${esc(L("plans.popular", lang))}</span>` : ""}
        <p class="font-geist text-[16px] font-medium text-ink">${esc(plan.name)}</p>
        <p class="mt-2 min-h-[36px] font-geist text-[13.5px] leading-[20px] text-muted">${esc(plan.description ?? "")}</p>
        <div class="mt-4 flex items-baseline gap-1.5">
          <span class="font-anton text-[40px] leading-none tracking-tight text-ink">${esc(display)}</span>
          <span class="font-geist-mono text-[11px] tracking-[0.72px] text-muted">${esc(suffix)}</span>
        </div>
        ${note}
        ${chips ? `<div class="mt-4 flex flex-wrap gap-1.5">${chips}</div>` : ""}
        <div class="mt-5 h-px w-full bg-hairline"></div>
        <ul class="mt-5 flex flex-col gap-2.5">${feats}</ul>
        <div class="mt-auto pt-6">
          <button type="button" data-plan-trigger="starter" class="flex h-[44px] w-full items-center justify-center rounded-[99px] ${popular ? "bg-accent text-accent-emphasis hover:bg-accent-active" : "border border-hairline text-ink hover:border-link hover:text-link"} font-geist-mono text-[12px] font-medium tracking-[0.72px] transition-colors duration-[300ms]">${esc(cta)}</button>
        </div>
      </div>`;
    }

    function render(lang: string): void {
      if (!grid) return;
      grid.innerHTML = plans.map((p) => card(p, lang)).join("");
    }

    async function load(): Promise<void> {
      const lang = getLang();
      const apiLang = lang === "tr" ? "en" : lang;
      if (fetchedFor !== apiLang) {
        loading?.classList.remove("hidden");
        try {
          const r = await fetch(
            `${API}/plans.get?lang=${apiLang}${lang === "uz" ? "&currency=UZS" : ""}`,
            {
              cache: "no-store",
              headers: { "Accept-Language": apiLang },
            },
          );
          const j: any = await r.json();
          plans = j.plans ?? [];
          fetchedFor = apiLang;
        } catch {
          plans = [];
        }
        loading?.classList.add("hidden");
      }
      render(lang);
    }

    cycleBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        cycle = btn.getAttribute("data-cycle") as "monthly" | "yearly";
        cycleBtns.forEach((x) => {
          const on = x.getAttribute("data-cycle") === cycle;
          x.classList.toggle("bg-ink", on);
          x.classList.toggle("text-on-ink", on);
          x.classList.toggle("text-muted", !on);
        });
        render(getLang());
      });
    });

    document.addEventListener("langchange", () => void load());
    void load();
  </script>
</Layout>
