---
import Layout from "../layouts/Layout.astro";
import TopNav from "../components/TopNav.astro";
import { apps, imagesFor, imgDims, imgSrcset } from "../data/apps";
import Receipt from "../components/Receipt.astro";
import Mock from "../components/Mock.astro";
import PosHero from "../components/PosHero.astro";
import Features from "../components/Features.astro";
import AppCardMock from "../components/AppCardMock.astro";
import LeadForm from "../components/LeadForm.astro";
import Footer from "../components/Footer.astro";
import trims from "../data/image-trims.json";
import { testimonials, type Testimonial } from "../data/testimonials";
import { has } from "../data/i18n";
import { fetchPlans, renderPlanCards, renderPlanTable, UZ_PLAN_STRINGS } from "../data/plans";

/* Plans are rendered into the HTML at build time (SEO, no loading flash); the
 * browser refreshes them. If the API is down during the build, the page falls
 * back to the client-side fetch as before. */
let ssrPlansHtml = "";
let ssrTableHtml = "";
let ssrOffers: Record<string, unknown>[] = [];
try {
  const plans = await fetchPlans("uz", AbortSignal.timeout(8000));
  const uzL = (k: string) => UZ_PLAN_STRINGS[k] ?? "";
  ssrPlansHtml = renderPlanCards(plans, "uz", "monthly", uzL);
  ssrTableHtml = renderPlanTable(plans, uzL);
  // Offers for the SoftwareApplication structured data (monthly USD prices).
  ssrOffers = plans.map((p: any) => {
    const m = (p.prices ?? []).find((x: any) => x.billingCycle === "monthly");
    return {
      "@type": "Offer",
      name: p.name,
      price: String(m?.value?.majorAmount ?? 0),
      priceCurrency: "USD",
      url: "https://octopos.uz/#plans",
    };
  });
} catch (err) {
  console.warn("[plans] build-time fetch failed, falling back to client:", err);
}

const SITE_URL = "https://octopos.uz";
const homeLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Octopos",
    url: SITE_URL,
    logo: `${SITE_URL}/favicon.ico`,
    email: "support@octopos.uz",
    telephone: "+998941500330",
    sameAs: ["https://t.me/bekzodturgunoff"],
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Octopos",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web, Android, Windows",
    url: SITE_URL,
    ...(ssrOffers.length ? { offers: ssrOffers } : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Octopos",
    url: SITE_URL,
    inLanguage: "uz",
  },
];

// Apps band: the order a ticket travels (guest → till → kitchen → pickup
// screen → reports), then the other till, the own store and delivery.
const appOrder = ["guest", "pos-restaurant", "kitchen", "ods", "dash", "pos-market", "website", "dispatch"];
const bandApps = appOrder.map((slug) => apps.find((a) => a.slug === slug)!).filter(Boolean);

// Placeholders never reach production: Vercel sets VERCEL_ENV at build time.
const showPlaceholders = process.env.VERCEL_ENV !== "production";
const tmCards: (Testimonial | null)[] = testimonials.length ? testimonials.slice(0, 3) : showPlaceholders ? [null, null, null] : [];

const storeTiers = [
  { name: "Start", price: "790 000", n: 1000 },
  { name: "Pro", price: "2 190 000", n: 3000 },
  { name: "Business", price: "3 990 000", n: 6000 },
  { name: "Enterprise", price: "7 490 000", n: 10000 },
];
const photoTiers = [
  { n: 200, price: "149 000" },
  { n: 600, price: "349 000" },
  { n: 1500, price: "690 000" },
];

const fiscalPoints = [
  { n: 1, t: "Qaytarish ham fiskal chek bilan", d: "Har bir qaytarish alohida fiskal chek bilan rasmiylashtiriladi." },
  { n: 2, t: "MXIK va qadoq kodlari", d: "Har bir mahsulotga yoki butun biznesga bir marta belgilanadi." },
  { n: 3, t: "Chekda soliq QR-kodi", d: "Mijoz QR orqali chekni soliq tizimida tekshira oladi." },
  { n: 4, t: "Fiskal kun o'zi yopiladi", d: "Smena yoki ish kuni yopilganda fiskal kun ham yopiladi." },
  { n: 5, t: "Chek yo'qolmaydi", d: "Fiskal modul javob bermasa, chek avtomatik qayta yuboriladi." },
  { n: 6, t: "Xizmat haqi va QQS to'g'ri", d: "Chekda alohida qatorda, soliq talabiga mos ko'rsatiladi." },
];

type ProblemIn = {
  n: number;
  mock?: "void" | "stock" | "shift" | "store";
  receipt?: boolean;
  /** lowest plan that includes this, shown as a pill */
  plan?: string;
  pain: string;
  title: string;
  body: string;
  alt?: string;
};
const problems = ([
  {
    n: 7,
    receipt: true,
    plan: "Starter",
    pain: "Soliq tekshiruvidan xavotirdamisiz?",
    title: "Har bir savdoga fiskal chek, avtomatik",
    body:
      "Octopos fiskal modul bilan ishlaydi: har bir savdo soliq tizimiga avtomatik yuboriladi, kassir qo'shimcha hech narsa qilmaydi. Mijozlarimiz allaqachon shu tarzda ishlayapti.",
  },
  {
    n: 1,
    mock: "void",
    pain: "Kassir cheklarni bekor qilyaptimi?",
    title: "Bekor qilish faqat menejer ruxsati bilan",
    body:
      "Buyurtma yoki taomni bekor qilish uchun menejer tasdig'i kerak. So'rov POS ekraniga va Telegramga keladi: kim, qachon va qaysi sabab bilan so'radi. Rad etsangiz, chek o'zgarmaydi.",
    alt: "RestaurantPOS — bekor qilish so'rovlari",
  },
  {
    n: 2,
    mock: "stock",
    plan: "Growth",
    pain: "Ombordan mahsulot yo'qolyaptimi?",
    title: "Ombordagi har bir gramm hisobda",
    body:
      "Sotilgan har bir taom texnologik karta bo'yicha ombordan chiqariladi. Inventarizatsiyadan keyin farq hisobotida qaysi mahsulot qancha kam chiqqani ko'rinadi. Tugab borayotgan mahsulot haqida Telegramga xabar keladi.",
    alt: "Dash — inventarizatsiya",
  },
  {
    n: 3,
    mock: "shift",
    pain: "Smena oxirida kassa to'g'ri chiqmayaptimi?",
    title: "Har bir smena bitta hisobotda",
    body:
      "Ish kuni yopilganda yalpi savdo, chegirmalar, qaytarishlar, bekor qilinganlar va naqd yoki karta bo'yicha to'lovlar bitta sahifada. Kassaga kiritilgan va olingan naqd pul ham alohida yoziladi.",
    alt: "RestaurantPOS — smena hisoboti",
  },
  {
    n: 6,
    mock: "store",
    pain: "Agregatorlar har buyurtmadan komissiya oladimi?",
    title: "O'z saytingiz va Telegram orqali, komissiyasiz",
    body:
      "Brendingiz bilan onlayn do'kon ochasiz. Buyurtmalar to'g'ridan-to'g'ri kassaga tushadi, Payme va Click orqali to'lanadi, o'z kuryerlaringiz yetkazib beradi.",
    alt: "Store — onlayn do'kon",
  },
] as ProblemIn[]);

const extras = [
  { n: 2, title: "Internet o'chsa savdo to'xtaydimi?", body:
      "Yo'q. Octopos Agent restoraningizdagi kompyuterda ishlaydi: kassalar, printerlar va oshxona ekranlari internetsiz ham bir-biri bilan ishlayveradi. Internet qaytgach hammasi sinxronlanadi." },
  { n: 3, title: "Mijozlar qarzga olyaptimi?", body:
      "Har bir mijozning qarzi va to'lovlari hisobda. Kim qancha qarzdorligi va qarz qachondan beri turgani bitta hisobotda ko'rinadi." },
  { n: 4, title: "Dollar kursi o'zgarsa, narxlarni qayta yozasizmi?", body:
      "Tovarni dollarda narxlang: kassada u kunlik kurs bo'yicha so'mda sotiladi. Kursni kiritasiz, narxlarni qo'lda o'zgartirish shart emas." },
  { n: 5, title: "Menyuni kiritishga kunlar ketadimi?", body:
      "Menyu rasmini yoki oddiy ro'yxatni yuklang (Excel ham bo'ladi). AI taomlar, kategoriyalar va narxlarni mahsulotlar ro'yxatiga qo'shadi va taomlaringiz rasmini ham yaratib beradi: dastlabki 20 ta rasm bepul." },
  { n: 6, title: "Yandex va Uzum'da narx boshqacha bo'lishi kerakmi?", body:
      "Har bir savdo kanali uchun o'z narxi: zal, QR-menyu, sayt, Telegram, Yandex Eats va Uzum Tezkor. Ulgurji mijozlar uchun ham alohida narx ro'yxati." },
  // Guest (QR at the table) + POS floor plan: kdsx-guest landing, kdsx-pos-v2 floor-plan.
  { n: 7, title: "Mijoz ofitsiantni kutib qolyaptimi?", body:
      "Stoldagi QR orqali mijoz telefondan ofitsiantni chaqiradi yoki hisobni so'raydi. Kassadagi zal rejasida o'sha stol qizil qo'ng'iroq bilan belgilanadi." },
];


/** Display text uses the proper Uzbek letters oʻ / gʻ, not a straight apostrophe. */
const uzApos = (t: string) => t.replace(/([oOgG])'/g, "$1ʻ");

const trust = [
  { n: 1, t: "30+ biznes", d: "Restoran va marketlar Octopos bilan ishlaydi",
    icon: '<path d="M3 9l1-5h16l1 5"/><path d="M4 9v11h16V9"/><path d="M3 9a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0"/><path d="M9 20v-6h6v6"/>' },
  { n: 2, t: "1–3 kunda ishga tushirish", d: "Menyu, uskunalar va o'qitish bilan",
    icon: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>' },
  { n: 3, t: "Offline ishlaydi", d: "Internet uzilsa ham savdo davom etadi",
    icon: '<path d="M2 2l20 20"/><path d="M8.5 16.5a5 5 0 0 1 7 0"/><path d="M5 12.9a10 10 0 0 1 5.2-2.7"/><path d="M19 12.9a10 10 0 0 0-2-1.5"/><path d="M2 8.8a15 15 0 0 1 4.2-2.6"/><path d="M22 8.8a15 15 0 0 0-11.3-3.8"/><path d="M12 20h.01"/>' },
  { n: 4, t: "Telegramda 4 tilda yordam", d: "O'zbek, rus, ingliz va koreys tillarida",
    icon: '<path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4z"/>' },
];

const steps = [
  { n: 1, t: "Ro'yxatdan o'ting", d: "Bepul tarifda o'zingiz boshlang yoki Telegramga yozing, biz siz bilan bog'lanamiz." },
  { n: 2, t: "Biz sozlaymiz", d: "Menyu va narxlarni kiritamiz (Excel'dan ham), planshet, printer va kassa tortmasini ulaymiz." },
  { n: 3, t: "Jamoangizni o'rgatamiz", d: "Kassir, ofitsiant va oshpazlarga ko'rsatamiz. Odatda 1–3 kunda to'liq ishlay boshlaysiz." },
];


const payLogos = [
  // `icon`: a square app icon rather than a wordmark, so it needs the name beside it.
  { src: "/payments/payme.webp", alt: "Payme" },
  { src: "/payments/click.webp", alt: "Click" },
  { src: "/integrations/telegram.webp", alt: "Telegram", icon: true },
  { src: "/integrations/uzum-tezkor.webp", alt: "Uzum Tezkor", icon: true },
  { src: "/integrations/yandex-eats.webp", alt: "Yandex Eats", icon: true },
  { src: "/integrations/yandex-go.webp", alt: "Yandex Go", icon: true },
];

const faqs = [
  {
    q: "faq.1q",
    a: "faq.1a",
    uzQ: "Internet uzilsa tizim ishlashda davom etadimi?",
    uzA:
      "Ha. Octopos offline-first ishlaydi: aloqa uzilganda savdo, buyurtmalar va kassa to'xtamaydi, internet qaytgach barcha ma'lumotlar avtomatik sinxronlanadi.",
  },
  {
    q: "faq.2q",
    a: "faq.2a",
    uzQ: "Obuna narxiga nimalar kiradi?",
    uzA:
      "Har bir tarifga barcha yangilanishlar va Telegram orqali yordam kiradi. Funksiyalar tarifga qarab ochiladi: fiskal chek va oshxona ekrani — Starter'dan, ombor, inventarizatsiya va ish haqi — Growth'dan, bir nechta filialni markazdan boshqarish — Scale'da. Qo'shimcha xizmatlar alohida hisoblanadi.",
  },
  {
    q: "faq.3q",
    a: "faq.3a",
    uzQ: "Mening uskunalarim bilan ishlaydimi?",
    uzA:
      "Ha — Android planshetlar, Windows kompyuterlar, ESC/POS printerlar, pul tortmalari va barkod skanerlari bilan mos. To'liq ro'yxat uchun demo so'rang.",
  },
  {
    q: "faq.4q",
    a: "faq.4a",
    uzQ: "Necha kunda ishga tushiramiz?",
    uzA:
      "Odatda 1–3 kun: menyuni kiritamiz, uskunalarni ulaymiz, jamoangizni o'qitamiz. Tarmoqlar uchun alohida reja tuzamiz.",
  },
  {
    q: "faq.5q",
    a: "faq.5a",
    uzQ: "Eski tizimdagi ma'lumotlarni ko'chirish mumkinmi?",
    uzA:
      "Ha — menyu, narxlar va ombor qoldiqlari Excel'dan import qilinadi, o'tish davrida eski tizim bilan parallel ishlash mumkin.",
  },
  {
    q: "faq.6q",
    a: "faq.6a",
    uzQ: "Qanday to'lov usullarini qabul qilamiz?",
    uzA:
      "Naqd, karta, QR, Payme va Click — barchasi avtomatik hisobga olinadi va hisobotlarga tushadi.",
  },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.uzQ,
    acceptedAnswer: { "@type": "Answer", text: f.uzA },
  })),
};
---

<Layout
  title="Octopos — restoran, kafe va do'konlar uchun kassa dasturi"
  description="Kassa dasturi, oshxona ekrani, QR-menyu, onlayn do'kon, ombor va fiskal cheklar bitta tizimda. O'zbekistondagi restoran, kafe va do'konlar uchun. Bepul tarif bor."
  jsonLd={[...homeLd, faqLd]}
>
  <TopNav overHero />

  <main>
    {/* ---------------- hero (forest band) ---------------- */}
    <section class="on-forest">
      <div class="wrap pt-10 pb-10 lg:pt-20 lg:pb-14">
        <h1 class="display display-1 max-w-[1100px]">
          <span data-i18n="hero.t1">Eng yaxshisini ishlating,</span>
          <span class="text-link" data-i18n="hero.t2">boshliq!</span>
        </h1>
        <p class="mt-6 max-w-[600px] font-geist text-[16px] leading-[1.6] text-ink/90 lg:mt-8 lg:text-[18px]" data-i18n="hero.body">
          Kassa, oshxona ekrani, QR-menyu, onlayn do'kon va yetkazib berish
          bitta tizimda. Ombor, soliq cheklari va hisobotlar ham shu yerda.
          Internet uzilsa ham savdo to'xtamaydi.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <button type="button" data-plan-trigger="starter" class="btn-solid btn">
            <span data-i18n="nav.cta">Bepul sinab ko'ring</span>
          </button>
          <a href="#contact" data-lead-jump class="btn-outline btn">
            <span data-i18n="ct.demo">Demo so'rash</span>
          </a>
        </div>
        <p class="mt-5 font-geist text-[14px] leading-[1.5] text-muted" data-i18n="hero.trust">
          Bank kartasi shart emas · 1–3 kunda ishga tushadi · Internetsiz ishlaydi
        </p>
      </div>
    </section>

    {/* Hero visual: the RestaurantPOS order screen, rebuilt in HTML from the
        live app (see PosHero.astro). Sits half on the forest band, half on the page. */}
    <div class="relative">
      <div class="absolute inset-x-0 top-0 h-1/2 bg-forest" aria-hidden="true"></div>
      <div class="wrap relative">
        <PosHero />
      </div>
    </div>
    {/* ---------------- trust row ---------------- */}
    <section class="py-12 lg:py-20">
      <ul class="wrap grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          trust.map((t) => (
            <li class="flex items-start gap-4">
              <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-accent/30 text-link">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={t.icon} />
              </span>
              <span>
                <span class="block font-geist text-[17px] leading-[1.3] font-semibold" data-i18n={`trust.${t.n}t`}>{t.t}</span>
                <span class="mt-1 block font-geist text-[15px] leading-[1.5] text-muted" data-i18n={`trust.${t.n}d`}>{t.d}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    {/* ---------------- problems → solutions ---------------- */}
    <section id="solutions" class="scroll-mt-[72px]">
      <div class="wrap pt-12 pb-12 lg:pt-20 lg:pb-20">
        <h2 class="display display-2 max-w-[900px]" data-i18n="prob.heading">
          Tanish muammolar, tayyor yechimlar
        </h2>
        <p class="mt-5 max-w-[620px] font-geist text-[16px] leading-[1.6] text-muted lg:text-[18px]" data-i18n="prob.body">
          Har kuni kassa yonida turolmaysiz. Octopos har bir chek, har bir
          gramm mahsulot va har bir bekor qilishni yozib boradi.
        </p>
      </div>

      {/* Tax / fiscal receipt: the one full-width row (receipt + fiscal points). */}
      {
        problems.filter((pr) => pr.receipt).map((pr) => (
          <article class="bg-card">
            <div class="wrap py-12 lg:py-16">
              <div class="grid items-center gap-10 lg:grid-cols-[1fr_420px] lg:gap-16">
                <div class="min-w-0">
                  <p class="flex flex-wrap items-center gap-x-3 gap-y-2 font-geist text-[15px] leading-[1.4] font-semibold text-link lg:text-[16px]">
                      <span data-i18n={`prob.${pr.n}p`}>{pr.pain}</span>
                      {pr.plan && (
                        <a
                          href="#plans"
                          class="rounded-full border border-ink/20 px-2.5 py-1 font-geist text-[12px] leading-none font-medium text-muted transition-colors duration-200 ease-out hover:border-ink/50 hover:text-ink focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-accent"
                          data-i18n="prob.planFrom"
                          data-name={pr.plan}
                        >
                          {pr.plan} tarifidan
                        </a>
                      )}
                    </p>
                  <h3 class="display display-3 mt-4" data-i18n={`prob.${pr.n}t`}>{uzApos(pr.title)}</h3>
                  <p class="mt-5 max-w-[560px] font-geist text-[16px] leading-[1.6] text-muted lg:text-[18px]" data-i18n={`prob.${pr.n}d`}>
                    {pr.body}
                  </p>
                <ul class="mt-8 grid gap-x-8 gap-y-4 sm:grid-cols-2">
                  {fiscalPoints.map((f) => (
                    <li class="flex gap-3">
                      <svg class="mt-[3px] h-5 w-5 shrink-0 text-link" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                      <div>
                        <p class="font-geist text-[15px] leading-[1.4] font-semibold" data-i18n={`fisc.${f.n}t`}>{f.t}</p>
                        <p class="mt-0.5 hidden font-geist text-[13.5px] leading-[1.45] text-muted sm:block" data-i18n={`fisc.${f.n}d`}>{f.d}</p>
                      </div>
                    </li>
                  ))}
                </ul>
                </div>
                {/* The full receipt is ~1000px tall: show its top in a window that fades out. */}
                <div class="receipt-window min-w-0 h-[380px] overflow-hidden lg:h-[520px]"><Receipt /></div>
              </div>
            </div>
          </article>
        ))
      }

      {/* The other problems: a 2×2 grid of cards, same text, mock at the bottom. */}
      <div class="wrap pt-14 lg:pt-20">
        <ul class="grid gap-4 lg:grid-cols-2">
          {
            problems.filter((pr) => pr.mock).map((pr) => (
              <li class="card flex flex-col p-6 pb-0 lg:p-10 lg:pb-0">
                {/* Same text height in every card, so the four mock windows start on one line. */}
                <div class="lg:min-h-[270px]">
                  <p class="flex flex-wrap items-center gap-x-3 gap-y-2 font-geist text-[15px] leading-[1.4] font-semibold text-link lg:text-[16px]">
                    <span data-i18n={`prob.${pr.n}p`}>{pr.pain}</span>
                    {pr.plan && (
                      <a
                    href="#plans"
                    class="rounded-full border border-ink/20 px-2.5 py-1 font-geist text-[12px] leading-none font-medium text-muted transition-colors duration-200 ease-out hover:border-ink/50 hover:text-ink focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-accent"
                    data-i18n="prob.planFrom"
                    data-name={pr.plan}
                      >
                    {pr.plan} tarifidan
                      </a>
                    )}
                  </p>
                  <h3 class="display mt-4 text-[30px] leading-[1.02] lg:text-[40px]" data-i18n={`prob.${pr.n}t`}>{uzApos(pr.title)}</h3>
                  <p class="mt-4 max-w-[560px] font-geist text-[16px] leading-[1.6] text-muted" data-i18n={`prob.${pr.n}d`}>
                    {pr.body}
                  </p>
                </div>
                {/* Full mock, never cropped, centred in an equal-height panel. */}
                <div class="mt-8 flex flex-1 items-center justify-center pb-6 lg:min-h-[440px] lg:pb-10"><div class="w-full max-w-[460px]"><Mock kind={pr.mock!} /></div></div>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="wrap pt-4 pb-14 lg:pb-20">
        <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {
            extras.map((x, i) => (
              <li class:list={["card p-6 lg:p-7", i === extras.length - 1 && extras.length % 2 === 1 && "md:col-span-2 lg:col-span-1"]}>
                <h3 class="font-geist text-[20px] leading-[1.3] font-semibold lg:text-[24px]" data-i18n={`prob.x${x.n}t`}>{x.title}</h3>
                <p class="mt-3 max-w-[640px] font-geist text-[16px] leading-[1.6] text-muted" data-i18n={`prob.x${x.n}d`}>{x.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* ---------------- apps (dark band, horizontal cards) ---------------- */}
    <section class="on-forest band overflow-hidden" data-carousel>
      <div class="wrap pt-16 lg:pt-28">
