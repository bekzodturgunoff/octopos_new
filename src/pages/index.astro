  <script>
    // Mobile call bar: show after the hero, hide while the form is on screen.
    (() => {
      const bar = document.querySelector<HTMLElement>("[data-mobile-cta]");
      const hero = document.querySelector("main > section");
      const contact = document.getElementById("contact");
      if (!bar || !hero || !contact) return;
      let pastHero = false;
      let atForm = false;
      const sync = () => bar.classList.toggle("translate-y-full", !pastHero || atForm);
      new IntersectionObserver(([e]) => {
        pastHero = !e.isIntersecting;
        sync();
      }).observe(hero);
      new IntersectionObserver(([e]) => {
        atForm = e.isIntersecting;
        sync();
      }, { threshold: 0.15 }).observe(contact);
    })();

    // "Demo so'rash" / "Qo'ng'iroq so'rash": scroll to the form and focus the name.
    document.querySelectorAll<HTMLAnchorElement>("[data-lead-jump]").forEach((a) =>
      a.addEventListener("click", (e) => {
        const target = document.getElementById("contact");
        if (!target) return;
        e.preventDefault();
        target.scrollIntoView({ behavior: "smooth", block: "start" });
        window.setTimeout(() => document.getElementById("lead-name")?.focus({ preventScroll: true }), 600);
        (window as any).octoTrack?.("lead_open");
      }),
    );

    // Apps carousel: arrows scroll one card; first scroll is tracked once.
    document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((root) => {
      const track = root.querySelector<HTMLElement>("[data-car-track]");
      const prev = root.querySelector<HTMLButtonElement>("[data-car-prev]");
      const next = root.querySelector<HTMLButtonElement>("[data-car-next]");
      if (!track) return;
      const step = () => (track.querySelector("li")?.getBoundingClientRect().width ?? 320) + 16;
      const sync = () => {
        if (prev) prev.disabled = track.scrollLeft < 8;
        if (next) next.disabled = track.scrollLeft + track.clientWidth > track.scrollWidth - 8;
      };
      prev?.addEventListener("click", () => track.scrollBy({ left: -step(), behavior: "smooth" }));
      next?.addEventListener("click", () => track.scrollBy({ left: step(), behavior: "smooth" }));
      let tracked = false;
      track.addEventListener("scroll", () => {
        sync();
        if (!tracked && track.scrollLeft > 40) {
          tracked = true;
          (window as any).octoTrack?.("apps_carousel_scroll");
        }
      }, { passive: true });
      sync();
    });
  </script>

  <script>
    // Aggregator commission vs own online store. Tiers mirror `storeTiers`.
    const TIERS = [
      { name: "Start", price: 790000, n: 1000 },
      { name: "Pro", price: 2190000, n: 3000 },
      { name: "Business", price: 3990000, n: 6000 },
      { name: "Enterprise", price: 7490000, n: 10000 },
    ];
    const fmt = (n: number) => Math.round(n).toLocaleString("ru-RU").replace(/\s/g, " ");
    const num = (el: HTMLInputElement) => Number(el.value.replace(/[^\d.,]/g, "").replace(",", ".")) || 0;
    document.querySelectorAll<HTMLElement>("[data-calc]").forEach((root) => {
      const q = <T extends Element = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
      const orders = q<HTMLInputElement>("[data-calc-orders]");
      const check = q<HTMLInputElement>("[data-calc-check]");
      const rate = q<HTMLInputElement>("[data-calc-rate]");
      // group digits as the owner types: 120000 -> 120 000
      [orders, check].forEach((el) =>
        el.addEventListener("input", () => {
          const d = el.value.replace(/\D/g, "").slice(0, 9);
          el.value = d ? fmt(Number(d)) : "";
        }),
      );
      let tracked = false;
      const update = () => {
        const o = num(orders), c = num(check), r = Math.min(num(rate), 100);
        const ready = o > 0 && c > 0 && r > 0;
        q("[data-calc-empty]").classList.toggle("hidden", ready);
        q("[data-calc-result]").classList.toggle("hidden", !ready);
                if (!ready) return;
        const fee = (o * c * r) / 100;
        const tier = TIERS.find((t) => o <= t.n);
        q("[data-calc-fee]").textContent = fmt(fee);
        q("[data-calc-tier]").textContent = tier ? `(${tier.name})` : "";
        q("[data-calc-cost]").textContent = tier ? fmt(tier.price) : "—";
        const diff = tier ? fee - tier.price : 0;
        q("[data-calc-diff]").textContent = fmt(diff);
        q("[data-calc-save]").classList.toggle("hidden", !tier || diff <= 0);
        q("[data-calc-nosave]").classList.toggle("hidden", !tier || diff > 0);
        q("[data-calc-big]").classList.toggle("hidden", Boolean(tier));
        if (!tracked) {
          tracked = true;
          (window as any).octoTrack?.("calculator_used");
        }
      };
      [orders, check, rate].forEach((el) => el.addEventListener("input", update));
    });
  </script>
  <script>
    import { STRINGS, getLang, type Lang } from "../data/i18n";
    import {
      apiLangFor,
      esc,
      fetchPlans,
      renderPlanCards,
      renderPlanTable,
      UZ_PLAN_STRINGS,
      type Cycle,
    } from "../data/plans";

    const grid = document.getElementById("plans-grid");
    const loading = document.getElementById("plans-loading");
    const cycleBtns = document.querySelectorAll<HTMLElement>("[data-cycle]");

    let cycle: Cycle = "monthly";
    let plans: any[] = [];
    let fetchedFor = "";
    // Build output already shows the Uzbek monthly cards; keep them if the
    // refresh fails rather than replacing them with the Telegram fallback.
    const staticHtml = grid?.innerHTML.trim() ?? "";
    const hasStatic = staticHtml.length > 0;

    const L = (k: string, lang: string): string =>
      lang === "uz"
        ? (UZ_PLAN_STRINGS[k] ?? "")
        : (STRINGS[k]?.[lang as Lang] ?? UZ_PLAN_STRINGS[k] ?? "");

    const table = document.getElementById("plans-table");
    document.querySelector("[data-plan-compare]")?.addEventListener("toggle", (e) => {
      if ((e.currentTarget as HTMLDetailsElement).open) (window as any).octoTrack?.("pricing_table_expand");
    });

    const FALLBACK: Partial<Record<string, string>> = {
      uz: "Narxlarni ko'rish uchun",
      en: "Contact us on Telegram for pricing",
      ru: "Узнать цены в Telegram",
      ko: "텔레그램에서 요금 문의",
      tr: "Fiyatlar için Telegram'dan yazın",
    };

    function render(lang: string): void {
      if (!grid) return;
      if (plans.length === 0) {
        if (hasStatic && cycle === "monthly") {
          grid.innerHTML = staticHtml;
          return;
        }
        const msg = esc(FALLBACK[lang] ?? FALLBACK["en"] ?? "");
        grid.innerHTML = `<p class="col-span-full font-geist text-[16px] leading-[24px] text-muted">${msg} — <a href="https://t.me/bekzodturgunoff" class="text-link hover:underline" target="_blank" rel="noopener">@bekzodturgunoff</a></p>`;
        return;
      }
      grid.innerHTML = renderPlanCards(plans, lang, cycle, (k) => L(k, lang));
      if (table) table.innerHTML = renderPlanTable(plans, (k) => L(k, lang));
    }

    async function load(): Promise<void> {
      const lang = getLang();
      const apiLang = apiLangFor(lang);
      if (fetchedFor !== apiLang) {
        if (!hasStatic) loading?.classList.remove("hidden");
        try {
          plans = await fetchPlans(lang);
          fetchedFor = apiLang;
        } catch {
          plans = [];
        }
        loading?.classList.add("hidden");
      }
      render(lang);
    }

    cycleBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        cycle = btn.getAttribute("data-cycle") as "monthly" | "yearly";
        cycleBtns.forEach((x) => {
          const on = x.getAttribute("data-cycle") === cycle;
          x.classList.toggle("seg-toggle-on", on);
          x.classList.toggle("seg-toggle-off", !on);
          x.setAttribute("aria-pressed", String(on));
        });
        render(getLang());
      });
    });

    document.addEventListener("langchange", () => void load());
    void load();
  </script>
