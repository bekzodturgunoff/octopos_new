---
import Layout from "../../layouts/Layout.astro";
import TopNav from "../../components/TopNav.astro";
import { apps, imagesFor, imgDims, imgSrcset, type App } from "../../data/apps";
import { has } from "../../data/i18n";
import trims from "../../data/image-trims.json";

interface Props {
  app: App;
  images: string[];
}

type Trim = { ar: number; l: number; r: number; t: number; b: number };
const TRIMS = trims as Record<string, Trim>;
const pct = (n: number) => `${(n * 100).toFixed(3)}%`;
function trimStyles(src: string): { wrap?: string; img?: string } {
  const t = TRIMS[src];
  if (!t) return {};
  const hw = 1 - t.l - t.r;
  const hh = 1 - t.t - t.b;
  return {
    wrap: `aspect-ratio:${t.ar}`,
    img: `position:absolute;left:${pct(-t.l / hw)};top:${pct(-t.t / hh)};width:${pct(1 / hw)};height:${pct(1 / hh)};`,
  };
}

export function getStaticPaths() {
  return apps.map((app) => ({
    params: { app: app.slug },
    props: { app, images: imagesFor(app.slug) },
  }));
}

const { app, images } = Astro.props;
const idx = apps.findIndex((a) => a.slug === app.slug);
const next = apps[(idx + 1) % apps.length];

const SITE_URL = "https://octopos.uz";
const appLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: app.name,
    description: app.desc,
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    inLanguage: "uz",
    author: {
      "@type": "Organization",
      name: "Octopos",
      url: SITE_URL,
    },
  },
];

function frameBase(url: string): string {
  const file = url.split("/").pop() ?? "";
  return file.replace(/\.[a-z0-9]+$/i, "");
}

function frameLabel(url: string): string {
  const base = frameBase(url);
  const dict = app.frames?.[base];
  if (dict) return dict;
  const stripped = base.replace(/^[^-]+-/, "");
  const label = (stripped || base).replace(/[-_]+/g, " ").trim();
  return label.charAt(0).toUpperCase() + label.slice(1);
}
---

<Layout title={`${app.name} — Octopos`} description={app.desc} jsonLd={appLd}>
  <TopNav />

  <div
    class="mx-auto max-w-[1600px] px-5 pt-[9px] pb-[140px] lg:px-[32px] lg:pt-[31px] lg:pb-[150px]"
  >
    <div class="flex items-center justify-between gap-4">
      <a
        href="/apps"
        data-i18n={has("common.back") ? "common.back" : undefined}
        class="font-geist-mono text-[12px] leading-4 tracking-[0.72px] text-muted transition-colors duration-[350ms] ease-far hover:text-link"
        >← Ilovalar</a
      >
    </div>

    <div class="mt-10 grid grid-cols-1 gap-y-6 lg:mt-[41px] lg:grid-cols-[460px_1fr] lg:gap-x-16">
      <aside class="self-start lg:sticky lg:top-[110px]">
        <h1
          class="max-w-[440px] font-anton text-[clamp(36px,11vw,52px)] leading-[0.9] tracking-[-0.69px] [overflow-wrap:anywhere] lg:text-[72px]"
        >
          {app.name}
        </h1>

        <div class="mt-[20px] h-px w-full bg-hairline" />

        <p
          class="mt-[20px] font-geist text-[20px] leading-[30px] text-muted"
          data-i18n={`app.${app.slug}.desc`}
        >
          {app.desc}
        </p>

        <dl class="mt-[24px] hidden grid-cols-1 border-t border-hairline sm:grid sm:grid-cols-2">
          {
            app.meta.map((row, i) => {
              const labelKey = `meta.${row.label}`;
              const valueKey = `v.${row.value}`;
              return (
                <div
                  class:list={[
                    "border-b border-hairline py-[10px]",
                    i % 2 === 0 ? "sm:border-r sm:pr-4" : "sm:pl-4",
                  ]}
                >
                  <dt
                    class="font-geist-mono text-[12px] leading-[18px] tracking-[0.72px] text-muted"
                    data-i18n={has(labelKey) ? labelKey : undefined}
                  >
                    {row.label}
                  </dt>
                  <dd
                    class="mt-[2px] font-geist-mono text-[12px] leading-[18px] tracking-[0.72px] text-ink"
                    data-i18n={has(valueKey) ? valueKey : undefined}
                  >
                    {row.value}
                  </dd>
                </div>
              );
            })
          }
          {
            app.meta.length % 2 === 1 && (
              <div class="hidden border-b border-hairline sm:block" aria-hidden="true" />
            )
          }
        </dl>

        {/* Mobile: specs behind an expander. */}
        <details class="mt-[16px] sm:hidden">
          <summary class="btn-outline h-[44px] w-full cursor-pointer list-none px-6 font-geist-mono text-[12px] tracking-[0.72px] [&::-webkit-details-marker]:hidden">
            <span data-i18n={has("common.details") ? "common.details" : undefined}>Tafsilotlar</span>
          </summary>
          <dl class="mt-3 overflow-hidden rounded-2xl border border-hairline">
            {
              app.meta.map((row) => {
                const labelKey = `meta.${row.label}`;
                const valueKey = `v.${row.value}`;
                return (
                  <div class="flex items-baseline justify-between gap-3 border-b border-hairline px-4 py-2.5 last:border-0">
                    <dt
                      class="shrink-0 font-geist-mono text-[12px] leading-[18px] tracking-[0.72px] text-muted"
                      data-i18n={has(labelKey) ? labelKey : undefined}
                    >
                      {row.label}
                    </dt>
                    <dd
                      class="text-right font-geist-mono text-[12px] leading-[18px] tracking-[0.72px] text-ink"
                      data-i18n={has(valueKey) ? valueKey : undefined}
                    >
                      {row.value}
                    </dd>
                  </div>
                );
              })
            }
          </dl>
        </details>

        <div class="mt-[24px] grid grid-cols-2 gap-3">
          <button
            type="button"
            data-plan-trigger="starter"
            class="btn-solid min-h-[44px] w-full px-4 py-2.5 text-center font-geist-mono text-[11px] leading-[1.2] font-medium tracking-[0.4px] sm:text-[12px]"
          >
            <span data-i18n={has("cta.tryFree") ? "cta.tryFree" : undefined}
              >Bepul sinab ko'ring →</span
            >
          </button>
          <a
            href={`/apps/${next.slug}`}
            aria-label={`Keyingi — ${next.name}`}
            class="btn-outline min-h-[44px] w-full px-4 py-2.5 text-center font-geist-mono text-[11px] leading-[1.2] font-medium tracking-[0.4px] sm:text-[12px]"
          >
            <span
              data-i18n={has("cta.next") ? "cta.next" : undefined}
              >Keyingi ›</span
            >
          </a>
        </div>
      </aside>

      <div class="relative min-w-0">
        {
          images.length > 0 ? (
            <>
              <div class="flex flex-col gap-6 lg:gap-[40px]" data-gallery>
                {images.map((src, i) => {
                  const base = frameBase(src);
                  const frameKey = `frame.${app.slug}.${base}`;
                  const useKey = has(frameKey) && app.frames?.[base] != null;
                  const ts = trimStyles(src);
                  const dm = imgDims(src);
                  const ss = imgSrcset(src);
                  return (
                    <figure class={i >= 3 ? "gallery-extra hidden lg:block" : undefined}>
                      <div
                        class="group relative cursor-zoom-in overflow-hidden rounded-2xl"
                        style={ts.wrap}
                        data-lightbox
                      >
                        <img
                          src={src}
                          alt={`${app.name} — ${frameLabel(src)}`}
                          class:list={[
                            "block max-w-none",
                            TRIMS[src] ? "absolute" : "-mt-[3px] w-full h-auto",
                          ]}
                          style={ts.img}
                          width={dm?.w}
                          height={dm?.h}
                          srcset={ss}
                          sizes="(max-width:1023px) calc(100vw - 40px), 1000px"
                          loading={i === 0 ? "eager" : "lazy"}
                          fetchpriority={i === 0 ? "high" : "auto"}
                          decoding="async"
                        />
                        <span
                          aria-hidden="true"
                          class="pointer-events-none absolute top-3 right-3 flex h-9 w-9 items-center justify-center rounded-full bg-black/45 text-white opacity-100 backdrop-blur-sm transition-opacity sm:opacity-0 sm:group-hover:opacity-100"
                        >
                          <svg
                            class="h-4 w-4"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          >
                            <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
                          </svg>
                        </span>
                      </div>
                      <figcaption class="mt-[14px] flex items-baseline justify-between gap-4 font-geist-mono text-[12px] leading-4 tracking-[0.72px]">
                        <span
                          class="text-muted"
                          data-i18n={useKey ? frameKey : undefined}
                        >
                          {frameLabel(src)}
                        </span>
                        <span class="shrink-0 font-medium text-ink">
                          {String(i + 1).padStart(2, "0")} /{" "}
                          {String(images.length).padStart(2, "0")}
                        </span>
                      </figcaption>
                    </figure>
                  );
                })}
              </div>
              {images.length > 3 && (
                <button
                  type="button"
                  data-gallery-more
                  class="btn-outline mt-6 h-[44px] w-full px-6 font-geist-mono text-[12px] tracking-[0.72px] lg:hidden"
                >
                  <span data-i18n={has("common.showAllPhotos") ? "common.showAllPhotos" : undefined}>
                    Barcha rasmlarni ko'rsatish
                  </span>
                </button>
              )}
            </>
          ) : (
            <div class="flex h-[420px] items-center justify-center border border-hairline lg:h-[560px]">
              <span
                class="font-geist-mono text-[12px] tracking-[0.72px] text-muted"
                data-i18n={has("imgPending") ? "imgPending" : undefined}
              >
                Rasmlar tez orada paydo bo'ladi
              </span>
            </div>
          )
        }
      </div>
    </div>
  </div>

  {/* ---------------- mobile sticky trial CTA ---------------- */}
  <div
    class="fixed inset-x-0 bottom-0 z-40 border-t border-hairline bg-page/95 px-5 pt-3 backdrop-blur-md lg:hidden"
    style="padding-bottom:max(0.75rem, env(safe-area-inset-bottom))"
  >
    <button
      type="button"
      data-plan-trigger="starter"
      class="btn-solid h-[48px] w-full px-6 font-geist-mono text-[12px] font-medium tracking-[0.72px]"
    >
      <span data-i18n={has("cta.tryFree") ? "cta.tryFree" : undefined}
        >Bepul sinab ko'ring →</span
      >
    </button>
  </div>

  {/* ---------------- lightbox ---------------- */}
  <div
    id="app-lightbox"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/90"
    role="dialog"
    aria-modal="true"
    aria-label="Rasmni ko'rish"
    data-i18n-attr="aria-label:lightbox.view"
  >
    <div class="absolute inset-x-0 top-0 z-10 flex items-center justify-between gap-3 p-4 sm:p-5">
      <span
        data-lb-count
        class="font-geist-mono text-[12px] tracking-[0.72px] text-white/80"
      >
        01 / 01
      </span>
      <div class="flex items-center gap-3">
        <button
          type="button"
          data-lb-out
          aria-label="Kichiklashtirish"
          data-i18n-attr="aria-label:lightbox.zoomOut"
          class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/25"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="M8 11h6M21 21l-4.3-4.3" /></svg>
        </button>
        <button
          type="button"
          data-lb-in
          aria-label="Kattalashtirish"
          data-i18n-attr="aria-label:lightbox.zoomIn"
          class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/25"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="M11 8v6M8 11h6M21 21l-4.3-4.3" /></svg>
        </button>
        <button
          type="button"
          data-lb-close
          aria-label="Yopish"
          data-i18n-attr="aria-label:lightbox.close"
          class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/25"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
        </button>
      </div>
    </div>
    <button
      type="button"
      data-lb-prev
      aria-label="Oldingi"
      data-i18n-attr="aria-label:lightbox.prev"
      class="absolute top-1/2 left-3 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/25 sm:left-5"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6" /></svg>
    </button>
    <button
      type="button"
      data-lb-next
      aria-label="Keyingi"
      data-i18n-attr="aria-label:lightbox.next"
      class="absolute top-1/2 right-3 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/25 sm:right-5"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
    </button>
    <div
      data-lb-stage
      class="flex h-full w-full items-center justify-center overflow-hidden p-4 pt-20 pb-16 sm:p-10 sm:pt-24 sm:pb-20"
      style="touch-action:none"
    >
      <img
        data-lb-img
        src=""
        alt=""
        draggable="false"
        class="max-h-full max-w-full rounded-lg object-contain shadow-2xl"
      />
    </div>
    <p
      data-lb-cap
      class="absolute inset-x-0 bottom-0 z-10 truncate px-5 pb-4 text-center font-geist-mono text-[12px] tracking-[0.72px] text-white/70"
    ></p>
  </div>

  <script is:inline>
    (function () {
      // Mobile gallery: reveal screenshots past the first three on demand.
      var moreBtn = document.querySelector('[data-gallery-more]');
      if (moreBtn) {
        moreBtn.addEventListener('click', function () {
          var g = document.querySelector('[data-gallery]');
          if (g) {
            g.querySelectorAll('.gallery-extra').forEach(function (el) {
              el.classList.remove('hidden');
            });
          }
          moreBtn.remove();
        });
      }

      var overlay = document.getElementById('app-lightbox');
      if (!overlay) return;
      var stage = overlay.querySelector('[data-lb-stage]');
      var view = overlay.querySelector('[data-lb-img]');
      var countEl = overlay.querySelector('[data-lb-count]');
      var capEl = overlay.querySelector('[data-lb-cap]');
      var btnIn = overlay.querySelector('[data-lb-in]');
      var btnOut = overlay.querySelector('[data-lb-out]');
      var btnClose = overlay.querySelector('[data-lb-close]');
      var btnPrev = overlay.querySelector('[data-lb-prev]');
      var btnNext = overlay.querySelector('[data-lb-next]');
      if (!stage || !view || !btnClose) return;

      var MIN = 1, MAX = 5;
      var els = [];
      var idx = 0;
      var scale = 1, tx = 0, ty = 0;
      var lastFocus = null;

      function collect() {
        els = Array.prototype.slice.call(
          document.querySelectorAll('[data-lightbox] img')
        );
      }

      function pad(n, total) {
        var s = String(n), t = String(total);
        while (s.length < 2) s = '0' + s;
        while (t.length < 2) t = '0' + t;
        return s + ' / ' + t;
      }

      function apply() {
        view.style.transform = 'translate(' + tx + 'px,' + ty + 'px) scale(' + scale + ')';
      }

      function clampPan() {
        if (scale <= 1) { tx = 0; ty = 0; return; }
        var r = view.getBoundingClientRect();
        var sr = stage.getBoundingClientRect();
        var mx = Math.max(0, (r.width - sr.width) / 2 + 60);
        var my = Math.max(0, (r.height - sr.height) / 2 + 60);
        if (tx > mx) tx = mx; else if (tx < -mx) tx = -mx;
        if (ty > my) ty = my; else if (ty < -my) ty = -my;
      }

      function setScale(ns, cx, cy) {
        ns = Math.min(MAX, Math.max(MIN, ns));
        if (ns === scale) return;
        var r = view.getBoundingClientRect();
        var k = ns / scale;
        var ccx = r.left + r.width / 2;
        var ccy = r.top + r.height / 2;
        tx += (cx - ccx) * (1 - k);
        ty += (cy - ccy) * (1 - k);
        scale = ns;
        clampPan();
        apply();
      }

      function zoomCenter(f) {
        var r = stage.getBoundingClientRect();
        setScale(scale * f, r.left + r.width / 2, r.top + r.height / 2);
      }

      function reset() {
        scale = 1; tx = 0; ty = 0;
        apply();
      }

      function render() {
        var el = els[idx];
        if (!el) return;
        view.setAttribute('src', el.getAttribute('src') || '');
        view.setAttribute('alt', el.getAttribute('alt') || '');
        if (capEl) capEl.textContent = el.getAttribute('alt') || '';
        if (countEl) countEl.textContent = pad(idx + 1, els.length);
        reset();
      }

      function show(i) {
        if (!els.length) return;
        idx = (i + els.length) % els.length;
        render();
      }

      function open(i) {
        collect();
        if (!els.length) return;
        lastFocus = document.activeElement;
        overlay.classList.remove('hidden');
        overlay.classList.add('flex');
        document.documentElement.style.overflow = 'hidden';
        document.body.style.overflow = 'hidden';
        show(i);
        if (btnClose.focus) btnClose.focus();
      }

      function close() {
        overlay.classList.add('hidden');
        overlay.classList.remove('flex');
        document.documentElement.style.overflow = '';
        document.body.style.overflow = '';
        if (lastFocus && lastFocus.focus) {
          try { lastFocus.focus(); } catch (_) {}
        }
      }

      function isOpen() {
        return !overlay.classList.contains('hidden');
      }

      document.addEventListener('click', function (e) {
        var t = e.target && e.target.closest ? e.target.closest('[data-lightbox]') : null;
        if (!t || isOpen()) return;
        e.preventDefault();
        collect();
        var img = t.tagName === 'IMG' ? t : t.querySelector('img');
        var i = img ? els.indexOf(img) : -1;
        open(i < 0 ? 0 : i);
      });

      btnClose.addEventListener('click', function (e) {
        e.stopPropagation();
        close();
      });
      var downX = 0, downY = 0, dragged = false;
      stage.addEventListener('click', function (e) {
        if (dragged) { dragged = false; return; }
        if (e.target === stage) close();
      });
      if (btnIn) btnIn.addEventListener('click', function (e) { e.stopPropagation(); zoomCenter(1.4); });
      if (btnOut) btnOut.addEventListener('click', function (e) { e.stopPropagation(); zoomCenter(1 / 1.4); });
      if (btnPrev) btnPrev.addEventListener('click', function (e) { e.stopPropagation(); show(idx - 1); });
      if (btnNext) btnNext.addEventListener('click', function (e) { e.stopPropagation(); show(idx + 1); });

      document.addEventListener('keydown', function (e) {
        if (!isOpen()) return;
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowLeft') show(idx - 1);
        else if (e.key === 'ArrowRight') show(idx + 1);
        else if (e.key === '+' || e.key === '=') zoomCenter(1.4);
        else if (e.key === '-' || e.key === '_') zoomCenter(1 / 1.4);
      });

      stage.addEventListener('wheel', function (e) {
        if (!isOpen()) return;
        e.preventDefault();
        setScale(scale * (e.deltaY < 0 ? 1.2 : 1 / 1.2), e.clientX, e.clientY);
      }, { passive: false });

      view.addEventListener('dblclick', function (e) {
        e.preventDefault();
        if (scale > 1.2) { reset(); }
        else { setScale(2.4, e.clientX, e.clientY); }
      });

      var pointers = {};
      var lastDist = 0, lastMid = null;

      function midOf(a, b) {
        return { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 };
      }
      function distOf(a, b) {
        return Math.hypot(a.x - b.x, a.y - b.y);
      }

      stage.addEventListener('pointerdown', function (e) {
        if (!isOpen()) return;
        try { stage.setPointerCapture(e.pointerId); } catch (_) {}
        downX = e.clientX; downY = e.clientY; dragged = false;
        pointers[e.pointerId] = { x: e.clientX, y: e.clientY };
        var keys = Object.keys(pointers);
        if (keys.length === 2) {
          var p = keys.map(function (k) { return pointers[k]; });
          lastDist = distOf(p[0], p[1]);
          lastMid = midOf(p[0], p[1]);
        }
      });

      stage.addEventListener('pointermove', function (e) {
        if (!isOpen() || !pointers[e.pointerId]) return;
        var prev = pointers[e.pointerId];
        var cur = { x: e.clientX, y: e.clientY };
        pointers[e.pointerId] = cur;
        if (Math.hypot(cur.x - downX, cur.y - downY) > 8) dragged = true;
        var keys = Object.keys(pointers);
        if (keys.length === 2) {
          var p = keys.map(function (k) { return pointers[k]; });
          var d = distOf(p[0], p[1]);
          var m = midOf(p[0], p[1]);
          if (lastDist > 0 && d > 0) {
            setScale(scale * (d / lastDist), m.x, m.y);
            tx += m.x - lastMid.x;
            ty += m.y - lastMid.y;
            clampPan();
            apply();
          }
          lastDist = d;
          lastMid = m;
        } else if (keys.length === 1 && scale > 1) {
          tx += cur.x - prev.x;
          ty += cur.y - prev.y;
          clampPan();
          apply();
        }
      });

      function endPointer(e) {
        delete pointers[e.pointerId];
        if (Object.keys(pointers).length < 2) { lastDist = 0; lastMid = null; }
      }
      stage.addEventListener('pointerup', endPointer);
      stage.addEventListener('pointercancel', endPointer);

      window.addEventListener('resize', function () {
        if (isOpen()) { clampPan(); apply(); }
      });
    })();
  </script>
</Layout>
