---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import TopNav from "../../components/TopNav.astro";
import { apps, imagesFor, imgDims, imgSrcset, type App } from "../../data/apps";
import { has } from "../../data/i18n";

interface Props {
  app: App;
  images: string[];
}

export function getStaticPaths() {
  return apps.map((app) => ({
    params: { app: app.slug },
    props: { app, images: imagesFor(app.slug) },
  }));
}

const { app, images } = Astro.props;
const idx = apps.findIndex((a) => a.slug === app.slug);
const next = apps[(idx + 1) % apps.length];
const ogImage = images[0] ? `https://octopos.uz${images[0]}` : undefined;

const SITE_URL = "https://octopos.uz";
const appLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: app.name,
    description: app.desc,
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    inLanguage: "uz",
    author: {
      "@type": "Organization",
      name: "Octopos",
      url: SITE_URL,
    },
  },
];

function frameBase(url: string): string {
  const file = url.split("/").pop() ?? "";
  return file.replace(/\.[a-z0-9]+$/i, "");
}

function frameLabel(url: string): string {
  const base = frameBase(url);
  const dict = app.frames?.[base];
  if (dict) return dict;
  const stripped = base.replace(/^[^-]+-/, "");
  const label = (stripped || base).replace(/[-_]+/g, " ").trim();
  return label.charAt(0).toUpperCase() + label.slice(1);
}
---

<Layout title={`${app.name} — Octopos`} description={app.desc} jsonLd={appLd} ogImage={ogImage}>
  <TopNav />

  {/* ---------------- hero: forest band, name + one line + CTA, then the main visual ---------------- */}
  <section class="on-forest band mt-2">
    <div class="wrap pt-8 pb-10 lg:pt-12 lg:pb-14">
      <a
        href="/apps"
        data-i18n={has("common.back") ? "common.back" : undefined}
        class="rounded font-geist text-[14px] leading-5 font-medium text-muted transition-colors duration-200 ease-out hover:text-ink focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-accent"
        >← Ilovalar</a
      >
      <div class="mt-8 grid items-end gap-8 lg:mt-10 lg:grid-cols-[1fr_auto]">
        <div class="max-w-[720px]">
          <p class="flex items-center gap-3 font-geist text-[15px] font-medium text-muted">
            <span class="tabular-nums">{app.no}</span>
            <span data-i18n={has(`v.${app.tur}`) ? `v.${app.tur}` : undefined}>{app.tur}</span>
            {app.soon && <span class="rounded-full bg-accent px-3 py-1 text-[13px] font-semibold text-accent-emphasis" data-i18n="app.soon">Tez orada</span>}
          </p>
          <h1 class="display display-1 mt-3 [overflow-wrap:anywhere]">{app.name}</h1>
          <p class="mt-5 font-geist text-[17px] leading-[1.6] text-ink/90 lg:text-[20px]" data-i18n={`app.${app.slug}.desc`}>{app.desc}</p>
        </div>
        <div class="flex flex-wrap gap-3">
          {app.soon ? (
            <span class="btn-outline btn pointer-events-none opacity-70" aria-disabled="true"><span data-i18n="app.soon">Tez orada</span></span>
          ) : (
            <button type="button" data-plan-trigger="starter" class="btn-solid btn">
              <span data-i18n={has("cta.tryFree") ? "cta.tryFree" : undefined}>Bepul sinab ko'ring →</span>
            </button>
          )}
          <a href={`/apps/${next.slug}`} aria-label={`Keyingi — ${next.name}`} class="btn-outline btn">
            <span data-i18n={has("cta.next") ? "cta.next" : undefined}>Keyingi ›</span>
          </a>
        </div>
      </div>

      {/* Main visual: the first screen, full width, shown whole. */}
      {images[0] && (() => {
        const src = images[0];
        const dm = imgDims(src);
        const portrait = !!dm && dm.h > dm.w;
        return (
          <div
            class:list={["group relative mt-10 cursor-zoom-in overflow-hidden rounded-[20px] bg-card lg:mt-14", portrait && "mx-auto max-w-[360px]"]}
            data-lightbox
          >
            <img
              src={src}
              alt={`${app.name} — ${frameLabel(src)}`}
              class="block h-auto w-full"
              width={dm?.w}
              height={dm?.h}
              srcset={imgSrcset(src)}
              sizes="(max-width:1279px) 100vw, 1184px"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        );
      })()}
    </div>
  </section>

  {/* ---------------- what it does: feature cards ---------------- */}
  <section class="section">
    <div class="wrap">
      <h2 class="display display-2 max-w-[760px]" data-i18n="app.whatItDoes">Nima qila oladi</h2>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:mt-14 lg:grid-cols-3">
        {
          app.features.map((f, i) => (
            <li class="card flex flex-col gap-4 p-6 lg:p-8">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-accent font-geist text-[14px] font-semibold text-accent-emphasis tabular-nums">
                {String(i + 1).padStart(2, "0")}
              </span>
              <p class="font-geist text-[18px] leading-[1.4] font-semibold" data-i18n={`feat.${app.slug}.${i}`}>{f}</p>
            </li>
          ))
        }
      </ul>

      {/* Specs: one compact table */}
      <dl class="mt-4 grid overflow-hidden rounded-[24px] border border-ink/10 sm:grid-cols-2 lg:grid-cols-4">
        {
          app.meta.map((row) => {
            const labelKey = `meta.${row.label}`;
            const valueKey = `v.${row.value}`;
            return (
              <div class="border-b border-ink/10 px-6 py-5 sm:border-r">
                <dt class="font-geist text-[13px] leading-[1.4] text-muted" data-i18n={has(labelKey) ? labelKey : undefined}>{row.label}</dt>
                <dd class="mt-1 font-geist text-[16px] leading-[1.4] font-medium" data-i18n={has(valueKey) ? valueKey : undefined}>{row.value}</dd>
              </div>
            );
          })
        }
      </dl>
    </div>
  </section>

  {/* ---------------- screens: horizontal carousel, every screenshot ---------------- */}
  {images.length > 1 && (
    <section class="pb-24 lg:pb-32" data-shots>
      <div class="wrap flex items-end justify-between gap-6">
        <h2 class="display display-2" data-i18n="app.screens">Ekranlar</h2>
        <div class="hidden shrink-0 gap-2 lg:flex">
          <button type="button" data-shots-prev aria-label="Oldingi" data-i18n-attr="aria-label:car.prev" class="flex h-12 w-12 items-center justify-center rounded-full border border-ink/30 text-ink transition-colors duration-200 ease-out hover:border-ink focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-accent">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
          </button>
          <button type="button" data-shots-next aria-label="Keyingi" data-i18n-attr="aria-label:car.next" class="flex h-12 w-12 items-center justify-center rounded-full bg-accent text-accent-emphasis transition-colors duration-200 ease-out hover:bg-accent-active focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-accent">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
          </button>
        </div>
      </div>
      <ul data-shots-track tabindex="0" aria-label="Ekranlar" data-i18n-attr="aria-label:app.screens" class="car-track mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-4 lg:mt-12 focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-accent">
        {
          images.slice(1).map((src, k) => {
            const i = k + 1;
            const base = frameBase(src);
            const frameKey = `frame.${app.slug}.${base}`;
            const useKey = has(frameKey) && app.frames?.[base] != null;
            const dm = imgDims(src);
            const portrait = !!dm && dm.h > dm.w;
            return (
              <li class:list={["shrink-0 snap-start", portrait ? "w-[52vw] max-w-[240px]" : "w-[86vw] max-w-[640px]"]}>
                <figure>
                  <div class="group relative cursor-zoom-in overflow-hidden rounded-[16px] bg-card" data-lightbox>
                    <img
                      src={src}
                      alt={`${app.name} — ${frameLabel(src)}`}
                      class="block h-auto w-full"
                      width={dm?.w}
                      height={dm?.h}
                      srcset={imgSrcset(src)}
                      sizes="640px"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <figcaption class="mt-3 flex items-baseline justify-between gap-4 font-geist text-[14px] leading-5">
                    <span class="text-muted" data-i18n={useKey ? frameKey : undefined}>{frameLabel(src)}</span>
                    <span class="shrink-0 font-medium tabular-nums">{String(i + 1).padStart(2, "0")} / {String(images.length).padStart(2, "0")}</span>
                  </figcaption>
                </figure>
              </li>
            );
          })
        }
      </ul>
    </section>
  )}
  {images.length === 0 && (
    <div class="wrap pb-24">
      <div class="card flex h-[360px] items-center justify-center">
        <span class="font-geist text-[15px] text-muted" data-i18n={has("imgPending") ? "imgPending" : undefined}>Rasmlar tez orada paydo bo'ladi</span>
      </div>
    </div>
  )}

  <Footer mobileBar />

  {/* ---------------- mobile sticky trial CTA ---------------- */}
  {!app.soon && <div
    class="fixed inset-x-0 bottom-0 z-40 border-t border-ink/10 bg-page/95 px-4 pt-3 backdrop-blur md:backdrop-blur-md lg:hidden"
    style="padding-bottom:max(0.75rem, env(safe-area-inset-bottom))"
  >
    <button
      type="button"
      data-plan-trigger="starter"
      class="btn-solid btn w-full"
    >
      <span data-i18n={has("cta.tryFree") ? "cta.tryFree" : undefined}
        >Bepul sinab ko'ring →</span
      >
    </button>
  </div>}

  {/* ---------------- lightbox ---------------- */}
  <div
    id="app-lightbox"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/90"
    role="dialog"
    aria-modal="true"
    aria-label="Rasmni ko'rish"
    data-i18n-attr="aria-label:lightbox.view"
  >
    <div class="absolute inset-x-0 top-0 z-10 flex items-center justify-between gap-3 p-4 sm:p-5">
      <span
        data-lb-count
        class="font-geist-mono text-[12px] tracking-[0.72px] text-white/80"
      >
        01 / 01
      </span>
      <div class="flex items-center gap-3">
        <button
          type="button"
          data-lb-out
          aria-label="Kichiklashtirish"
          data-i18n-attr="aria-label:lightbox.zoomOut"
          class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/25"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="M8 11h6M21 21l-4.3-4.3" /></svg>
        </button>
        <button
          type="button"
          data-lb-in
          aria-label="Kattalashtirish"
          data-i18n-attr="aria-label:lightbox.zoomIn"
          class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/25"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="M11 8v6M8 11h6M21 21l-4.3-4.3" /></svg>
        </button>
        <button
          type="button"
          data-lb-close
          aria-label="Yopish"
          data-i18n-attr="aria-label:lightbox.close"
          class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/25"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
        </button>
      </div>
    </div>
    <button
      type="button"
      data-lb-prev
      aria-label="Oldingi"
      data-i18n-attr="aria-label:lightbox.prev"
      class="absolute top-1/2 left-3 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/25 sm:left-5"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6" /></svg>
    </button>
    <button
      type="button"
      data-lb-next
      aria-label="Keyingi"
      data-i18n-attr="aria-label:lightbox.next"
      class="absolute top-1/2 right-3 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/25 sm:right-5"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
    </button>
    <div
      data-lb-stage
      class="flex h-full w-full items-center justify-center overflow-hidden p-4 pt-20 pb-16 sm:p-10 sm:pt-24 sm:pb-20"
      style="touch-action:none"
    >
      <img
        data-lb-img
        src=""
        alt=""
        draggable="false"
        class="max-h-full max-w-full rounded-lg object-contain shadow-2xl"
      />
    </div>
    <p
      data-lb-cap
      class="absolute inset-x-0 bottom-0 z-10 truncate px-5 pb-4 text-center font-geist-mono text-[12px] tracking-[0.72px] text-white/70"
    ></p>
  </div>

  <script is:inline>
    (function () {
      // Screens carousel: arrow buttons scroll by one card.
      var track = document.querySelector('[data-shots-track]');
      if (track) {
        var step = function (dir) {
          var card = track.querySelector('li');
          var w = card ? card.getBoundingClientRect().width + 16 : 400;
          track.scrollBy({ left: dir * w, behavior: 'smooth' });
        };
        var p = document.querySelector('[data-shots-prev]');
        var n = document.querySelector('[data-shots-next]');
        if (p) p.addEventListener('click', function () { step(-1); });
        if (n) n.addEventListener('click', function () { step(1); });
      }

      var overlay = document.getElementById('app-lightbox');
      if (!overlay) return;
      var stage = overlay.querySelector('[data-lb-stage]');
      var view = overlay.querySelector('[data-lb-img]');
      var countEl = overlay.querySelector('[data-lb-count]');
      var capEl = overlay.querySelector('[data-lb-cap]');
      var btnIn = overlay.querySelector('[data-lb-in]');
      var btnOut = overlay.querySelector('[data-lb-out]');
      var btnClose = overlay.querySelector('[data-lb-close]');
      var btnPrev = overlay.querySelector('[data-lb-prev]');
      var btnNext = overlay.querySelector('[data-lb-next]');
      if (!stage || !view || !btnClose) return;

      var MIN = 1, MAX = 5;
      var els = [];
      var idx = 0;
      var scale = 1, tx = 0, ty = 0;
      var lastFocus = null;

      function collect() {
        els = Array.prototype.slice.call(
          document.querySelectorAll('[data-lightbox] img')
        );
      }

      function pad(n, total) {
        var s = String(n), t = String(total);
        while (s.length < 2) s = '0' + s;
        while (t.length < 2) t = '0' + t;
        return s + ' / ' + t;
      }

      function apply() {
        view.style.transform = 'translate(' + tx + 'px,' + ty + 'px) scale(' + scale + ')';
      }

      function clampPan() {
        if (scale <= 1) { tx = 0; ty = 0; return; }
        var r = view.getBoundingClientRect();
        var sr = stage.getBoundingClientRect();
        var mx = Math.max(0, (r.width - sr.width) / 2 + 60);
        var my = Math.max(0, (r.height - sr.height) / 2 + 60);
        if (tx > mx) tx = mx; else if (tx < -mx) tx = -mx;
        if (ty > my) ty = my; else if (ty < -my) ty = -my;
      }

      function setScale(ns, cx, cy) {
        ns = Math.min(MAX, Math.max(MIN, ns));
        if (ns === scale) return;
        var r = view.getBoundingClientRect();
        var k = ns / scale;
        var ccx = r.left + r.width / 2;
        var ccy = r.top + r.height / 2;
        tx += (cx - ccx) * (1 - k);
        ty += (cy - ccy) * (1 - k);
        scale = ns;
        clampPan();
        apply();
      }

      function zoomCenter(f) {
        var r = stage.getBoundingClientRect();
        setScale(scale * f, r.left + r.width / 2, r.top + r.height / 2);
      }

      function reset() {
        scale = 1; tx = 0; ty = 0;
        apply();
      }

      function render() {
        var el = els[idx];
        if (!el) return;
        view.setAttribute('src', el.getAttribute('src') || '');
        view.setAttribute('alt', el.getAttribute('alt') || '');
        if (capEl) capEl.textContent = el.getAttribute('alt') || '';
        if (countEl) countEl.textContent = pad(idx + 1, els.length);
        reset();
      }

      function show(i) {
        if (!els.length) return;
        idx = (i + els.length) % els.length;
        render();
      }

      function open(i) {
        collect();
        if (!els.length) return;
        lastFocus = document.activeElement;
        overlay.classList.remove('hidden');
        overlay.classList.add('flex');
        document.documentElement.style.overflow = 'hidden';
        document.body.style.overflow = 'hidden';
        show(i);
        if (btnClose.focus) btnClose.focus();
      }

      function close() {
        overlay.classList.add('hidden');
        overlay.classList.remove('flex');
        document.documentElement.style.overflow = '';
        document.body.style.overflow = '';
        if (lastFocus && lastFocus.focus) {
          try { lastFocus.focus(); } catch (_) {}
        }
      }

      function isOpen() {
        return !overlay.classList.contains('hidden');
      }

      document.addEventListener('click', function (e) {
        var t = e.target && e.target.closest ? e.target.closest('[data-lightbox]') : null;
        if (!t || isOpen()) return;
        e.preventDefault();
        collect();
        var img = t.tagName === 'IMG' ? t : t.querySelector('img');
        var i = img ? els.indexOf(img) : -1;
        open(i < 0 ? 0 : i);
      });

      btnClose.addEventListener('click', function (e) {
        e.stopPropagation();
        close();
      });
      var downX = 0, downY = 0, dragged = false;
      stage.addEventListener('click', function (e) {
        if (dragged) { dragged = false; return; }
        if (e.target === stage) close();
      });
      if (btnIn) btnIn.addEventListener('click', function (e) { e.stopPropagation(); zoomCenter(1.4); });
      if (btnOut) btnOut.addEventListener('click', function (e) { e.stopPropagation(); zoomCenter(1 / 1.4); });
      if (btnPrev) btnPrev.addEventListener('click', function (e) { e.stopPropagation(); show(idx - 1); });
      if (btnNext) btnNext.addEventListener('click', function (e) { e.stopPropagation(); show(idx + 1); });

      document.addEventListener('keydown', function (e) {
        if (!isOpen()) return;
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowLeft') show(idx - 1);
        else if (e.key === 'ArrowRight') show(idx + 1);
        else if (e.key === '+' || e.key === '=') zoomCenter(1.4);
        else if (e.key === '-' || e.key === '_') zoomCenter(1 / 1.4);
      });

      stage.addEventListener('wheel', function (e) {
        if (!isOpen()) return;
        e.preventDefault();
        setScale(scale * (e.deltaY < 0 ? 1.2 : 1 / 1.2), e.clientX, e.clientY);
      }, { passive: false });

      view.addEventListener('dblclick', function (e) {
        e.preventDefault();
        if (scale > 1.2) { reset(); }
        else { setScale(2.4, e.clientX, e.clientY); }
      });

      var pointers = {};
      var lastDist = 0, lastMid = null;

      function midOf(a, b) {
        return { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 };
      }
      function distOf(a, b) {
        return Math.hypot(a.x - b.x, a.y - b.y);
      }

      stage.addEventListener('pointerdown', function (e) {
        if (!isOpen()) return;
        try { stage.setPointerCapture(e.pointerId); } catch (_) {}
        downX = e.clientX; downY = e.clientY; dragged = false;
        pointers[e.pointerId] = { x: e.clientX, y: e.clientY };
        var keys = Object.keys(pointers);
        if (keys.length === 2) {
          var p = keys.map(function (k) { return pointers[k]; });
          lastDist = distOf(p[0], p[1]);
          lastMid = midOf(p[0], p[1]);
        }
      });

      stage.addEventListener('pointermove', function (e) {
        if (!isOpen() || !pointers[e.pointerId]) return;
        var prev = pointers[e.pointerId];
        var cur = { x: e.clientX, y: e.clientY };
        pointers[e.pointerId] = cur;
        if (Math.hypot(cur.x - downX, cur.y - downY) > 8) dragged = true;
        var keys = Object.keys(pointers);
        if (keys.length === 2) {
          var p = keys.map(function (k) { return pointers[k]; });
          var d = distOf(p[0], p[1]);
          var m = midOf(p[0], p[1]);
          if (lastDist > 0 && d > 0) {
            setScale(scale * (d / lastDist), m.x, m.y);
            tx += m.x - lastMid.x;
            ty += m.y - lastMid.y;
            clampPan();
            apply();
          }
          lastDist = d;
          lastMid = m;
        } else if (keys.length === 1 && scale > 1) {
          tx += cur.x - prev.x;
          ty += cur.y - prev.y;
          clampPan();
          apply();
        }
      });

      function endPointer(e) {
        delete pointers[e.pointerId];
        if (Object.keys(pointers).length < 2) { lastDist = 0; lastMid = null; }
      }
      stage.addEventListener('pointerup', endPointer);
      stage.addEventListener('pointercancel', endPointer);

      window.addEventListener('resize', function () {
        if (isOpen()) { clampPan(); apply(); }
      });
    })();
  </script>
</Layout>
