---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import TopNav from "../../components/TopNav.astro";
import AppCardMock from "../../components/AppCardMock.astro";
import { apps } from "../../data/apps";
import { has } from "../../data/i18n";

---

<Layout
  title="Ilovalar — Octopos"
  description="Octopos ekotizimidagi sakkizta ilova: POS, KDS, boshqaruv paneli, QR-menyu, veb-do'kon va kuryerlar boshqaruvi."
>
  <TopNav overHero />

  <main>
    {/* ---------------- hero (forest band) ---------------- */}
    <section class="on-forest">
      <div class="wrap pt-10 pb-14 lg:pt-20 lg:pb-20">
        <h1 class="display display-1" data-i18n="nav.apps">Ilovalar</h1>
        <p
          class="mt-6 max-w-[560px] font-geist text-[16px] leading-[1.6] text-ink/90 lg:text-[18px]"
          data-i18n="apps.body"
        >
          Sakkizta ilova, yagona sinxron tizim. Ilova sahifasini ochish uchun
          kartani bosing.
        </p>
      </div>
    </section>

    {/* ---------------- app tiles ---------------- */}
    <section class="section">
      <div class="wrap">
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            apps.map((app, i) => {
              return (
                <li>
                  <a
                    href={`/apps/${app.slug}`}
                    class="card group flex h-full flex-col overflow-hidden transition-colors duration-200 ease-out hover:bg-[color-mix(in_oklab,var(--color-card)_88%,white)] focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-accent"
                  >
                    <div class="p-6 lg:p-8">
                      <p class="font-geist text-[14px] font-medium text-muted tabular-nums">
                        {String(i + 1).padStart(2, "0")}
                      </p>
                      <h2 class="mt-3 font-geist text-[24px] leading-[1.2] font-semibold lg:text-[28px]">
                        {app.name}
                        {app.soon && <span class="ml-2 inline-flex translate-y-[-3px] rounded-full bg-accent px-2.5 py-0.5 align-middle font-geist text-[12px] font-semibold text-accent-emphasis" data-i18n="app.soon">Tez orada</span>}
                      </h2>
                      <p
                        class="mt-1.5 font-geist text-[16px] leading-[1.5] text-muted"
                        data-i18n={has(`v.${app.tur}`) ? `v.${app.tur}` : undefined}
                      >
                        {app.tur}
                      </p>
                    </div>
                    <div class="mt-auto px-6 lg:px-8">
                      <AppCardMock slug={app.slug} />
                    </div>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
