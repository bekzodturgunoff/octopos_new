---
import Layout from "../../layouts/Layout.astro";
import TopNav from "../../components/TopNav.astro";
import AppIcon from "../../components/AppIcon.astro";
import { apps } from "../../data/apps";
import { has } from "../../data/i18n";
---

<Layout
  title="Ilovalar — Octopos"
  description="Octopos ekotizimidagi sakkizta ilova: POS, KDS, dashbord, QR menyu, veb-do'kon va kuryer."
>
  <TopNav />

  <div class="px-5 pt-[34px] pb-[120px] lg:px-[32px] lg:pt-[47px] lg:pb-[150px]">
    <div>
      <h1
        class="font-anton text-[84px] leading-[0.84] tracking-[-0.69px] lg:text-[138px]"
        data-i18n="nav.apps"
      >
        Ilovalar
      </h1>

      <p
        class="mt-[30px] max-w-[400px] font-geist text-[13.5px] leading-[21px] text-muted"
        data-i18n="apps.body"
      >
        Sakkizta ilova, bitta sinxron tizim. Kartani bosing — ilova sahifasi
        ochiladi.
      </p>

      <div class="mt-[40px] grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-3">
        {
          apps.map((app) => (
            <a
              href={`/apps/${app.slug}`}
              class="group flex items-center gap-4 rounded-2xl border border-hairline bg-card/40 p-5 transition-colors duration-300 hover:border-link/40"
            >
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-ink text-on-ink">
                <AppIcon slug={app.slug} class="h-6 w-6" />
              </span>
              <span class="min-w-0 flex-1">
                <span class="block font-geist-mono text-[11px] leading-4 tracking-[0.72px] text-muted">
                  {app.no} ·{" "}
                  <span data-i18n={has(`v.${app.tur}`) ? `v.${app.tur}` : undefined}>
                    {app.tur}
                  </span>
                </span>
                <span class="mt-0.5 block truncate font-inter text-[17px] leading-[1.3] font-medium text-ink">
                  {app.name}
                </span>
              </span>
              <span
                class="shrink-0 font-geist-mono text-[12px] leading-4 tracking-[0.72px] text-muted transition-transform duration-300 ease-far group-hover:translate-x-0.5"
                aria-hidden="true"
              >
                →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</Layout>
