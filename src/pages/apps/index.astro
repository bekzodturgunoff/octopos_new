---
import Layout from "../../layouts/Layout.astro";
import TopNav from "../../components/TopNav.astro";
import AppIcon from "../../components/AppIcon.astro";
import { apps, imagesFor } from "../../data/apps";
import { has } from "../../data/i18n";
---

<Layout
  title="Ilovalar — Octopos"
  description="Octopos ekotizimidagi sakkizta ilova: POS, KDS, boshqaruv paneli, QR-menyu, veb-do'kon va kuryerlar boshqaruvi."
>
  <TopNav />

  <div class="px-5 pt-[17px] pb-[60px] lg:px-[32px] lg:pt-[47px] lg:pb-[150px]">
    <div>
      <h1
        class="font-anton text-[84px] leading-[0.84] tracking-[-0.69px] lg:text-[138px]"
        data-i18n="nav.apps"
      >
        Ilovalar
      </h1>

      <p
        class="mt-[30px] max-w-[400px] font-geist text-[16px] leading-[24px] text-muted"
        data-i18n="apps.body"
      >
        Sakkizta ilova, yagona sinxron tizim. Ilova sahifasini ochish uchun
        kartani bosing.
      </p>

      <div class="mt-[40px] grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {
          apps.map((app) => {
            const main = imagesFor(app.slug)[0];
            return (
              <a
                href={`/apps/${app.slug}`}
                class="group block overflow-hidden rounded-2xl border border-hairline bg-card/40 transition-colors duration-300 hover:border-link/40"
              >
                {main ? (
                  <div class="overflow-hidden">
                    <img
                      src={main}
                      alt={`${app.name} — ${app.tur}`}
                      loading="eager"
                      decoding="async"
                      width="700"
                      height="438"
                      class="aspect-[16/10] w-full object-cover object-top transition-transform duration-500 ease-far group-hover:scale-[1.03]"
                    />
                  </div>
                ) : (
                  <div class="flex aspect-[16/10] w-full items-center justify-center bg-ink text-on-ink">
                    <AppIcon slug={app.slug} class="h-14 w-14" />
                  </div>
                )}
                <div class="flex items-center justify-between gap-4 p-4">
                  <div class="min-w-0">
                    <span class="block font-geist-mono text-[11px] leading-4 tracking-[0.72px] text-muted">
                      <span
                        data-i18n={
                          has(`v.${app.tur}`) ? `v.${app.tur}` : undefined
                        }
                      >
                        {app.tur}
                      </span>
                    </span>
                    <span
                      class="mt-1 block truncate font-inter text-[17px] leading-[1.3] font-medium text-ink"
                    >
                      {app.name}
                    </span>
                  </div>
                  <span
                    class="shrink-0 font-geist-mono text-[16px] leading-4 tracking-[0.72px] text-muted transition-transform duration-300 ease-far group-hover:translate-x-1"
                    aria-hidden="true"
                  >
                    →
                  </span>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </div>
</Layout>